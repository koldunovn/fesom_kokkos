# Build trees (one per backend) — covers build/, build-serial/, build-omp/,
# build-cuda/, build-hip/, build-smoke-*/ etc.
build/
build-*/

# Object files / libs / binaries
*.o
*.a
*.so
*.mod
compile_commands.json

# Run outputs / scratch
runs/
*.nc
slurm-*.out
*.log
*.err

# Editor / OS
*.swp
.DS_Store
.cache/

# Claude Code session artifacts (scheduled_tasks.lock etc., created in cwd)
.claude/

# Kokkos submodule build artifacts (the source tree itself is tracked via the submodule)
externals/kokkos/build/

# Python
__pycache__/
*.pyc

# Third-party reference material dropped into the worktree for reading (not ours to
# redistribute from a public repo): Sergey's double-halo mEVP Fortran + its note.
ice_sergey/
ssh_sergey/
