#!/bin/bash
#SBATCH --job-name=m12b_base
#SBATCH -p compute
#SBATCH -A ab0995
#SBATCH --nodes=1
#SBATCH --ntasks=64
#SBATCH --ntasks-per-node=64
#SBATCH --time=00:10:00
#SBATCH -o /work/ab0995/a270088/port2/m12b/base_%j.out
#SBATCH -e /work/ab0995/a270088/port2/m12b/base_%j.err
#
# M12b Task 1 — the BASELINE ORACLE the whole W ladder diffs against.
#
# Two SE runs of the pre-change binary at CORE2, Kokkos-Serial backend, np8 and
# np64 (np64 exercises many partners and the small-subdomain regime; np1 would
# prove nothing about the rung at all — eDim==0 makes it a structural no-op).
# Snapshots are the oracle for W0 (knob-off byte null) and W1 (knob-on exactness).
#
# 🔴 BIN PINNED — every srun re-execs, so the binary is named explicitly and its
# sha recorded next to the snapshots.
set -u
ROOT=/home/a/a270088/port_kokkos_wh
source /sw/etc/profile.levante
source "$ROOT/env.sh"
export OMPI_MCA_btl_vader_single_copy_mechanism=none    # L18 cross-build determinism
ulimit -s 204800

BIN=${BIN:-$ROOT/build-m7serial/fesom_port}
MESH=/work/ab0995/a270088/port2/mesh/core2              # private mesh, never /pool (L73)
PHC=/home/a/a270088/FESOM_port/fesom2/tests/data/INITIAL/phc3.0/phc3.0_winter.nc
DT=1800; NSTEPS=50; SNAP=25; YEAR=1958
BASE=/work/ab0995/a270088/port2/m12b

export FESOM_ALE=zstar        # SE requires zstar
export FESOM_SSH_MODE=se
export FESOM_SE_M=50          # CORE2 dt1800: M_min=35, production default 50
unset FESOM_SE_WIDE

sha256sum "$BIN" | tee "$BASE/BASELINE_BIN.sha"
( cd "$ROOT" && git rev-parse HEAD ) > "$BASE/BASELINE_GIT.txt"

for NP in 8 64; do
  OUT=$BASE/base_np${NP}
  rm -rf "$OUT"; mkdir -p "$OUT"
  echo "=== baseline leg np=$NP -> $OUT ==="
  srun -n $NP -l "$BIN" "$MESH" "$OUT" $DT $NSTEPS $SNAP "$PHC" $YEAR \
       > "$OUT/run.log" 2> "$OUT/run.err"
  echo "exit=$?"
  # the SE announce goes to STDERR under srun -l (M9 trap: grepping stdout only
  # prints an empty provenance block that reads exactly like a clean run)
  grep -h "ssh_se" "$OUT/run.err" "$OUT/run.log" 2>/dev/null | head -3
  ls "$OUT"/snap_*.nc 2>/dev/null | wc -l | xargs echo "  snapshots:"
done
echo "=== baseline done ==="
