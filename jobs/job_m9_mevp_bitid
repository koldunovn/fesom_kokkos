#!/bin/bash
#SBATCH --job-name=m9_bitid
#SBATCH -p compute
#SBATCH -A ab0995
#SBATCH --nodes=1
#SBATCH --ntasks=8
#SBATCH --ntasks-per-node=8
#SBATCH --time=00:10:00
#SBATCH -o /work/ab0995/a270088/port2/m9/bitid.%j.out
#SBATCH -e /work/ab0995/a270088/port2/m9/bitid.%j.err
#
# M9 — Serial BYTE gate at the mEVP config, run FROM THE ICE WORKTREE.
#
# Derived from jobs/job_m6_mevp_serial_bitid, with three M9-specific changes:
#   1. ROOT defaults to the ICE worktree, and BIN is REQUIRED. Every job_* in this repo
#      hardcodes ROOT=/home/a/a270088/port_kokkos; run unmodified from a worktree they source
#      the OTHER session's tree and silently measure the wrong binary.
#   2. Up to THREE legs, so one job yields both gate rungs:
#        L0  C oracle  vs  Kokkos knob-OFF   -> the default path is untouched (merge-back guarantee)
#        L1  knob-OFF  vs  Kokkos with KNOBS -> a null rung is byte-identical
#   3. 🔴 THE KNOB MUST BE PROVEN TO HAVE FIRED. Two ways an L1 rung passes vacuously:
#        - fesom_speed_on_exp AND fesom_speed_int both force the lever OFF on Serial unless
#          FESOM_SPEED_FORCE_SERIAL=1 (fesom_speed.hpp:111-113, :168-170). This job exports it
#          on the KNOBS leg, always.
#        - L102 (wsplit, 2026-08-04): a threshold-gated path can be DEAD while the knob is alive
#          and announcing. Hence EXPECT=<grep-regex>: if the announce/evidence line is absent from
#          the KNOBS leg log, the job FAILS even when the bytes match.
#
# Usage:
#   # L0 only (baseline / every build):
#   sbatch --export=ALL,BIN=/work/ab0995/a270088/port2/m9/bin/base/fesom_port_serial \
#          jobs/job_m9_mevp_bitid
#
#   # L0 + an L1 null rung:
#   sbatch --export=ALL,BIN=...,TAG=lag1,KNOBS="FESOM_SPEED_MEVPLAG=1",\
#          EXPECT="FESOM_SPEED_MEVPLAG = 1" jobs/job_m9_mevp_bitid
#
# L18: CMA off on every leg (cross-build MPI_Gatherv determinism).

set -u
ROOT=${ROOT:-/home/a/a270088/port_kokkos_ice}
C_REPO=/home/a/a270088/port2/fesom2_port_zstar
C_BIN=$C_REPO/build-m6oracle/fesom_port
K_BIN=${BIN:?BIN required — pin the frozen binary, never a build dir (multi-srun re-execs)}

MESH=/work/ab0995/a270088/port2/mesh/core2      # the PRIVATE mesh (L73) -- NOT /pool
PHC=/home/a/a270088/FESOM_port/fesom2/tests/data/INITIAL/phc3.0/phc3.0_winter.nc
PY=/work/ab0995/a270088/mambaforge/envs/nereus/bin/python
DT=1800; NSTEPS=20; SNAP=10; YEAR=1958

TAG=${TAG:-base}
KNOBS=${KNOBS:-}
EXPECT=${EXPECT:-}

BASE=/work/ab0995/a270088/port2/m9/bitid_$TAG
OUT_C=$BASE/c_mevp; OUT_OFF=$BASE/kk_off; OUT_ON=$BASE/kk_on
rm -rf "$BASE"; mkdir -p "$OUT_C" "$OUT_OFF"
[ -n "$KNOBS" ] && mkdir -p "$OUT_ON"

echo "=== M9 mEVP byte gate  TAG=$TAG ==="
echo "    ROOT   = $ROOT"
echo "    BIN    = $K_BIN"
echo "    sha256 = $(sha256sum "$K_BIN" | cut -c1-16)"
echo "    KNOBS  = ${KNOBS:-<none>}"
echo "    EXPECT = ${EXPECT:-<none>}"
( cd "$ROOT" && git rev-parse HEAD ) > "$BASE/SHA.txt" 2>/dev/null || true
echo "    commit = $(cat "$BASE/SHA.txt" 2>/dev/null)"

# Every leg runs mEVP. Clear anything that could select a different option set.
export FESOM_WHICH_EVP=1
unset FESOM_ALE FESOM_MIX_SCHEME FESOM_EVP_DUMP_DIR

echo
echo "=============== LEG A: C oracle, FESOM_WHICH_EVP=1 ==============="
source /sw/etc/profile.levante
source "$C_REPO/env.sh"
export OMPI_MCA_btl_vader_single_copy_mechanism=none    # L18
ulimit -s 204800
srun -l "$C_BIN" "$MESH" "$OUT_C" $DT $NSTEPS $SNAP "$PHC" $YEAR \
     > "$OUT_C/run.log" 2> "$OUT_C/run.err"
echo "leg A exit: $?"; tail -2 "$OUT_C/run.log"

echo
echo "=============== LEG B: Kokkos-Serial, knob-OFF ==============="
source "$ROOT/env.sh"
export OMPI_MCA_btl_vader_single_copy_mechanism=none    # L18
env | grep -E '^FESOM_SPEED' && { echo "!! FESOM_SPEED leaked into the knob-OFF leg"; exit 2; }
srun -l "$K_BIN" "$MESH" "$OUT_OFF" $DT $NSTEPS $SNAP "$PHC" $YEAR \
     > "$OUT_OFF/run.log" 2> "$OUT_OFF/run.err"
echo "leg B exit: $?"; tail -2 "$OUT_OFF/run.log"

RC=0
echo
echo "=========== L0: C oracle vs Kokkos-Serial knob-OFF ==========="
"$PY" "$ROOT/scripts/diff_snap.py" "$OUT_C" "$OUT_OFF"; L0=$?
echo "diff_snap rc=$L0"
[ "$L0" -eq 0 ] && echo "L0 PASS — default path bit-identical to the C oracle" \
               || { echo "L0 FAIL — check the trap list in src/fesom_ice_maevp.h"; RC=1; }

if [ -n "$KNOBS" ]; then
    echo
    echo "=============== LEG C: Kokkos-Serial, KNOBS=$KNOBS ==============="
    (
        # Serial forces every FESOM_SPEED_* lever OFF without this. Without it an L1 rung
        # passes because the knob is DEAD, not because the lever is neutral.
        export FESOM_SPEED_FORCE_SERIAL=1
        for kv in $KNOBS; do export "$kv"; done
        env | grep -E '^FESOM_(SPEED|MEVPDIV)' | sed 's/^/    knob: /'
        srun -l "$K_BIN" "$MESH" "$OUT_ON" $DT $NSTEPS $SNAP "$PHC" $YEAR \
             > "$OUT_ON/run.log" 2> "$OUT_ON/run.err"
        echo "leg C exit: $?"
    )
    tail -2 "$OUT_ON/run.log"

    echo
    echo "=========== KNOB-FIRED CHECK (L80 / L102) ==========="
    if [ -n "$EXPECT" ]; then
        if grep -qE "$EXPECT" "$OUT_ON/run.log" "$OUT_ON/run.err"; then
            echo "PASS — matched: $(grep -hoE "$EXPECT" "$OUT_ON/run.log" "$OUT_ON/run.err" | head -1)"
        else
            echo "FAIL — EXPECT regex '$EXPECT' not found in the KNOBS leg log."
            echo "       The knob did not fire. A byte-identical result below is VACUOUS."
            RC=1
        fi
    else
        echo "!! no EXPECT given — the L1 rung below cannot distinguish 'neutral' from 'dead'"
        grep -E '^\[fesom_speed\]' "$OUT_ON/run.err" "$OUT_ON/run.log" | sed 's/^/    /' || true
    fi

    # CLASS says which rung this lever belongs to. Getting it wrong in either direction is bad:
    #   byte   — a null rung / a lever that must not perturb anything (LAG=1, NOEPS, EVPWIDE=1).
    #            Anything but bit-identical is a FAILURE.
    #   solver — a lever that is mathematically equivalent but NOT bitwise (MEVPDIV: the
    #            recursion is applied after summation instead of before, and the ice_el mask
    #            changes membership across steps). diff_snap can only say yes/no, so report
    #            MAGNITUDES against the mEVP scheme floor instead. This is the L3 rung.
    CLASS=${CLASS:-byte}
    echo
    if [ "$CLASS" = "byte" ]; then
        echo "=========== L1: knob-OFF vs KNOBS (null rung, must be bit-identical) ==========="
        "$PY" "$ROOT/scripts/diff_snap.py" "$OUT_OFF" "$OUT_ON"; L1=$?
        echo "diff_snap rc=$L1"
        [ "$L1" -eq 0 ] && echo "L1 PASS — the lever is byte-neutral" \
                       || { echo "L1 FAIL — the lever perturbs the default trajectory"; RC=1; }
    else
        echo "=========== L3: knob-OFF vs KNOBS (solver class — magnitudes, not bytes) ==========="
        echo "    A nonzero diff is EXPECTED here and is the measurement, not a failure."
        echo
        echo "    🔴 READ THE NUMBERS, NOT THE VERDICT LINE. gpu_fidelity_check.py exists to"
        echo "       separate CUDA atomic-order nondeterminism from a staleness bug, so its"
        echo "       ceilings are calibrated for CUDA-vs-Serial at IDENTICAL arithmetic. A"
        echo "       solver-class lever changes the arithmetic ON PURPOSE, so its PASS/FAIL"
        echo "       line is meaningless here and is NOT this gate's verdict. There is no"
        echo "       20-step ceiling for a scheme change: the CGPOLY precedent was certified"
        echo "       by a 1-yr climate leg at the M5.23 bar, not by a short-window magnitude."
        echo "       What these numbers ARE for: (a) a bring-up sanity check that nothing is"
        echo "       wildly wrong, and (b) RELATIVE comparison between cells — e.g. MEVPDIV"
        echo "       alone vs MEVPLAG=K tells you how much of the perturbation is the"
        echo "       reformulation and how much is the stale halo."
        echo
        "$PY" "$ROOT/scripts/gpu_fidelity_check.py" "$OUT_OFF" "$OUT_ON" || true
        "$PY" "$ROOT/scripts/diff_snap.py" "$OUT_OFF" "$OUT_ON" >/dev/null 2>&1 \
            && echo "    NOTE: bit-identical — for a solver-class lever that means it DID NOT FIRE"
    fi
fi

echo
[ "$RC" -eq 0 ] && echo "=== M9 BYTE GATE PASS (TAG=$TAG) ===" \
               || echo "=== M9 BYTE GATE FAIL (TAG=$TAG) ==="
exit $RC
