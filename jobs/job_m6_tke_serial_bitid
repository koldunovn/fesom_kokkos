#!/bin/bash
#SBATCH --job-name=m6_tke_bitid
#SBATCH -p compute
#SBATCH -A ab0995
#SBATCH --nodes=1
#SBATCH --ntasks=8
#SBATCH --ntasks-per-node=8
#SBATCH --time=00:30:00
#SBATCH -o /work/ab0995/a270088/port2/m6/tkebitid.%j.out
#SBATCH -e /work/ab0995/a270088/port2/m6/tkebitid.%j.err
#
# M6.1 Task 1.5 — KNOB-ON SERIAL BIT-ID vs the C oracle, at the TKE config.
#
# Paired runs, same node, same mesh, same CLI, FESOM_MIX_SCHEME=TKE on both:
#   A) C oracle       fesom2_port_zstar @ df8b9a8   (build-m6oracle, certified Task 0.1)
#   B) Kokkos-Serial  port_kokkos @ HEAD
# diff_snap.py must report ALL FIELDS BIT-IDENTICAL.
#
# NOTE: the C's SNAPSHOT writer emits no TKE-specific fields (the tke/tke_Kv/tke_Av outputs
# are stream/monthly-only, fesom_io.c:719+), so the snapshot variable SET is the same as at
# the default config. The gate therefore compares T/S/u/v/w/eta/Kv/Av/density/ice/... -- i.e.
# it tests TKE through its effect on the whole model, which is exactly what we want. The
# column MATH is separately proven bit-identical by tests/tke_core_twin/.
#
# L18: CMA off on both legs (cross-build MPI_Gatherv determinism).

set -u
C_REPO=/home/a/a270088/port2/fesom2_port_zstar
K_REPO=/home/a/a270088/port_kokkos
C_BIN=$C_REPO/build-m6oracle/fesom_port
K_BIN=$K_REPO/build-serial/fesom_port

MESH=/work/ab0995/a270088/port2/mesh/core2      # the M6 private mesh -- NOT /pool
PHC=/home/a/a270088/FESOM_port/fesom2/tests/data/INITIAL/phc3.0/phc3.0_winter.nc
DT=1800; NSTEPS=20; SNAP=10; YEAR=1958

BASE=/work/ab0995/a270088/port2/m6/tke_bitid
OUT_C=$BASE/c_tke; OUT_K=$BASE/kk_tke
rm -rf "$OUT_C" "$OUT_K"; mkdir -p "$OUT_C" "$OUT_K"

export FESOM_MIX_SCHEME=TKE                     # <-- THE KNOB
unset FESOM_ALE FESOM_WHICH_EVP FESOM_TKE_DIAG FESOM_TKE_DUMP_DIR FESOM_TKE_REPLAY_DIR

echo "=============== LEG A: C oracle, FESOM_MIX_SCHEME=TKE ==============="
source /sw/etc/profile.levante
source "$C_REPO/env.sh"
export OMPI_MCA_btl_vader_single_copy_mechanism=none    # L18
ulimit -s 204800
( cd "$C_REPO" && git rev-parse HEAD ) > "$OUT_C/SHA.txt"
srun -l "$C_BIN" "$MESH" "$OUT_C" $DT $NSTEPS $SNAP "$PHC" $YEAR > "$OUT_C/run.log" 2> "$OUT_C/run.err"
echo "leg A exit: $?"; tail -2 "$OUT_C/run.log"

echo
echo "=============== LEG B: Kokkos-Serial, FESOM_MIX_SCHEME=TKE ==============="
source "$K_REPO/env.sh"
export OMPI_MCA_btl_vader_single_copy_mechanism=none    # L18
( cd "$K_REPO" && git rev-parse HEAD ) > "$OUT_K/SHA.txt"
srun -l "$K_BIN" "$MESH" "$OUT_K" $DT $NSTEPS $SNAP "$PHC" $YEAR > "$OUT_K/run.log" 2> "$OUT_K/run.err"
echo "leg B exit: $?"; tail -2 "$OUT_K/run.log"
grep -m1 "TKE mixing selected" "$OUT_K/run.log" || echo "  !! TKE NOT SELECTED in leg B"

echo
echo "=========== GATE: C oracle vs Kokkos-Serial, both at TKE ==========="
PY=/work/ab0995/a270088/mambaforge/envs/nereus/bin/python
"$PY" "$K_REPO/scripts/diff_snap.py" "$OUT_C" "$OUT_K"
RC=$?
echo "diff_snap rc=$RC"
if [ "$RC" -eq 0 ]; then
    echo "=== M6.1 KNOB-ON SERIAL BIT-ID PASS — the TKE port reproduces the C oracle ==="
else
    echo "=== M6.1 KNOB-ON SERIAL BIT-ID FAIL — bisect with the C dump/replay rails ==="
    echo "    (column math is already proven: tests/tke_core_twin/ => look at the DRIVER)"
fi
exit $RC
