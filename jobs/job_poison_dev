#!/bin/bash
#SBATCH --job-name=kk_poison
#SBATCH -p gpu
#SBATCH -A ab0995
#SBATCH --nodes=2
#SBATCH --ntasks=8
#SBATCH --ntasks-per-node=4
#SBATCH --gres=gpu:4
#SBATCH --gpu-bind=none
#SBATCH --time=00:15:00
#SBATCH -o /work/ab0995/a270088/port2/bisect/poison.%j.out
#SBATCH -e /work/ab0995/a270088/port2/bisect/poison.%j.err
# M5.9-pin: CORE2 dist_8 (ICE ACTIVE), build-cuda device-halo, with the host-poison probe.
#   $1 = FESOM_POISON_HOST list (comma list of {bvfreq,pgf,uvnode,uvrhs}; empty = clean baseline)
#   $2 = output subdir name under bisect/
# Diagnostic: keeps each M5.9 sync_host then NaNs the host copy → only a HOST reader sees the NaN.
ROOT=/home/a/a270088/port_kokkos; source "$ROOT/env_cuda.sh"
export OMPI_MCA_pml=ucx OMPI_MCA_btl=self UCX_NET_DEVICES=mlx5_0:1
export UCX_MEMTYPE_CACHE=n OMPI_MCA_coll_hcoll_enable=0 OMPI_MCA_io=romio321 HDF5_USE_FILE_LOCKING=FALSE
export FESOM_POISON_HOST="$1"
MESH=/pool/data/AWICM/FESOM2/MESHES_FESOM2.1/core2
PHC=/home/a/a270088/FESOM_port/fesom2/tests/data/INITIAL/phc3.0/phc3.0_winter.nc
OUT=/work/ab0995/a270088/port2/bisect/${2:-poison_clean}; rm -rf "$OUT"; mkdir -p "$OUT"
echo "[poison] FESOM_POISON_HOST='$FESOM_POISON_HOST' -> $OUT"
srun "$ROOT/build-cuda/fesom_port" "$MESH" "$OUT" 1800 20 10 "$PHC" 1958 > "$OUT/log" 2>&1
echo "[poison] exit=$? -> $OUT"
