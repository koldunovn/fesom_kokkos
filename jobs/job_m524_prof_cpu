#!/bin/bash
#SBATCH --job-name=m524pc
#SBATCH -p compute
#SBATCH -A ab0995
#SBATCH --ntasks-per-node=128
#SBATCH --time=00:40:00
#SBATCH -o /work/ab0995/a270088/port2/kokkos_gpu_runs/m524prof.%j.out
#SBATCH -e /work/ab0995/a270088/port2/kokkos_gpu_runs/m524prof.%j.err
#
# CPU per-phase step breakdown (FESOM_STEP_PROFILE) on build-serial (Kokkos Serial, 128 ranks/node).
# env: MESH, DT, NSTEPS (default 45), TAG. dist_$NTASKS. The CPU twin of job_ng5_prof.
ROOT=/home/a/a270088/port_kokkos
source /sw/etc/profile.levante
source "$ROOT/env.sh"
ulimit -s 204800
export FESOM_STEP_PROFILE=1 FESOM_CG_PROFILE=1 FESOM_PRINT_EVERY=999
MESH=${MESH:?MESH required}
PHC=/home/a/a270088/FESOM_port/fesom2/tests/data/INITIAL/phc3.0/phc3.0_winter.nc
OUT=/work/ab0995/a270088/port2/kokkos_gpu_runs/${TAG:?TAG required}; rm -rf "$OUT"; mkdir -p "$OUT"
NPES=$SLURM_NTASKS
[ -d "$MESH/dist_$NPES" ] || { echo "ERROR: $MESH/dist_$NPES missing"; exit 2; }
echo "=== CPU PROFILE $TAG mesh=$(basename $MESH) nodes=$SLURM_NNODES ntasks=$NPES (dist_$NPES) dt=${DT:?DT} nsteps=${NSTEPS:-45} ==="
srun "$ROOT/build-serial/fesom_port" "$MESH" "$OUT" "$DT" "${NSTEPS:-45}" -1 "$PHC" 1958 > "$OUT/run.log" 2>&1
echo "rc=$?"
echo "===== loop timing + STEP PROFILE + CG share ====="
grep -E "loop timing|STEP PROFILE|CG share|CG-share" "$OUT/run.log"
echo "===== per-phase breakdown (rank0) ====="
sed -n '/\[fesom_prof\] phase + kernel breakdown/,$p' "$OUT/run.log" | head -70
