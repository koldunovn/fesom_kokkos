#!/bin/bash
#SBATCH --job-name=m16_faith_p
#SBATCH -p compute
#SBATCH -A ab0995
#SBATCH -N 1
#SBATCH --ntasks-per-node=64
#SBATCH -t 00:40:00
#SBATCH -o /work/ab0995/a270088/port2/m16/faith/faith_p.%j.out
#SBATCH -e /work/ab0995/a270088/port2/m16/faith/faith_p.%j.err
#
# M16 Gate 4 — the PORT arms of the faithfulness matrix (Kokkos-Serial, e3 bins, both precisions).
#
#   sbatch --export=ALL,ARMS="pdp psp",RUNROOT=...,NSTEPS=992 jobs/job_m16_faith_port
#
# Serial, not CUDA: the Fortran oracle is a CPU code and CUDA is not run-to-run reproducible, so a
# CUDA arm would fold device noise into a number meant to isolate precision. The GPU screens are a
# separate gate.
#
# The port takes its configuration from the command line and FESOM_* env, not from namelists, so the
# match to the Fortran arms is made HERE and must be read against scripts/m16_faith_setup.sh:
#   dt 2700 (= step_per_day 32)   zstar   KPP (port default)   standard EVP (port default,
#   FESOM_WHICH_EVP unset)   JRA55-do-v1.4.0 starting 1958   PHC3.0 winter   the private CORE2 mesh.
# 🔴 Every FESOM_* knob is otherwise UNSET: the M16 default posture adds the #984 preconditioner
# (variant 1) and it is upstream's shipped default too, so it is common to both codes.
set -u
BINROOT=${BINROOT:-/work/ab0995/a270088/port2/m16/bin/e3}
RUNROOT=${RUNROOT:?set RUNROOT}
ARMS=${ARMS:?set ARMS}
NSTEPS=${NSTEPS:?set NSTEPS}
DT=${DT:-2700}
MESH=/work/ab0995/a270088/port2/mesh/core2
PHC=/home/a/a270088/FESOM_port/fesom2/tests/data/INITIAL/phc3.0/phc3.0_winter.nc
YEAR=1958

source /sw/etc/profile.levante >/dev/null 2>&1 || true
source /home/a/a270088/port_kokkos_sp/env.sh >/dev/null 2>&1
export OMPI_MCA_btl_vader_single_copy_mechanism=none   # L18 deterministic gather
export HDF5_USE_FILE_LOCKING=FALSE
ulimit -s 204800

export FESOM_ALE=zstar
export FESOM_PRINT_EVERY=320
# DET=1 must be set on BOTH codes or neither -- see scripts/m16_faith_setup.sh. The legacy fill is
# partition-dependent, so with det off the two codes need not even start from the same field.
[ "${DET:-0}" = 1 ] && export FESOM_IC_EXTRAP=det
# Atmospheric forcing set — must match the FORCING argument the Fortran arm's run dir was built
# with (scripts/m16_faith_setup.sh). The port takes the model calendar from the dataset, so core2
# also switches the model to a 365-day year, exactly as include_fleapyear=.false. does on the
# Fortran side.
export FESOM_FORCING_SET=${FORCING:-jra55}
# Must match the Fortran arm's SALTANOM (scripts/m16_faith_setup.sh) — upstream #986.
[ "${SALTANOM:-0}" = 1 ] && export FESOM_SALT_ANOMALY=1
# upstream PR #1054 A/B: 1 = flux form (upstream's fix, the default), 0 = pre-#1054 subtraction.
[ -n "${FLUXFORM:-}" ] && export FESOM_FCT_LO_FLUXFORM="$FLUXFORM"
# IOCFG=<path> selects an output-stream override file (default: compiled-in monthly-only). Needed for
# short-horizon runs, where a monthly stream never flushes and the run produces no comparable output.
[ -n "${IOCFG:-}" ] && export FESOM_IO_CONFIG="$IOCFG"
[ -n "${ICDBL:-}" ] && export FESOM_IC_INTERP_DBL="$ICDBL"
[ -n "${ICZDBL:-}" ] && export FESOM_IC_DEPTH_DBL="$ICZDBL"
[ -n "${TRACEGID:-}" ] && export FESOM_IC_TRACE_GID="$TRACEGID"
[ "${FILLDIAG:-0}" = 1 ] && export FESOM_IC_FILL_DIAG=1
# ICDUMP=1 writes the INITIAL CONDITION as a restart before any step (FESOM_RESTART_IC).
# Partition-independent by construction, so it is the right instrument for asking whether an SP-vs-DP
# difference was already present at t=0 rather than generated by the timestepping.
# (the actual export happens per-arm inside the loop, where $dir is known)
# IC perturbation (src/fesom_perturb.h) — the port's OWN noise ensemble, so its SP-DP departure can
# be normalised by its own envelope instead of the Fortran's (board §3b-year). PSEED selects the
# member; PAMP is the gaussian sigma on T in KELVIN and must be C syntax (1e-6), not Fortran (1.D-6).
# Unset PSEED = no perturbation = the baseline arm.
if [ -n "${PSEED:-}" ]; then
    export FESOM_PERTURB=1 FESOM_PERTURB_MODE=initial_only FESOM_PERTURB_METHOD=gaussian
    export FESOM_PERTURB_SEED="$PSEED" FESOM_PERTURB_TEMP="0,${PAMP:-1e-6}"
fi

echo "=== M16 faithfulness — port arms (Kokkos Serial) ==="
echo "runroot : $RUNROOT"
echo "arms    : $ARMS"
echo "steps   : $NSTEPS at dt=$DT   (= $((NSTEPS/32)) days at step_per_day 32)"
echo "ranks   : ${SLURM_NTASKS:-?} on ${SLURM_NNODES:-?} node(s)  [$(hostname)]"
echo "knobs   : FESOM_ALE=zstar FESOM_FORCING_SET=$FESOM_FORCING_SET${FESOM_IC_EXTRAP:+ FESOM_IC_EXTRAP=$FESOM_IC_EXTRAP}${FESOM_SALT_ANOMALY:+ FESOM_SALT_ANOMALY=1}${FESOM_PERTURB:+ FESOM_PERTURB=1 seed=$FESOM_PERTURB_SEED T=$FESOM_PERTURB_TEMP}; everything else unset (KPP + standard EVP are the port defaults)"
echo

for arm in $ARMS; do
    case "$arm" in
        ?sp*) prec=sp ;;
        *)    prec=dp ;;
    esac
    BIN="$BINROOT/$prec/fesom_port_serial"
    [ -x "$BIN" ] || { echo "!! $arm: no binary $BIN"; continue; }
    dir="$RUNROOT/$arm"; out="$dir/output"
    rm -rf "$dir"; mkdir -p "$out"

    [ "${ICDUMP:-0}" = 1 ] && export FESOM_RESTART_IC="$out"
    if [ "${SALTTRACE:-0}" = 1 ]; then
        mkdir -p "$RUNROOT/$arm/strace"; export FESOM_SALT_TRACE="$RUNROOT/$arm/strace"
    fi
    # per-arm, so $arm must be known: the hole-set dump lives beside the arm's output
    if [ -n "${HOLEDUMP:-}" ]; then
        mkdir -p "$RUNROOT/$arm/holes"
        export FESOM_IC_FILL_DIAG=1 FESOM_IC_HOLE_DUMP="$RUNROOT/$arm/holes"
    fi
    echo "--- $arm ($prec, md5 $(md5sum "$BIN" | cut -c1-32)) ---"
    t0=$SECONDS
    srun -l --ntasks="${SLURM_NTASKS}" "$BIN" \
         "$MESH" "$out" "$DT" "$NSTEPS" -1 "$PHC" "$YEAR" \
         > "$dir/run.log" 2> "$dir/run.err"
    rc=$?
    echo "rc=$rc  wall=$((SECONDS - t0))s"
    if [ -n "${PSEED:-}" ]; then
        if grep -q "PERTURBATION APPLIED" "$dir/run.log" 2>/dev/null; then
            echo "perturb : FIRED  ($(grep -m1 'applied to' "$dir/run.log" | sed 's/^ *[0-9]*: *//'))"
        else
            echo "perturb : !! REQUESTED BUT DID NOT FIRE — this arm is not an ensemble member"
        fi
    fi
    grep -ciE "nan|inf" "$dir/run.log" 2>/dev/null | sed 's/^/nan-ish log lines: /'
    ls "$out"/*.nc 2>/dev/null | sed 's|.*/|  out: |'
    tail -3 "$dir/run.err" 2>/dev/null | sed 's/^/  err: /'
    echo
done
echo "=== done ==="
