#!/bin/bash
#SBATCH --job-name=m14jup
#SBATCH --account=e-sta-destine
#SBATCH --partition=booster
#SBATCH --ntasks-per-node=4
#SBATCH --cpus-per-task=72
#SBATCH --gres=gpu:4
#SBATCH --gpu-bind=none
#SBATCH -o /e/scratch/e-sta-destine/koldunov1/port2/m14/jlad.%j.out
#SBATCH -e /e/scratch/e-sta-destine/koldunov1/port2/m14/jlad.%j.err
#
# M14 on JUPITER — one rung of a GH200 strong-scaling ladder, base vs best in ONE allocation.
#
# This is jobs/job_m14_ladder_gpu ported to JUPITER, and it inherits every protocol decision
# that harness made. What is JUPITER-specific:
#   * quad-GH200 nodes, 4 ranks/node, 72 Grace cores each -> --cpus-per-task=72 --gpu-bind=none
#   * ParaStationMPI + MPI-settings/CUDA, NO OMPI_MCA_*/UCX_TLS pins (M7 JUPITER plan §2:
#     system defaults, deviations only after an A/B)
#   * 🔴 FESOM_HALO_STAGE=1 IS THE FLEET TRANSPORT. Device-pointer MPI is BROKEN on
#     Stages/2025 PSMPI 5.11 (halo selfcheck caught corruption, pscom GPUBufStg:0) and on
#     Stage-2026 it works but LOSES on every big-mesh multi-node point (ng5 g32 +32 %,
#     dars g16 +29 %). Never HOST_HALO — it kills CGPIPE/CGPOLY.
#   * env_jupiter.sh must be sourced INSIDE the srun too: modules do not survive.
#
# ARMS (same meaning as on Levante):
#   base = the state before these campaigns: FESOM_SPEED=1, det on, no new knob
#   best = base + BEST_KNOBS and/or BEST_MESH (the partition lever is a mesh dir, not a knob)
#
# Usage:
#   sbatch --nodes=32 --time=01:00:00 \
#     --export=ALL,POINT=ng5,ARMS="base best",BEST_KNOBS="FESOM_SSH_SOLVER=oati" \
#     jobs/job_m14_jupiter_ladder
#   sbatch --nodes=32 --time=01:00:00 \
#     --export=ALL,POINT=ng5,ARMS="base best",BEST_MESH=$MESHOPT/ng5/a5_u30 \
#     jobs/job_m14_jupiter_ladder
set -u
ROOT=${ROOT:-/e/home/jusers/koldunov1/jupiter/port_kokkos_m14}
source "$ROOT/env_jupiter.sh"
export HDF5_USE_FILE_LOCKING=FALSE FESOM_PRINT_EVERY=999
export FESOM_FORCING_DIR=/e/scratch/e-sta-destine/koldunov1/forcing_1958
export FESOM_CHL_FILE=/e/scratch/hclimrep/koldunov1/meshes/Sweeney/Sweeney_2005.nc

MESHES=${MESHES:-/e/scratch/e-sta-destine/koldunov1/meshes}
MESHOPT=${MESHOPT:-/e/scratch/e-sta-destine/koldunov1/meshes_m11}
PHC=/e/scratch/hclimrep/koldunov1/meshes/phc3.0/phc3.0_winter.nc
BIN=${M14_BIN:-$ROOT/build-jupiter-cuda}/fesom_port
BASE=/e/scratch/e-sta-destine/koldunov1/port2/m14

N=$SLURM_NTASKS
case "${POINT:?POINT required}" in
  core2) DT=1800; MESH=$MESHES/core2_private ;;
  farc)  DT=900;  MESH=$MESHES/farc ;;
  dars)  DT=120;  MESH=$MESHES/dars ;;
  ng5)   DT=180;  MESH=$MESHES/ng5 ;;
  *) echo "unknown POINT=$POINT"; exit 2 ;;
esac
MESH=${MESH_OVERRIDE:-$MESH}
NSTEPS=${NSTEPS:-300}
ARMS=${ARMS:-base}
BEST_KNOBS=${BEST_KNOBS:-}

[ -d "$MESH/dist_$N" ] || { echo "REFUSE: $MESH/dist_$N does not exist"; exit 2; }

OUT=$BASE/jlad_${POINT}_${N}_${SLURM_JOB_ID}
mkdir -p "$OUT"; : > "$OUT/legs.txt"
echo "=== M14 JUPITER ladder — $POINT ranks=$N nodes=$SLURM_NNODES dt=$DT steps=$NSTEPS arms='$ARMS' ==="
echo "mesh : $MESH/dist_$N"
echo "nodes: $SLURM_JOB_NODELIST"
md5sum "$BIN"
[ -n "$BEST_KNOBS" ] && echo "best knobs: $BEST_KNOBS"
if [ -n "${BEST_MESH:-}" ]; then
    echo "best mesh : $BEST_MESH/dist_$N   (partition lever)"
    [ -d "$BEST_MESH/dist_$N" ] || { echo "REFUSE: $BEST_MESH/dist_$N does not exist"; exit 2; }
fi

# 🔴 WSPLIT — USER RULE: ON for the large meshes. A cold PHC start at the protocol dt otherwise
# rides the M5.24 vertical CFL blow-up (rule 0.41), which surfaces as `CG_kk: pp·App is -nan`
# with a ROUNDOFF-SEEDED onset step, i.e. it looks exactly like a random solver bug and is not
# one. It cost the Levante A100 campaign its entire NG5 arm (7 of 37 legs survived).
case "${WSPLIT:-${POINT}}" in
    1)               WSPLIT_TAG=wsplit1 ;;
    0)               WSPLIT_TAG=wsplit0 ;;
    core2)           WSPLIT_TAG=wsplit0 ;;
    farc|dars|ng5)   WSPLIT_TAG=wsplit1 ;;
    *) echo "REFUSE: WSPLIT=\"${WSPLIT:-}\" is not 0 or 1 — refusing to guess"; exit 2 ;;
esac
echo "wsplit    : $WSPLIT_TAG${WSPLIT:+ (explicit WSPLIT=$WSPLIT)}"

# The knob set every leg shares. FESOM_HALO_STAGE=1 is the transport, not a lever, so it is here
# and not in BEST_KNOBS. det is a correctness fix and is on in BOTH arms.
COMMON="export FESOM_SPEED=1 FESOM_HALO_STAGE=1 FESOM_IC_EXTRAP=det"
[ "$WSPLIT_TAG" = wsplit1 ] && COMMON="$COMMON FESOM_WSPLIT=1"

leg () {                        # leg <arm> <index>
    local arm=$1 idx=$2
    local out="$OUT/${idx}_${arm}"
    local mesh="$MESH" extra=""
    [ "$arm" = best ] && [ -n "${BEST_MESH:-}" ] && mesh="$BEST_MESH"
    [ "$arm" = best ] && extra="$BEST_KNOBS"
    mkdir -p "$out"
    srun -c72 --distribution=block:block bash -c "
        source $ROOT/env_jupiter.sh
        $COMMON
        $(for kv in ${BASE_KNOBS:-} $extra; do printf 'export %s; ' "$kv"; done)
        exec $BIN $mesh $out $DT $NSTEPS -1 $PHC 1958" > "$out/run.log" 2> "$out/run.err"
    local rc=$?
    local t; t=$(grep -oE '\->[[:space:]]*[0-9.]+ s/step' "$out/run.log" | tail -1 | grep -oE '[0-9.]+')
    # ZOMBIE CHECK (M10 L106): rc=0 is not aliveness.
    local last; last=$(grep -E '^[[:space:]]*[0-9]+[[:space:]]+it=' "$out/run.log" | tail -1)
    local live=yes
    [ -n "$last" ] || live=no
    echo "$last" | grep -qiE 'nan|inf' && live=no
    echo "$last" | grep -qE 'it=0[^0-9]' && live=no
    # The CG NaN this campaign chased writes its FATAL to STDERR, not stdout — grepping run.log
    # alone reads as "no NaN anywhere". Check both.
    grep -q 'pp·App is' "$out/run.err" 2>/dev/null && { echo "  !! CG NaN (rule 0.41 — is wsplit on?)"; live=no; }
    grep -q 'cgpipe.*INACTIVE' "$out/run.log" && { echo "  !! CGPIPE INACTIVE — wrong transport"; live=no; }
    echo "leg $idx $arm: rc=$rc s/step=${t:-NA} live=$live"
    [ "$live" = yes ] && [ "$rc" -eq 0 ] && [ -n "$t" ] && echo "$arm $t" >> "$OUT/legs.txt" \
        || echo "  !! leg REJECTED (rc=$rc live=$live) — its timing is not admitted"
}

# The FIRST leg of an allocation is systematically slow — throwaway warmup, DISCARDED.
echo; echo "--- warmup (discarded) ---"
leg warmup 0
: > "$OUT/legs.txt"

set -- $ARMS
if [ "$#" -eq 2 ]; then
    echo; echo "--- ABBA: $1 $2 $2 $1 ---"
    leg "$1" 1; leg "$2" 2; leg "$2" 3; leg "$1" 4
else
    echo; echo "--- $1 x2 ---"
    leg "$1" 1; leg "$1" 2
fi

echo; echo "=== result ==="
awk '{a[$1]=(a[$1]==""||$2<a[$1])?$2:a[$1]; n[$1]++}
     END{ if (length(a)==0) { print "  NO ADMITTED LEGS"; exit 1 }
          for(k in a) printf "  %-5s min=%.4f (%d legs)\n", k, a[k], n[k];
          if (a["base"]!="" && a["best"]!="") printf "  GAIN = %+.2f%%  (best vs base, min over legs)\n", (a["best"]-a["base"])/a["base"]*100;
          printf "JCSV %s,%s,cfg=%s,", MESH, N, CFG; for(k in a) printf "%s=%.4f,", k, a[k]; printf "\n" }' \
     MESH="$POINT" N="$N" CFG="${BASE_KNOBS:-paper}+$WSPLIT_TAG" "$OUT/legs.txt"
