#!/bin/bash
#SBATCH --job-name=ng5part
#SBATCH -p compute
#SBATCH -A ab0995
#SBATCH --ntasks-per-node=128
#SBATCH --time=00:40:00
#SBATCH -o /work/ab0995/a270088/port2/m10/ab/ng5part.%j.out
#SBATCH -e /work/ab0995/a270088/port2/m10/ab/ng5part.%j.err
#
# Is the NG5 blow-up a property of the CONFIGURATION or of the PARTICULAR PARTITION?
#
# What we know. NG5 at dt180 from a cold start completes 300 steps at 1024 and 2048 pieces,
# and blows up at 4096 and 8192 — the model's own guard fires
# ("BLOWUP at step 175 (uv=5.756e+00 ...)", exit 99) between steps 150 and 175. The M7
# campaign recorded the same death on the SAME shipped dist_4096 at step 200 in the port and
# 203 in Fortran, and read it as a physics limit of dt180 + opt_visc=7.
#
# The competing reading (user, 2026-08-06): in FESOM some individual partitions simply blow
# up, independent of the physics. Both readings predict the shipped dist_4096 dying; they
# differ on whether a DIFFERENT partition at the SAME rank count survives.
#
# So: same mesh definition, same 4096 ranks, same dt180 cold start, same binary, same
# allocation — only the decomposition differs.
#   arm 1  /pool ... /ng5          dist_4096, as shipped  (expected: blows up ~150-175)
#   arm 2  .../ng5_bigpart         dist_4096, freshly generated by our partitioner
# If arm 2 completes 300 steps, the blow-up belongs to the shipped partition and the new
# 16384/20480/24576 partitions are worth running. If both die at a similar step, it is the
# configuration, and NG5 must be measured in a shorter window or at a smaller dt.
#
# Submit: sbatch -N 32 --ntasks=4096 jobs/job_m10_ng5_partcheck
set -u
ROOT=${M10_ROOT:-$HOME/port_kokkos_ssh}
source "$ROOT/jobs/m7_provenance.sh"
source /sw/etc/profile.levante
source "$ROOT/env.sh"
export OMPI_MCA_io=romio321 HDF5_USE_FILE_LOCKING=FALSE
export FESOM_PRINT_EVERY=25          # see the ramp, not just the corpse

PHC=/home/a/a270088/FESOM_port/fesom2/tests/data/INITIAL/phc3.0/phc3.0_winter.nc
DT=${DT:-180}
NSTEPS=${NSTEPS:-300}
NPES=$SLURM_NTASKS
FESOM=${BIN:-$ROOT/build-m7serial/fesom_port}
OUT=/work/ab0995/a270088/port2/m10/ab/ng5part_${SLURM_JOB_ID}; rm -rf "$OUT"; mkdir -p "$OUT"
m7_provenance "$OUT" "$FESOM"; cat "$OUT/SHA.txt"

POOL=/pool/data/AWICM/FESOM2/MESHES_FESOM2.1/ng5
FRESH=/work/ab0995/a270088/port2/mesh/ng5_bigpart

echo "=== NG5 partition check  ntasks=$NPES  $((7402886/NPES)) vertices/core  dt=$DT  nsteps=$NSTEPS ==="

# the two arms must differ ONLY in dist_* — assert the mesh definition is identical
for f in nod2d.out elem2d.out nlvls.out elvls.out; do
    a=$(md5sum "$POOL/$f" | cut -d' ' -f1); b=$(md5sum "$FRESH/$f" | cut -d' ' -f1)
    [ "$a" = "$b" ] || { echo "REFUSE: $f differs between the two mesh copies"; exit 2; }
done
echo "  mesh-definition integrity OK (arms differ only in the partition)"

arm () {   # arm <name> <meshdir>
    local name=$1 mesh=$2
    if [ ! -d "$mesh/dist_$NPES" ]; then echo "--- $name: no dist_$NPES, SKIP"; return; fi
    echo "--- $name : $mesh/dist_$NPES"
    srun "$FESOM" "$mesh" "$OUT" "$DT" "$NSTEPS" -1 "$PHC" 1958 \
        > "$OUT/log_$name.txt" 2> "$OUT/err_$name.txt"
    echo "    rc=$?"
    echo "    last step: $(grep -a -E '^ *[0-9]+  it=' "$OUT/log_$name.txt" | tail -1)"
    grep -a -m1 -E "BLOWUP|CG_kk abort" "$OUT/err_$name.txt" | sed 's/^/    /'
    grep -a "loop timing" "$OUT/log_$name.txt" | sed 's/^/    /'
}

arm shipped "$POOL"
arm fresh   "$FRESH"
echo "=== done ==="
rm -f "$OUT"/*.nc 2>/dev/null || true
