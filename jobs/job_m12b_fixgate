#!/bin/bash
#SBATCH --job-name=m12b_fixgate
#SBATCH -p compute
#SBATCH -A ab0995
#SBATCH --nodes=1
#SBATCH --ntasks=8
#SBATCH --ntasks-per-node=8
#SBATCH --time=00:14:00
#SBATCH -o /work/ab0995/a270088/port2/m12b/fixgate_%j.out
#SBATCH -e /work/ab0995/a270088/port2/m12b/fixgate_%j.err
#
# M12b s3 — gate the H0e-coherence fix (FESOM_SE_H0E_XCHG, default 1).
#
# Measured cause (probe 26959682): se_forcing's halo H0e is NOT the owner's
# bytes (1334 elements, up to 1e-1 m, eta-class, step 2+); k3's viscosity reads
# H0e[nb] at halo slots, so holders of a multi-claimed element disagree ->
# the s2 seed. Fix = one per-STEP H0e exchange.
#
# Arms (np8 CORE2):
#   legacy   FIX=0 GEOCHK=2 SELFCHECK=1, 3 steps  — reproduce + He/meta split
#   fixgeo   FIX=1 GEOCHK=2 SELFCHECK=1, 3 steps  — every spread must read 0
#   fixsc    FIX=1 SELFCHECK=1, 10 steps          — wide-chk exact 0.0/step (W1 back)
#   fixfree  FIX=1 SELFCHECK=2, 25 steps          — FREE-RUNNING drift must be 0
set -u
ROOT=/home/a/a270088/port_kokkos_wh
source /sw/etc/profile.levante
source "$ROOT/env.sh"
export OMPI_MCA_btl_vader_single_copy_mechanism=none
ulimit -s 204800

BIN=${BIN:?pin the binary}
MESH=/work/ab0995/a270088/port2/mesh/core2
PHC=/home/a/a270088/FESOM_port/fesom2/tests/data/INITIAL/phc3.0/phc3.0_winter.nc
BASE=/work/ab0995/a270088/port2/m12b
sha256sum "$BIN"

export FESOM_ALE=zstar FESOM_SSH_MODE=se FESOM_SE_WIDE=1 FESOM_SE_M=50

run_arm () {   # $1 tag, $2 nsteps, rest = extra env
  local tag=$1 nst=$2; shift 2
  local OUT=$BASE/fixgate_${tag}_${SLURM_JOB_ID}
  rm -rf "$OUT"; mkdir -p "$OUT"
  echo "=================== ARM $tag  ($* / $nst steps) ==================="
  env "$@" srun -n 8 -l "$BIN" "$MESH" "$OUT" 1800 "$nst" 999999 "$PHC" 1958 \
      > "$OUT/run.log" 2> "$OUT/run.err"
  echo "exit=$?"
  grep -h "ssh_se-gk\]\|ssh_se-gk-dump\|wide-chk\]\|wide-drift" "$OUT/run.err" \
    | grep -v "0 (max 0.000e+00).*0 (max 0.000e+00)\|: 0 (max 0.000e+00)\|halo-vs-owner: 0" | head -40
  echo "--- (suppressed all-zero probe lines; nonzero-only above)"
  grep -h "wide-chk\] step\|wide-drift" "$OUT/run.err" | head -30
}

run_arm legacy  3  FESOM_SE_H0E_XCHG=0 FESOM_SE_WIDE_RECON=0 FESOM_SE_WIDE_GEOCHK=2 FESOM_SE_WIDE_SELFCHECK=1
run_arm fixgeo  3  FESOM_SE_WIDE_GEOCHK=2 FESOM_SE_WIDE_SELFCHECK=1
run_arm fixsc   25 FESOM_SE_WIDE_SELFCHECK=1
run_arm fixfree 25 FESOM_SE_WIDE_SELFCHECK=2
echo "=== fixgate done ==="
