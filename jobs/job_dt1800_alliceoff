#!/bin/bash
#SBATCH --job-name=dt1800_alliceoff
#SBATCH -p compute
#SBATCH --nodes=7
#SBATCH --ntasks=864
#SBATCH --time=00:30:00
#SBATCH -A ab0995
#SBATCH -o /work/ab0995/a270088/port/dt1800_alliceoff/slurm.%j.out
#SBATCH -e /work/ab0995/a270088/port/dt1800_alliceoff/slurm.%j.err
source /sw/etc/profile.levante
source /home/a/a270088/port2/fesom2_port/env.sh
ulimit -s 204800
OUT_DIR=/work/ab0995/a270088/port/dt1800_alliceoff; mkdir -p "$OUT_DIR"
export FESOM_DIAG_MICE=1
export FESOM_NO_ICE_DYN=1
export FESOM_NO_ICE_ADV=1
export FESOM_NO_ICE_THERMO=1
BIN=/home/a/a270088/port2/fesom2_port/build/fesom_port
MESH=/pool/data/AWICM/FESOM2/MESHES_FESOM2.1/core2
PHC=/home/a/a270088/FESOM_port/fesom2/tests/data/INITIAL/phc3.0/phc3.0_winter.nc
date; srun -l "$BIN" "$MESH" "$OUT_DIR" 1800 6000 -1 "$PHC" 1958 > "$OUT_DIR/run.log" 2> "$OUT_DIR/run.err"; echo "Exit $?"; date
grep "ssh_rhs\|FATAL\|reached" "$OUT_DIR/run.err" 2>/dev/null | tail -3
grep "\[mice-mon\]" "$OUT_DIR/run.err" | tail -3
tail -2 "$OUT_DIR/run.log"
