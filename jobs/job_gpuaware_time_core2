#!/bin/bash
#SBATCH --job-name=kk_gpuaware_time
#SBATCH -p gpu
#SBATCH -A ab0995
#SBATCH --nodes=2
#SBATCH --ntasks=8
#SBATCH --ntasks-per-node=4
#SBATCH --gres=gpu:4
#SBATCH --gpu-bind=none
#SBATCH --time=00:30:00
#SBATCH -o /work/ab0995/a270088/port2/kokkos_gpu_runs/gpuaware_time.%j.out
#SBATCH -e /work/ab0995/a270088/port2/kokkos_gpu_runs/gpuaware_time.%j.err
#
# M5.1 payoff: CORE2 dist_8 (8 A100 / 2 gpu nodes) per-step wall, host-staged vs
# device-halo, SAME CUDA-aware binary. ALSO the inter-node device-ptr-MPI de-risk
# (smoke + pi were 1 node; this is the cross-node, gdr_copy-absent host-bounce
# path). loop s/step = (wall@105 - wall@5)/100, no I/O. Baseline = 0.731 s/step
# (job 25163175, old MPI, all host-staged).

ROOT=/home/a/a270088/port_kokkos
source "$ROOT/env_cuda.sh"
# Inter-node CUDA-aware UCX: leave UCX_TLS auto (picks cuda_copy/cuda_ipc + rc/dc
# for IB); memtype cache off for cuda detection. (smoke config B, generalised.)
export OMPI_MCA_pml=ucx OMPI_MCA_btl=self UCX_NET_DEVICES=mlx5_0:1
export UCX_MEMTYPE_CACHE=n OMPI_MCA_coll_hcoll_enable=0
export OMPI_MCA_io=romio321 HDF5_USE_FILE_LOCKING=FALSE

MESH=/pool/data/AWICM/FESOM2/MESHES_FESOM2.1/core2
PHC=/home/a/a270088/FESOM_port/fesom2/tests/data/INITIAL/phc3.0/phc3.0_winter.nc
OUT=/work/ab0995/a270088/port2/kokkos_gpu_runs/gpuaware_time
rm -rf "$OUT"; mkdir -p "$OUT"
export FESOM_PRINT_EVERY=999            # the model's internal loop timer is startup-free

run() {  # $1=tag $2=extra-env  — 105 steps; the model prints "loop timing ... s/step"
  env $2 srun "$ROOT/build-cuda/fesom_port" "$MESH" "$OUT" 1800 105 999999 "$PHC" 1958 > "$OUT/log_$1.txt" 2>&1
  local rc=$?
  printf "%-14s rc=%s  %s\n" "$1" "$rc" "$(grep 'loop timing' "$OUT/log_$1.txt" | tail -1)"
}
echo "=== nodes=$SLURM_JOB_NODELIST ranks=$SLURM_NTASKS ==="
nvidia-smi -L | head -1; ompi_info 2>/dev/null | grep -m1 "Open MPI:"

echo "--- 2 reps each; per-step from the model's startup-free internal timer ---"
run host_a "FESOM_HOST_HALO=1"
run dev_a  ""
run host_b "FESOM_HOST_HALO=1"
run dev_b  ""
echo "=== compare the 'loop timing ... s/step' lines above (host vs dev); baseline 0.731 ==="
