#!/bin/bash
#SBATCH --job-name=evp_cdump
#SBATCH -p compute
#SBATCH --ntasks-per-node=16
#SBATCH --ntasks=16
#SBATCH --time=00:20:00
#SBATCH -A ab0995
#SBATCH -o /work/ab0995/a270088/port/evp_cdump/slurm.%j.out
#SBATCH -e /work/ab0995/a270088/port/evp_cdump/slurm.%j.err

# C-port EVP per-substep dump for the step-1 forcing comparison vs Fortran.
# 16r, dt=1800, linfs, cold start PHC winter + JRA55 1958, KPP default. Dumps
# Q/U0/P/F/1/2/3/4/END at steps 1-2 (FESOM_EVP_DUMP_DIR-gated). Diff vs the
# Fortran evp_fdump with scripts/evp_dump_diff.py.
source /sw/etc/profile.levante
source /home/a/a270088/port2/fesom2_port/env.sh
ulimit -s 204800

STAMP="$(date +%s)_${SLURM_JOB_ID}"
OUT_DIR=/work/ab0995/a270088/port/evp_cdump/run_${STAMP}
export FESOM_EVP_DUMP_DIR=/work/ab0995/a270088/port/evp_cdump/dump
mkdir -p "$OUT_DIR" "$FESOM_EVP_DUMP_DIR"

BIN=/home/a/a270088/port2/fesom2_port/build/fesom_port
MESH=/pool/data/AWICM/FESOM2/MESHES_FESOM2.1/core2
PHC=/home/a/a270088/FESOM_port/fesom2/tests/data/INITIAL/phc3.0/phc3.0_winter.nc
DT=1800
NSTEPS=16
SNAP_EVERY=100000
export FESOM_PRINT_EVERY=1
JRA55_YEAR=1958

echo "OUT_DIR=$OUT_DIR"; echo "FESOM_EVP_DUMP_DIR=$FESOM_EVP_DUMP_DIR"
date
srun -l "$BIN" "$MESH" "$OUT_DIR" "$DT" "$NSTEPS" "$SNAP_EVERY" "$PHC" "$JRA55_YEAR" \
    > "$OUT_DIR/run.log" 2> "$OUT_DIR/run.err"
EXITCODE=$?
date
echo "Exit code: $EXITCODE"
echo "=== EVP dump files ==="; ls "$FESOM_EVP_DUMP_DIR" | head -20
echo "=== n dump files ==="; ls "$FESOM_EVP_DUMP_DIR" | wc -l
tail -5 "$OUT_DIR/run.err"
exit $EXITCODE
