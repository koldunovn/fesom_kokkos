#!/bin/bash
# job_ng5_scaling_lumi — NG5 strong-scaling driver on LUMI-G (MI250X / gfx90a).
#
# Parametrized via --export TAG=... and sbatch CLI for nodes/ntasks/partition.
# CORE2 mesh's smallest available dist is dist_16; NG5 likewise — see
# /pfs/.../inproot/fesom/v21/NG5/dist_*. 1 rank per GCD (8/node).
# dt=180 (CFL-stable at NG5 resolution), 35 steps, no snapshots, --mem=0
# (NG5 OOMs the dev-g default 64 GB/node at the partit reads).
#
# Submit (see submit_ng5_scaling_lumi.sh for the sweep):
#   sbatch --nodes=2  --ntasks=16  --partition=dev-g       --export=ALL,TAG=n2   jobs/job_ng5_scaling_lumi
#   sbatch --nodes=30 --ntasks=240 --partition=dev-g       --export=ALL,TAG=n30  jobs/job_ng5_scaling_lumi
#   sbatch --nodes=64 --ntasks=512 --partition=standard-g  --export=ALL,TAG=n64  jobs/job_ng5_scaling_lumi

#SBATCH --job-name=kk_ng5_scal_lumi
#SBATCH --account=project_465002727
#SBATCH --ntasks-per-node=8
#SBATCH --gpus-per-node=8
#SBATCH --cpus-per-task=7
#SBATCH --mem=0
#SBATCH --time=00:30:00
#SBATCH --output=jobs/lumi_logs/%x-%j.out
#SBATCH --error=jobs/lumi_logs/%x-%j.err

set -euo pipefail
mkdir -p jobs/lumi_logs

ROOT=/pfs/lustrep4/projappl/project_465002727/sbeyer/fesom_kokkos
source "$ROOT/env_lumi.sh"

export MPICH_GPU_SUPPORT_ENABLED=1
export FESOM_PRINT_EVERY=999

MESH=/pfs/lustrep4/projappl/project_465002727/sbeyer/inproot/fesom/v21/NG5
PHC=/pfs/lustrep4/projappl/project_465002727/sbeyer/inproot/fesom/v21/hydrography/phc3.0/phc3.0_winter.nc

export FESOM_JRA55_DIR=/pfs/lustrep4/projappl/project_465002727/sbeyer/fesom_forcing/JRA5
export FESOM_SSS_PATH=$FESOM_JRA55_DIR/PHC2_salx.nc
export FESOM_RUNOFF_PATH=$FESOM_JRA55_DIR/CORE2_runoff.nc
export FESOM_CHL_FILE=$FESOM_JRA55_DIR/Sweeney_2005.nc

OUT=/scratch/project_465002727/sbeyer/fesom_runs/ng5_scaling_${TAG:-default}
rm -rf "$OUT"; mkdir -p "$OUT"

NPES=$SLURM_NTASKS
if [ ! -d "$MESH/dist_$NPES" ]; then
    echo "ERROR: $MESH/dist_$NPES missing"; exit 2
fi

echo "=== NG5 scaling ${TAG:-?} (nodes=$SLURM_NNODES ranks=$NPES gpus=$((SLURM_NNODES*8)), dist_$NPES) ==="
echo "    nodes: $SLURM_JOB_NODELIST"
srun "$ROOT/build-hip/fesom_port" "$MESH" "$OUT" "${DT:-180}" "${NSTEPS:-35}" -1 "$PHC" 1958 \
    > "$OUT/run.log" 2> "$OUT/run.err"
EC=$?
echo "=== exit=$EC ==="
echo "--- loop timing ---"
grep "loop timing" "$OUT/run.log" | tail -1
echo "--- last step ---"
grep " it=" "$OUT/run.log" | tail -1
exit $EC
