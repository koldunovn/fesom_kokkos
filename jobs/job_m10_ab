#!/bin/bash
#SBATCH --job-name=m10_ab
#SBATCH -p gpu
#SBATCH -A ab0995
#SBATCH -C a100_80
#SBATCH --ntasks-per-node=4
#SBATCH --gres=gpu:4
#SBATCH --gpu-bind=none
#SBATCH --time=02:00:00
#SBATCH -o /work/ab0995/a270088/port2/m10/ab/ab.%j.out
#SBATCH -e /work/ab0995/a270088/port2/m10/ab/ab.%j.err
#
# M10 same-allocation solver A/B — the house protocol (M7 job_m7_ab_gpu shape).
#
# Inter-allocation noise on Levante is ~±10 %, larger than most levers, so EVERY leg runs
# back-to-back in ONE allocation on the SAME nodes with the SAME binary; only
# FESOM_SSH_SOLVER (and its companions) differ. min-of-2 reps per leg.
#
# ⭐ µs/iteration is harvested next to s/step: it separates "cheaper iteration" from
# "different iteration count", which is the distinction the crossover claim rests on.
# The [ssh-wire] aggregate supplies iters/solve; the loop timer supplies s/step.
#
# env: MESH, DT, TAG, LEGS (';'-separated, each a ','-joined knob list or "cg"),
#      NSTEPS (default 300 — the pinned-pair standard), BIN (default build-m7cuda).
# Submit: sbatch -N 4 --ntasks=16 --export=ALL,MESH=$NG5,DT=180,TAG=ab_ng5_4n,\
#           LEGS="cg;FESOM_SSH_SOLVER=cg2;FESOM_SSH_SOLVER=pipecg" jobs/job_m10_ab

set -u
ROOT=${M10_ROOT:-$HOME/port_kokkos_ssh}
source "$ROOT/jobs/m7_provenance.sh"
source "$ROOT/env_cuda.sh"
export OMPI_MCA_pml=ucx OMPI_MCA_btl=self UCX_NET_DEVICES=mlx5_0:1
export UCX_MEMTYPE_CACHE=n OMPI_MCA_coll_hcoll_enable=0
export OMPI_MCA_io=romio321 HDF5_USE_FILE_LOCKING=FALSE
export FESOM_PRINT_EVERY=999

MESH=${MESH:?MESH required}
PHC=/home/a/a270088/FESOM_port/fesom2/tests/data/INITIAL/phc3.0/phc3.0_winter.nc
TAG=${TAG:?TAG required}
OUT=/work/ab0995/a270088/port2/m10/ab/$TAG; rm -rf "$OUT"; mkdir -p "$OUT"
NPES=$SLURM_NTASKS
FESOM=${BIN:-$ROOT/build-m7cuda/fesom_port}
m7_provenance "$OUT" "$FESOM"
cat "$OUT/SHA.txt"
[ -d "$MESH/dist_$NPES" ] || { echo "ERROR: $MESH/dist_$NPES missing"; exit 2; }

clear_knobs() { while read -r v; do unset "$v"; done \
                  < <(env | sed -n 's/^\(FESOM_\(SPEED\|SSH\|PCSI\)[A-Za-z0-9_]*\)=.*/\1/p'); }

echo "=== M10 A/B  $TAG  mesh=$(basename "$MESH") nodes=$SLURM_NNODES ntasks=$NPES dt=${DT:?} nsteps=${NSTEPS:-300} ==="
echo "nodes: $SLURM_JOB_NODELIST"

declare -a NAMES TIMES ITERS
IFS=';' read -ra LEGARR <<< "${LEGS:?LEGS required}"
li=0
for leg in "${LEGARR[@]}"; do
    clear_knobs
    name="$leg"
    if [ "$leg" != "cg" ]; then
        IFS=',' read -ra KV <<< "$leg"; for kv in "${KV[@]}"; do export "$kv"; done
    fi
    export FESOM_SSH_STATS=1          # counts + iters/solve; no VERIFY (it costs an SpMV)
    echo "--- leg $li: $name ---"
    best=""; iters=""
    for rep in a b; do
        srun "$FESOM" "$MESH" "$OUT" "$DT" "${NSTEPS:-300}" -1 "$PHC" 1958 \
            > "$OUT/log_${li}_$rep.txt" 2> "$OUT/err_${li}_$rep.txt"
        t=$(grep 'loop timing' "$OUT/log_${li}_$rep.txt" | tail -1 | sed -E 's/.*-> +([0-9.]+) s\/step/\1/')
        it=$(grep 'ssh-wire. AGGREGATE' "$OUT/err_${li}_$rep.txt" | tail -1 \
             | sed -E 's/.*iters\/solve=([0-9.]+).*/\1/')
        echo "    rep $rep: ${t:-NA} s/step, ${it:-NA} iters/solve"
        [ -n "$t" ] && { [ -z "$best" ] && best=$t || best=$(python3 -c "print(min($best,$t))"); }
        [ -n "$it" ] && iters=$it
    done
    NAMES[$li]="$name"; TIMES[$li]="${best:-nan}"; ITERS[$li]="${iters:-nan}"
    li=$((li+1))
done

echo
/work/ab0995/a270088/mambaforge/envs/nereus/bin/python - "$TAG" "${NAMES[*]}" "${TIMES[*]}" "${ITERS[*]}" <<'PY'
import sys
tag = sys.argv[1]
names = sys.argv[2].split(); times = sys.argv[3].split(); iters = sys.argv[4].split()
print("=" * 92); print(f"A/B RESULT — {tag}   (min-of-2, same allocation, same binary)"); print("=" * 92)
print(f"  {'leg':<44} {'s/step':>10} {'delta':>9} {'iters':>9} {'us/iter':>10}")
base = float(times[0])
for n, t, k in zip(names, times, iters):
    t = float(t); k = float(k)
    us = 1e6 * t / k if k > 0 else float('nan')
    d = 100.0 * (t - base) / base
    print(f"  {n:<44} {t:10.4f} {d:+8.2f}% {k:9.2f} {us:10.1f}")
print("=" * 92)
print("  us/iter = whole-STEP time per CG iteration — it moves with both the solver AND the")
print("  rest of the step, so read it as a within-mesh comparator, not an absolute solver cost.")
PY
rm -f "$OUT"/*.monthly.nc 2>/dev/null || true
