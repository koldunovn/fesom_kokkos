#!/bin/bash
#SBATCH --job-name=kk_core2_gpu8
#SBATCH -p gpu
#SBATCH -A ab0995
#SBATCH --nodes=2
#SBATCH --ntasks=8
#SBATCH --ntasks-per-node=4
#SBATCH --gres=gpu:4
#SBATCH --gpu-bind=none
#SBATCH --time=00:20:00
#SBATCH -o /work/ab0995/a270088/port2/kokkos_gpu_runs/core2_gpu8.%j.out
#SBATCH -e /work/ab0995/a270088/port2/kokkos_gpu_runs/core2_gpu8.%j.err
#
# M3.1 multi-GPU REAL-MESH smoke: CORE2 dist_8 = 8 MPI ranks -> 8 A100s across
# 2 gpu nodes (gpu = 4 A100/node). The real-mesh binding + MULTI-NODE halo proof
# (node-local rank 0..3 on each node -> device 0..3; cross-node IB halo exchange).
# Short run (30 steps @ dt=1800, JRA55-1958 + PHC winter IC) — NOT a climate run
# (that is M3.2). CUDA => climate-close, not bit-identical (D5).
#
# GATE: exit 0; per-step T/S range stays bounded (FESOM_PRINT_EVERY=1, no NaN/blow-up);
#   each of the 8 ranks prints a DISTINCT device_id within its node (0,1,2,3 on
#   node A; 0,1,2,3 on node B). --gpu-bind=none -> all 4 node GPUs visible to all
#   4 ranks on it, so set_device_id(node-local rank) maps 1:1.
# Inspect:  grep "Kokkos device_id" runs/core2_gpu8.<jobid>.out   # 8 lines, distinct per node
#           grep " it=" runs/core2_gpu8.<jobid>.out | tail        # T/S bounded, no nan

ROOT=/home/a/a270088/port_kokkos
source /sw/etc/profile.levante
module --force purge
module unload netcdf-c cdo ncview git 2>/dev/null      # sticky-module fix (L17)
module load gcc/11.2.0-gcc-11.2.0 nvhpc/24.7-gcc-11.2.0 \
            openmpi/4.1.2-gcc-11.2.0 netcdf-c/4.8.1-gcc-11.2.0
export NVCC_WRAPPER_DEFAULT_COMPILER=g++

# Standard Levante UCX/IB transport for MULTI-RANK / MULTI-NODE (verbatim from env.sh).
export OMPI_MCA_pml=ucx
export OMPI_MCA_btl=self
export OMPI_MCA_osc=pt2pt
export UCX_IB_ADDR_TYPE=ib_global
export OMPI_MCA_coll="^ml,hcoll"
export OMPI_MCA_coll_hcoll_enable=0
export HCOLL_ENABLE_MCAST_ALL=0
export HCOLL_MAIN_IB=mlx5_0:1
export UCX_NET_DEVICES=mlx5_0:1
export UCX_TLS=mm,knem,cma,dc_mlx5,dc_x,self
export UCX_UNIFIED_MODE=y
export OMPI_MCA_io=romio321
export HDF5_USE_FILE_LOCKING=FALSE

MESH=/pool/data/AWICM/FESOM2/MESHES_FESOM2.1/core2
PHC=/home/a/a270088/FESOM_port/fesom2/tests/data/INITIAL/phc3.0/phc3.0_winter.nc
OUT=/work/ab0995/a270088/port2/kokkos_gpu_runs/core2_gpu8   # NOT home (60GB home quota; CORE2 snaps are GBs)
rm -rf "$OUT"; mkdir -p "$OUT"
export FESOM_PRINT_EVERY=1                              # per-step T/S/uv ranges = the blow-up detector

echo "=== nodes=$SLURM_JOB_NODELIST ranks=$SLURM_NTASKS (4/node) ==="
# CORE2 args: dt=1800, 30 steps, snap_every=10, PHC winter IC, JRA55 year 1958
srun -l "$ROOT/build-cuda/fesom_port" "$MESH" "$OUT" 1800 30 10 "$PHC" 1958
echo "Exit: $?"
