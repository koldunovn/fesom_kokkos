#!/bin/bash
#SBATCH --job-name=kpp5yr_fix
#SBATCH -p compute
#SBATCH --nodes=7
#SBATCH --ntasks=864
#SBATCH --time=03:00:00
#SBATCH -A ab0995
#SBATCH -o /work/ab0995/a270088/port/kpp_5yr_fix/slurm.%j.out
#SBATCH -e /work/ab0995/a270088/port/kpp_5yr_fix/slurm.%j.err
# New C 5-yr KPP baseline to pair with the fixed-Fortran 5-yr (post cold-start
# wind-rotation fix). C is functionally unchanged (it was already correct); this
# is the matched C baseline at the current HEAD (KPP default, ice_gamma_fct=0.5,
# bvfreq N2 fix). dt=1800, 5 yr (1958-1962), 864r, linfs. Compare vs the new
# Fortran /scratch/a/a270088/fortran_kpp_5yr_fix.
source /sw/etc/profile.levante
source /home/a/a270088/port2/fesom2_port/env.sh
ulimit -s 204800
REPO=/home/a/a270088/port2/fesom2_port
BIN=$REPO/build/fesom_port
MESH=/pool/data/AWICM/FESOM2/MESHES_FESOM2.1/core2
PHC=/home/a/a270088/FESOM_port/fesom2/tests/data/INITIAL/phc3.0/phc3.0_winter.nc
OUT=/work/ab0995/a270088/port/kpp_5yr_fix
mkdir -p "$OUT"
( cd "$REPO" && git rev-parse HEAD ) > "$OUT/SHA.txt" 2>/dev/null
export FESOM_MIX_SCHEME=KPP
export FESOM_DIAG_MICE=1
export FESOM_PRINT_EVERY=1000
srun -l --ntasks=864 "$BIN" "$MESH" "$OUT" 1800 87600 -1 "$PHC" 1958 \
     > "$OUT/run.log" 2> "$OUT/run.err"
echo "exit: $?"
echo "--- last mice-mon ---"; grep '\[mice-mon\]' "$OUT/run.err" | tail -3
echo "--- BLOWUP / uv>5 ? ---"; grep -iE "blowup|uv>5|nan" "$OUT/run.err" | tail -3
true
