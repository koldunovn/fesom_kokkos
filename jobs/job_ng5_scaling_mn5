#!/bin/bash
# job_ng5_scaling_mn5 — NG5 strong-scaling driver on MN5 ACC (H100 / sm_90).
#
# Parametrised via --export TAG=... and sbatch CLI for nodes/ntasks. 1 rank per
# H100 (4/node), dt=180 (CFL-stable at NG5 resolution), 35 steps, no snapshots.
# See submit_ng5_scaling_mn5.sh for the sweep.

#SBATCH --job-name=fesom_ng5_scal_mn5
#SBATCH --account=ehpc01
#SBATCH --qos=acc_ehpc
#SBATCH --partition=acc
#SBATCH --ntasks-per-node=4
#SBATCH --cpus-per-task=20
#SBATCH --gres=gpu:4
#SBATCH --time=00:30:00
#SBATCH --output=jobs/mn5_logs/%x-%j.out
#SBATCH --error=jobs/mn5_logs/%x-%j.err

set -euo pipefail
mkdir -p jobs/mn5_logs

ROOT=/gpfs/projects/ehpc01/sbeyer/fesom_kokkos
source "$ROOT/env_mn5.sh"
export SLURM_CPU_BIND=none

BIN=$ROOT/build-cuda-mn5/fesom_port
MESH=/gpfs/scratch/ehpc01/sbeyer/inproot/fesom/v21/NG5
PHC=/gpfs/scratch/ehpc01/sbeyer/inproot/fesom/v21/hydrography/phc3.0/phc3.0_winter.nc

export FESOM_JRA55_DIR=/gpfs/scratch/ehpc01/sbeyer/fesom_forcing/JRA5
export FESOM_SSS_PATH=/gpfs/scratch/ehpc01/sbeyer/inproot/fesom/v21/forcing/CORE2/PHC2_salx.nc
export FESOM_RUNOFF_PATH=""
export FESOM_CHL_SOURCE=None
export FESOM_PRINT_EVERY=999

OUT=/gpfs/scratch/ehpc01/sbeyer/fesom_runs/ng5_scaling_mn5_${TAG:-default}_${SLURM_JOB_ID}
rm -rf "$OUT"; mkdir -p "$OUT"

NPES=$SLURM_NTASKS
if [ ! -d "$MESH/dist_$NPES" ]; then
    echo "ERROR: $MESH/dist_$NPES missing"; exit 2
fi

echo "=== NG5 MN5 scaling ${TAG:-?} (nodes=$SLURM_NNODES ranks=$NPES gpus=$((SLURM_NNODES*4)), dist_$NPES) ==="
echo "    nodes: $SLURM_JOB_NODELIST"

date
mpirun --bind-to none -np "$NPES" \
    "$BIN" "$MESH" "$OUT" "${DT:-180}" "${NSTEPS:-35}" -1 "$PHC" 1958 \
    > "$OUT/run.log" 2> "$OUT/run.err"
EC=$?
date

echo "=== exit=$EC ==="
echo "--- loop timing ---"
grep "loop timing" "$OUT/run.log" | tail -1
echo "--- last step ---"
grep " it=" "$OUT/run.log" | tail -1
exit $EC
