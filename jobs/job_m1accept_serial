#!/bin/bash
# M1 ACCEPTANCE — step 2/4: Kokkos SERIAL backend (the primary bit-identity gate).
# Same CORE2 1-yr config as job_m1accept_cref; must reproduce cref/ snapshots BYTE-FOR-BYTE.
# (Kokkos backend = per-rank execution space; MPI parallelism across the 256 ranks is independent
# of it, so the Serial build runs multi-rank just like the C twin.)
#SBATCH --job-name=m1acc_ser
#SBATCH -p compute
#SBATCH --nodes=2
#SBATCH --ntasks-per-node=128
#SBATCH --ntasks=256
#SBATCH --time=03:00:00
#SBATCH -A ab0995
#SBATCH -o /scratch/a/a270088/m1_accept/serial/slurm.%j.out
#SBATCH -e /scratch/a/a270088/m1_accept/serial/slurm.%j.err

set -u
source /sw/etc/profile.levante
source /home/a/a270088/port_kokkos/env.sh         # the Kokkos build's runtime env
ulimit -s 204800

MESH=/pool/data/AWICM/FESOM2/MESHES_FESOM2.1/core2
PHC=/home/a/a270088/FESOM_port/fesom2/tests/data/INITIAL/phc3.0/phc3.0_winter.nc
DT=1800
NSTEPS=17280
SNAP_EVERY=1440
JRA55_YEAR=1958
export FESOM_PRINT_EVERY=1000

BIN=/home/a/a270088/port_kokkos/build-serial/fesom_port
OUT_DIR=/scratch/a/a270088/m1_accept/serial
mkdir -p "$OUT_DIR"

echo "=== M1 acceptance KOKKOS SERIAL — $(date) ==="
srun -l "$BIN" "$MESH" "$OUT_DIR" "$DT" "$NSTEPS" "$SNAP_EVERY" "$PHC" "$JRA55_YEAR" \
    > "$OUT_DIR/run.log" 2> "$OUT_DIR/run.err"
EC=$?
echo "=== done $(date) — exit $EC ==="
grep -m1 "Kokkos backend" "$OUT_DIR/run.log"
tail -20 "$OUT_DIR/run.log"; tail -10 "$OUT_DIR/run.err"
exit $EC
