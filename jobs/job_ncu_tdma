#!/bin/bash
#SBATCH --job-name=kk_ncu_tdma
#SBATCH -p gpu
#SBATCH -A ab0995
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --ntasks-per-node=1
#SBATCH --gres=gpu:1
#SBATCH --gpu-bind=none
#SBATCH --time=00:45:00
#SBATCH -o /work/ab0995/a270088/port2/tdma_profile/ncu_core2/job.%j.out
#SBATCH -e /work/ab0995/a270088/port2/tdma_profile/ncu_core2/job.%j.err
#
# TDMA-column ncu profile (compute-lever scouting). The 3 ocean vertical solvers
# carry 10x real_t[FESOM_MAX_LEVELS=128] per-thread local arrays => STACK:10240
# bytes/thread (confirmed static via cuobjdump --dump-resource-usage). This job
# measures the RUNTIME cost: achieved occupancy + the limiter, local-memory
# traffic (the spill), global sectors/request (coalescing), per-kernel duration.
# Single-GPU CORE2 on gpu-devel; --set full for the rich report.
#
# Kernels (enclosing-function fragments, present in the demangled symbol):
#   fesom_impl_vert_visc_kk        (momentum vertical viscosity TDMA)
#   fesom_fer_solve_gamma_kk       (GM streamfunction TDMA; only if GM active)
#   diff_ver_part_impl_ale_kk      (tracer vertical diffusion TDMA)

ROOT=/home/a/a270088/port_kokkos
source "$ROOT/env_cuda.sh"
export OMPI_MCA_pml=ucx OMPI_MCA_btl=self UCX_NET_DEVICES=mlx5_0:1
export UCX_MEMTYPE_CACHE=n OMPI_MCA_coll_hcoll_enable=0
export OMPI_MCA_io=romio321 HDF5_USE_FILE_LOCKING=FALSE
# NOTE: do NOT set FESOM_STEP_PROFILE here (its per-kernel fences inflate ncu replay).

MESH=/pool/data/AWICM/FESOM2/MESHES_FESOM2.1/core2
PHC=/home/a/a270088/FESOM_port/fesom2/tests/data/INITIAL/phc3.0/phc3.0_winter.nc
OUT=/work/ab0995/a270088/port2/tdma_profile/ncu_core2
rm -rf "$OUT"; mkdir -p "$OUT"

KREGEX='impl_vert_visc|fer_solve_gamma|diff_ver_part_impl_ale'

echo "=== ncu TDMA columns, CORE2 np=1, 5 steps, dt=1800, JRA55=1958 ==="
echo "regex: $KREGEX"
srun ncu --set full \
         --kernel-name-base demangled \
         --kernel-name regex:"$KREGEX" \
         --launch-count 9 \
         -o "$OUT/tdma" -f \
     "$ROOT/build-cuda/fesom_port" "$MESH" "$OUT" 1800 5 999999 "$PHC" 1958 > "$OUT/run.log" 2>&1
echo "srun rc=$?"

# Targeted CSV: duration, registers, occupancy, global coalescing (sectors/req),
# local-mem traffic (the spill), compute & memory SOL.
ncu -i "$OUT/tdma.ncu-rep" --csv --page raw \
    --metrics gpu__time_duration.sum,launch__registers_per_thread,sm__warps_active.avg.pct_of_peak_sustained_active,l1tex__average_t_sectors_per_request_pipe_lsu_mem_global_op_ld.ratio,l1tex__average_t_sectors_per_request_pipe_lsu_mem_global_op_st.ratio,l1tex__t_sectors_pipe_lsu_mem_local_op_ld.sum,l1tex__t_sectors_pipe_lsu_mem_local_op_st.sum,sm__throughput.avg.pct_of_peak_sustained_elapsed,gpu__compute_memory_throughput.avg.pct_of_peak_sustained_elapsed \
    > "$OUT/tdma_sol.csv" 2>&1 && echo "tdma_sol.csv: $(wc -l < "$OUT/tdma_sol.csv") rows"
ncu -i "$OUT/tdma.ncu-rep" --page details > "$OUT/details.txt" 2>&1 && echo "details.txt: $(wc -l < "$OUT/details.txt") lines"
echo "=== done — fetch $OUT/tdma.ncu-rep for ncu-ui; tdma_sol.csv for the table ==="
