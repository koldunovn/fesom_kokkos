#!/bin/bash
#SBATCH --job-name=m10_lab
#SBATCH -p compute
#SBATCH -A ab0995
#SBATCH --time=00:20:00
#SBATCH -o /work/ab0995/a270088/port2/m10/gates/lab.%j.out
#SBATCH -e /work/ab0995/a270088/port2/m10/gates/lab.%j.err
#
# M10 open-item-3 — offline lab battery on a dumped system, at the dump's own np.
#
# Runs, on ONE dumped step:
#   1. --sym-check     symmetry defect of pr_values (R1)
#   2. --sigma-drift   the Layer-0 falsification: sigma_true vs the CG-CG recurrence,
#                      both as-built and symmetrised
#   3. cg2 + cg traces at a tolerance ladder -> STALL-guard plateau analysis
#      (scripts/m10_stall_analysis.py replays the guard against the real residuals)
#
# ⚠️ Lab numbers are NEVER performance numbers of record (R4/T3 rule).
#
# Submit: sbatch -N 1 --ntasks=64 --export=ALL,MESH=$DARS,DUMP=/work/.../labdumps/dars_np64/step0001,TAG=dars jobs/job_m10_lab

set -u
ROOT=${M10_ROOT:-$HOME/port_kokkos_ssh}
source "$ROOT/jobs/m7_provenance.sh"
source /sw/etc/profile.levante
source "$ROOT/env.sh"
export OMPI_MCA_btl_vader_single_copy_mechanism=none

MESH=${MESH:?MESH required}
DUMP=${DUMP:?DUMP required (a stepNNNN dir)}
TAG=${TAG:?TAG required}
NPES=$SLURM_NTASKS
LAB=${BIN:-$ROOT/build-m7serial/fesom_ssh_lab}
PY=/work/ab0995/a270088/mambaforge/envs/nereus/bin/python
OUT=/work/ab0995/a270088/port2/m10/gates/lab_${TAG}_${SLURM_JOB_ID}
rm -rf "$OUT"; mkdir -p "$OUT"
m7_provenance "$OUT" "$LAB"
cat "$OUT/SHA.txt"
[ -d "$MESH/dist_$NPES" ] || { echo "ERROR: $MESH/dist_$NPES missing"; exit 2; }
[ -d "$DUMP" ]            || { echo "ERROR: dump $DUMP missing"; exit 2; }

echo "=== M10 lab  $TAG  mesh=$(basename "$MESH") np=$NPES dump=$DUMP ==="

# SECTIONS: which of 1..4 to run (default all). The sigma-drift and the tolerance ladder are
# slow at large np (host-side reference PCG + up to 2000 iterations per run), and section 4 —
# the DECISIVE widened-guard test — used to sit behind them, so a walltime kill lost exactly
# the result the job was for. Select it directly: SECTIONS=4.
SECTIONS=${SECTIONS:-1234}
want () { case "$SECTIONS" in *"$1"*) return 0;; *) return 1;; esac; }

want 1 && {
echo "--- 1. sym-check"
srun "$LAB" "$MESH" "$DUMP" --sym-check > "$OUT/symcheck.out" 2> "$OUT/symcheck.err"
echo "    rc=$?"; grep -a "lab" "$OUT/symcheck.out" | sed 's/^/      /'
}

want 2 && {
echo "--- 2. sigma-drift"
srun "$LAB" "$MESH" "$DUMP" --sigma-drift > "$OUT/sigma.out" 2> "$OUT/sigma.err"
echo "    rc=$?"; grep -a "lab-sigma" "$OUT/sigma.out" | tail -40 | sed 's/^/      /'
}

want 3 && {
echo "--- 3. stall-guard plateau ladder"
for tol in 1e-5 1e-7 1e-9; do
    for slv in cg cg2 oati; do
        FESOM_SSH_TRACE=1 srun "$LAB" "$MESH" "$DUMP" --solver "$slv" \
            --tol "$tol" --maxiter 2000 \
            > "$OUT/tr_${slv}_${tol}.out" 2> "$OUT/tr_${slv}_${tol}.err"
        it=$(grep -a "rep 1" "$OUT/tr_${slv}_${tol}.out" | sed -E 's/.*iters=([0-9]+).*/\1/')
        pl=$("$PY" "$ROOT/scripts/m10_stall_analysis.py" "$OUT/tr_${slv}_${tol}.err" 2>/dev/null \
             | grep "longest plateau" | sed -E 's/.*: ([0-9]+) iter.*/\1/')
        fb=$(grep -ac "FALLBACK on solve" "$OUT/tr_${slv}_${tol}.err")
        printf "    tol=%-6s solver=%-5s iters=%-6s max_plateau=%-4s fallbacks=%s\n" \
               "$tol" "$slv" "${it:-?}" "${pl:-?}" "$fb"
    done
done
}

want 4 && {
echo "--- 4. guard WIDENED: does the variant recover if the stall guard never fires?"
# The decisive test for open item 3. STALL_WINDOW=100000 effectively disables the plateau
# trigger (the `resid > 1e3*best` divergence trigger stays armed), maxiter 2000 gives room.
# If the residual is still stuck ~37x above rtol at 2000 iterations, the breakdown is REAL
# and the guard is doing its job; if it converges, the guard was aborting a live solve.
for slv in cg2 oati pipecg; do
    FESOM_SSH_TRACE=1 FESOM_SSH_STALL_WINDOW=100000 \
        srun "$LAB" "$MESH" "$DUMP" --solver "$slv" --maxiter 2000 \
        > "$OUT/wide_${slv}.out" 2> "$OUT/wide_${slv}.err"
    echo "    rc=$? solver=$slv"
    grep -a "rep 1\|lab\]" "$OUT/wide_${slv}.out" | tail -2 | sed 's/^/      /'
    # residual at the end vs the best ever reached
    "$PY" - "$OUT/wide_${slv}.err" <<'PYEOF' | sed 's/^/      /'
import re,sys
TR=re.compile(rb"\[ssh-trace\]\s+it=(\d+).*?res=([0-9eE+.\-]+)")
h=[]
for line in open(sys.argv[1],'rb'):
    m=TR.search(line)
    if m:
        try: h.append((int(m.group(1)),float(m.group(2))))
        except ValueError: pass
if h:
    best=min(r for _,r in h)
    print(f"iters={h[-1][0]} final_res={h[-1][1]:.4e} best_res={best:.4e} "
          f"(best at it={[i for i,r in h if r==best][0]})")
PYEOF
    grep -a "FALLBACK on solve" "$OUT/wide_${slv}.err" | sed 's/^/      /'
done
}

want 5 && {
echo "--- 5. DEFAULT-guard control (same system, same binary, knob UNSET)"
# The airtight A/B for section 4: the ONLY difference is FESOM_SSH_STALL_WINDOW. If this leg
# falls back where section 4 converged, the guard — not the solver — is what failed.
for slv in cg2 oati; do
    FESOM_SSH_TRACE=1 srun "$LAB" "$MESH" "$DUMP" --solver "$slv" --maxiter 2000 \
        > "$OUT/dflt_${slv}.out" 2> "$OUT/dflt_${slv}.err"
    echo "    rc=$? solver=$slv  fallbacks=$(grep -ac 'FALLBACK on solve' "$OUT/dflt_${slv}.err")"
    grep -a "FALLBACK on solve" "$OUT/dflt_${slv}.err" | sed 's/^/      /'
    grep -a "rep 1" "$OUT/dflt_${slv}.out" | sed 's/^/      /'
done
}

want 6 && {
echo "--- 6. longest LEGITIMATE stagnation (guard widened) — sizes the safe window"
# How many consecutive non-improving iterations does a solve that DOES converge go through?
# That is the number STALL_WINDOW must clear. Reported per solver on this system.
for slv in cg cg2 oati; do
    FESOM_SSH_TRACE=1 FESOM_SSH_STALL_WINDOW=100000 \
        srun "$LAB" "$MESH" "$DUMP" --solver "$slv" --maxiter 2000 \
        > "$OUT/stag_${slv}.out" 2> "$OUT/stag_${slv}.err"
    printf "    solver=%-5s " "$slv"
    "$PY" "$ROOT/scripts/m10_stall_analysis.py" "$OUT/stag_${slv}.err" 2>/dev/null \
        | grep -E "longest plateau" | sed 's/^/  /'
done
}

echo "=== done ==="
