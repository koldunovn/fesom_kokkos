#!/bin/bash
#SBATCH --job-name=m6_zstar_dump
#SBATCH -p compute
#SBATCH -A ab0995
#SBATCH --nodes=1
#SBATCH --ntasks=8
#SBATCH --ntasks-per-node=8
#SBATCH --time=00:20:00
#SBATCH -o /work/ab0995/a270088/port2/m6/zstardump.%j.out
#SBATCH -e /work/ab0995/a270088/port2/m6/zstardump.%j.err
#
# M6.3 Task 3.7 BISECT — paired ALE-dump runs, C oracle vs Kokkos-Serial, at zstar.
#
# The snapshot bisect (SLURM 26211151) put the seed inside step 2:
#   snap 0, snap 1 = EXACTLY 0 on every field; snap 2 = eta_n 1.93e-13 at 97.76% of ALL
#   nodes, while density/pgf/bvfreq are STILL exactly 0. A uniform ~1e-13 shift over
#   essentially every node, scaling with areasvol(n), is the signature of a GLOBAL SCALAR
#   off by one ULP -- not a field kernel (a bad kernel is local; this is everywhere).
#
# This job dumps the SIX ale_dump tags from both trees at the SAME six sites and diffs
# them gid-keyed, so the first tag to move names the phase:
#   forcing (top of step)  -> water_flux/virtual_salt/relax_salt/real_salt_flux
#   pgf     (after PGF)    -> pgf_x, pgf_y
#   sshsolve(after CG)     -> ssh_rhs, d_eta
#   hbar    (after eta_n)  -> hbar, hbar_old, ssh_rhs_old, eta_n + dhe
#   Wvel    (after vertvel)-> w, hnode_new
#   thickness (after commit)-> hnode, zbar_3d_n, Z_3d_n, helem
#
# PRIME SUSPECT: `net` in the zstar freshwater global-balancing reduction (Task 3.2) -- the
# ONLY global scalar zstar adds, and `water_flux(n) += net` reaches every node. The integrator
# (integrate_nod_2D_kk) is shared with relax_salt and is byte-proven under linfs, so if the seed
# is there it is in `flux`'s INPUTS -- and evaporation/ice_sublimation are precisely the two new
# therm_ice outputs that NO gate has ever compared (icethermo verify checks 9 outputs, not these;
# and under linfs they are dead stores, so the byte gate cannot see them either).
#
# Ice runs BEFORE the ocean step, so s2/forcing is the coupling output computed FROM the
# (bit-identical) post-step-1 state. If s2/forcing already differs => the seed is in the ice
# coupling itself, on bit-identical inputs => a genuine transcription error.
#
# L18: CMA off on both legs.

set -u
C_REPO=/home/a/a270088/port2/fesom2_port_zstar
K_REPO=/home/a/a270088/port_kokkos
C_BIN=$C_REPO/build-m6oracle/fesom_port
K_BIN=$K_REPO/build-serial/fesom_port

MESH=/work/ab0995/a270088/port2/mesh/core2      # the M6 private mesh -- NOT /pool
PHC=/home/a/a270088/FESOM_port/fesom2/tests/data/INITIAL/phc3.0/phc3.0_winter.nc
DT=1800; NSTEPS=3; SNAP=1; YEAR=1958

BASE=/work/ab0995/a270088/port2/m6/zstar_dump
OUT_C=$BASE/c_zstar;  OUT_K=$BASE/kk_zstar
D_C=$BASE/cdump;      D_K=$BASE/kdump
rm -rf "$OUT_C" "$OUT_K" "$D_C" "$D_K"
mkdir -p "$OUT_C" "$OUT_K" "$D_C" "$D_K"

export FESOM_ALE=zstar                          # <-- THE KNOB
export FESOM_ALE_DUMP_STEPS=3
unset FESOM_MIX_SCHEME FESOM_WHICH_EVP

echo "=============== LEG A: C oracle, FESOM_ALE=zstar + dump ==============="
source /sw/etc/profile.levante
source "$C_REPO/env.sh"
export OMPI_MCA_btl_vader_single_copy_mechanism=none    # L18
ulimit -s 204800
export FESOM_ALE_DUMP_DIR=$D_C
srun -l "$C_BIN" "$MESH" "$OUT_C" $DT $NSTEPS $SNAP "$PHC" $YEAR > "$OUT_C/run.log" 2> "$OUT_C/run.err"
echo "leg A exit: $?"; echo "dump files: $(ls "$D_C" | wc -l)"

echo
echo "=============== LEG B: Kokkos-Serial, FESOM_ALE=zstar + dump ==============="
source "$K_REPO/env.sh"
export OMPI_MCA_btl_vader_single_copy_mechanism=none    # L18
export FESOM_ALE_DUMP_DIR=$D_K
srun -l "$K_BIN" "$MESH" "$OUT_K" $DT $NSTEPS $SNAP "$PHC" $YEAR > "$OUT_K/run.log" 2> "$OUT_K/run.err"
echo "leg B exit: $?"; echo "dump files: $(ls "$D_K" | wc -l)"

echo
echo "=========== ALE-DUMP DIFF: C oracle vs Kokkos-Serial, both at zstar ==========="
PY=/work/ab0995/a270088/mambaforge/envs/nereus/bin/python
"$PY" "$C_REPO/scripts/ale_dump_diff.py" "$D_C" "$D_K"

echo
echo "=========== SNAPSHOT GATE (same run) ==========="
"$PY" "$K_REPO/scripts/diff_snap.py" "$OUT_C" "$OUT_K"
echo "diff_snap rc=$?"
