#!/bin/bash
#SBATCH --job-name=m7gdrprobe
#SBATCH -p gpu
#SBATCH -A ab0995
#SBATCH -N 1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:1
#SBATCH --constraint=a100_80
#SBATCH --time=00:06:00
#SBATCH -o /work/ab0995/a270088/port2/m7/gdrprobe.%j.out
#SBATCH -e /work/ab0995/a270088/port2/m7/gdrprobe.%j.err
#
# M7 session-14 / lit-survey §7 probe 1 — GPUDirect capability census on a gpu compute
# node (login has no GPU, so this must be a job). Pure inspection, no model run.
#   nvidia_peermem / nv_peer_mem  -> GPUDirect RDMA (NIC reads GPU memory) possible
#   gdrdrv + /dev/gdrdrv          -> UCX gdr_copy transport possible (fast small D<->H)
#   ucx_info -d                   -> which cuda/gdr transports THIS UCX exposes
# 6-min walltime on purpose: a cheap gate must LOOK cheap to the scheduler.

set -u
ROOT=/home/a/a270088/port_kokkos
source "$ROOT/env_cuda.sh"

echo "=== GPUDirect probe on $(hostname)  $(date -Is) ==="
echo
echo "--- kernel modules (nvidia_peermem|nv_peer_mem = GPUDirect RDMA; gdrdrv = gdr_copy) ---"
lsmod | grep -iE 'nvidia_peermem|nv_peer_mem|gdrdrv' || echo "NONE of nvidia_peermem / nv_peer_mem / gdrdrv is loaded"
echo
echo "--- device nodes ---"
ls -l /dev/gdrdrv 2>/dev/null || echo "/dev/gdrdrv ABSENT"
ls -ld /dev/infiniband/uverbs* 2>/dev/null | head -4
echo
echo "--- ucx_info location + version ---"
UCXI=$(command -v ucx_info || ls /sw/spack-levante/ucx-*/bin/ucx_info 2>/dev/null | head -1)
echo "ucx_info: ${UCXI:-NOT FOUND}"
[ -n "${UCXI:-}" ] && "$UCXI" -v 2>&1 | head -6
echo
echo "--- ucx transports mentioning cuda/gdr ---"
[ -n "${UCXI:-}" ] && "$UCXI" -d 2>/dev/null | grep -iE 'gdr|cuda' | sed 's/^ *//' | sort | uniq -c | sort -rn | head -25
echo
echo "--- ucx full transport inventory ---"
[ -n "${UCXI:-}" ] && "$UCXI" -d 2>/dev/null | grep -E 'Transport:|Device:' | paste - - | sed 's/^ *//' | sort | uniq -c | head -40
echo
echo "--- nvidia-smi topo (NVLink / PIX / NODE map) ---"
nvidia-smi topo -m 2>&1 | head -16
echo
echo "=== probe done ==="
