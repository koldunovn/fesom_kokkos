#!/bin/bash
#SBATCH --job-name=m7dtpair
#SBATCH -p gpu
#SBATCH -A ab0995
#SBATCH --ntasks-per-node=4
#SBATCH --gres=gpu:4
#SBATCH --gpu-bind=none
#SBATCH --constraint=a100_80
#SBATCH --time=00:20:00
#SBATCH -o /work/ab0995/a270088/port2/m7/dtpair.%j.out
#SBATCH -e /work/ab0995/a270088/port2/m7/dtpair.%j.err
#
# M7 same-allocation DT PAIR — measures the CG dt-correction for the SYPD footnote
# (production-dt SYPD derived from runs at a smaller, cold-start-stable dt).
# Two DT values run on the SAME nodes (hardware cancels), class-A env (FESOM_SPEED=1,
# EVPWIDE=8), 35-step legs (under the rule-0.41 cold-start wall), 2 reps each,
# min-of-2. Reports s/step + mean CG iters per dt; the correction factor is
# s_step(DT2)/s_step(DT1) at matched everything-else.
# env: MESH, DT1, DT2, TAG, [NSTEPS=35] [BIN]

set -u
ROOT=/home/a/a270088/port_kokkos
source "$ROOT/jobs/m7_provenance.sh"
source "$ROOT/env_cuda.sh"
export OMPI_MCA_pml=ucx OMPI_MCA_btl=self UCX_NET_DEVICES=mlx5_0:1
export UCX_MEMTYPE_CACHE=n OMPI_MCA_coll_hcoll_enable=0
export OMPI_MCA_io=romio321 HDF5_USE_FILE_LOCKING=FALSE
export FESOM_PRINT_EVERY=999
export FESOM_SPEED=1 FESOM_SPEED_EVPWIDE=8     # class A (the fleet reference env)

MESH=${MESH:?MESH required}
PHC=/home/a/a270088/FESOM_port/fesom2/tests/data/INITIAL/phc3.0/phc3.0_winter.nc
TAG=${TAG:?TAG required}
OUT=/work/ab0995/a270088/port2/m7/$TAG; rm -rf "$OUT"; mkdir -p "$OUT"
NPES=$SLURM_NTASKS
FESOM=${BIN:-$ROOT/build-m7cuda/fesom_port}
m7_provenance "$OUT" "$FESOM"
[ -d "$MESH/dist_$NPES" ] || { echo "ERROR: $MESH/dist_$NPES missing"; exit 2; }

echo "=== M7 DT PAIR  $TAG  mesh=$(basename "$MESH") nodes=$SLURM_NNODES ntasks=$NPES dt=${DT1:?}/${DT2:?} nsteps=${NSTEPS:-35} ==="
echo "nodes: $SLURM_JOB_NODELIST"

for DT in "$DT1" "$DT2"; do
    for rep in a b; do
        srun "$FESOM" "$MESH" "$OUT" "$DT" "${NSTEPS:-35}" -1 "$PHC" 1958 \
            > "$OUT/log_dt${DT}_${rep}.txt" 2>&1
    done
    r1=$(grep 'loop timing' "$OUT/log_dt${DT}_a.txt" | tail -1 | sed -E 's/.*-> +([0-9.]+) s\/step/\1/')
    r2=$(grep 'loop timing' "$OUT/log_dt${DT}_b.txt" | tail -1 | sed -E 's/.*-> +([0-9.]+) s\/step/\1/')
    it=$(grep -h 'CG iters' "$OUT/log_dt${DT}_a.txt" | awk '{s+=$(NF-2); n++} END {if(n) printf "%.1f", s/n}')
    echo "  dt$DT: ${r1:-FAIL} ${r2:-FAIL} s/step  mean_iters=${it:-NA}"
done
echo "=== correction = min-of-2(dt$DT2) / min-of-2(dt$DT1) ==="
