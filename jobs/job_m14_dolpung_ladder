#!/bin/bash
#SBATCH --job-name=m14_dlad
#SBATCH -p dolpung
#SBATCH -A mh1571
#SBATCH --ntasks-per-node=4
#SBATCH --cpus-per-task=72
#SBATCH --gres=gpu:4
#SBATCH --gpu-bind=none
#SBATCH -o /work/ab0995/a270088/port2/m14/dlad.%j.out
#SBATCH -e /work/ab0995/a270088/port2/m14/dlad.%j.err
#
# M14 — one rung of a dolpung (GH200) GPU strong-scaling ladder.
#
# Second GPU architecture for the board, and it runs on account mh1571, so it is free of the
# ab0995 association limit that blocks Levante GPU work.
#
# ⭐ PLATFORM FIX, MANDATORY: FESOM_HALO_STAGE=1 (+UCX_TLS). The fabric CANNOT register CUDA
# memory (gdr_pin_buffer ret:22 intra-node, ibv_reg_mr(cuda) Bad address inter-node) => there is
# no GPUDirect here. STAGE keeps device pack/unpack and puts only the PACKED bytes through pinned
# host, so the CG levers stay live.
# 🔴 NEVER FESOM_HOST_HALO=1 for performance: it is a debug fallback that does full-field GPU<->host
# syncs AND silently kills CGPIPE+CGPOLY. That trap cost fleet v1 a factor ~2 and read as
# "GH200 barely beats A100" for half a day.
#
# 🔴 EVPWIDE IS NOT A CANDIDATE HERE — already A/B'd on this machine and banked as a loss AND
# fabric-incompatible. (It also loses on CPU: +14…+20 % measured today. The A100 win is specific
# to a machine where a flat per-message staging cost dominates.)
#
# 🔴 A CUDA trajectory bitwise gate is INVALID on this transport: the device transport does not
# reproduce itself run-to-run (dev-vs-dev = dev-vs-stage noise ~1e-4 at 10 steps). The valid
# instruments are the per-exchange halo selfcheck and FESOM_CGPOLY_SELFCHECK, plus Serial byte
# gates on Levante. Do not attempt diff_snap between two GPU runs here.
#
# Usage:
#   sbatch --nodes=2 --ntasks=8 --time=00:40:00 --export=ALL,POINT=core2,ARMS=base jobs/job_m14_dolpung_ladder
#   sbatch --nodes=4 --ntasks=16 --time=00:50:00 \
#     --export=ALL,POINT=farc,ARMS="base best",BASE_KNOBS="FESOM_ALE=zstar",BEST_KNOBS="FESOM_SSH_MODE=se" \
#     jobs/job_m14_dolpung_ladder

set -u
ROOT=/home/a/a270088/port_kokkos_int
source $ROOT/env_dolpung.sh || exit 1

N=$SLURM_NTASKS
case "${POINT:?POINT required}" in
  core2) MESH=/work/ab0995/a270088/port2/mesh/core2 ; DT=1800 ;;   # private mesh (L73)
  farc)  MESH=/pool/data/AWICM/FESOM2/MESHES_FESOM2.1/farc ; DT=900 ;;
  dars)  MESH=/pool/data/AWICM/FESOM2/MESHES_FESOM2.1/dars ; DT=120 ;;
  ng5)   MESH=/pool/data/AWICM/FESOM2/MESHES_FESOM2.1/ng5  ; DT=180 ;;
  *) echo "unknown POINT=$POINT"; exit 2 ;;
esac
MESH=${MESH_OVERRIDE:-$MESH}
NSTEPS=${NSTEPS:-300}
ARMS=${ARMS:-base}
BASE_KNOBS=${BASE_KNOBS:-}
BEST_KNOBS=${BEST_KNOBS:-}
PHC=/home/a/a270088/FESOM_port/fesom2/tests/data/INITIAL/phc3.0/phc3.0_winter.nc
BIN=${M14_BIN:-/work/ab0995/a270088/port2/m14/bin/i1_dolpung}/fesom_port_cuda

[ -d "$MESH/dist_$N" ] || { echo "REFUSE: $MESH/dist_$N missing"; exit 2; }

if [ "$SLURM_NNODES" -gt 1 ]; then export UCX_TLS=self,sm,cuda_copy,cuda_ipc,dc_mlx5
else                                export UCX_TLS=self,sm,cuda_copy,cuda_ipc; fi

OUT=/work/ab0995/a270088/port2/m14/dlad_${POINT}_${N}_${SLURM_JOB_ID}
mkdir -p "$OUT"; : > "$OUT/legs.txt"
echo "=== M14 dolpung ladder — $POINT gpus=$N nodes=$SLURM_NNODES dt=$DT steps=$NSTEPS arms='$ARMS' ==="
echo "mesh : $MESH/dist_$N"
echo "nodes: $SLURM_JOB_NODELIST"
echo "UCX_TLS=$UCX_TLS"
md5sum "$BIN"
[ -n "$BASE_KNOBS" ] && echo "base knobs: $BASE_KNOBS"
[ -n "$BEST_KNOBS" ] && echo "best knobs: $BEST_KNOBS"
# BEST_MESH: the PARTITION lever is a mesh directory, not an env knob. Missing here for the whole
# campaign, exactly as it was in job_m14_ladder_gpu, so the lever had no GH200 coverage either.
if [ -n "${BEST_MESH:-}" ]; then
    echo "best mesh : $BEST_MESH/dist_$N   (partition lever)"
    [ -d "$BEST_MESH/dist_$N" ] || { echo "REFUSE: $BEST_MESH/dist_$N does not exist"; exit 2; }
fi

# 🔴 WSPLIT MUST BE DECLARED — it is not allowed to be silently absent (rule 0.41).
# A cold PHC start at the protocol dt rides a CFL blow-up on the big meshes; the onset step is
# ROUNDOFF-SEEDED (CUDA atomics vs serial order, rank count), so it moves with the backend and the
# rank count and a leg can die anywhere from step 4 to step 291. M5.24 found it, M7 re-confirmed it
# as rule 0.41 ("'dt180 stable' was only ever a 35-step statement"), and the discriminator settled
# the cure: Fortran WITHOUT wsplit dies in the same window (rc=1, NaN after 261 CFLz warnings),
# Fortran WITH wsplit completes. Production practice on large meshes always runs it.
# Every leg of this campaign ran with it OFF and nothing in the log said so, which is why NG5 lost
# its whole GPU arm (7 of 37 legs survived) and it read as a new CG bug. So: declare it, either way.
#   WSPLIT=1  FESOM_WSPLIT=1 on BOTH arms — it is a configuration, not a lever
#   WSPLIT=0  the historical configuration, knowingly unstable on a cold start at protocol dt
# The value is stamped into cfg= so a wsplit-on row can never be compared against a wsplit-off one.
# USER RULE (2026-08-16): "wsplit should be ON on large meshes." So it is the DEFAULT here for
# every mesh but CORE2, and turning it OFF on a large mesh takes an explicit WSPLIT=0. Defaulting
# is the point: this trap has now cost the project three times, and remembering is not a mechanism.
case "${WSPLIT:-${POINT}}" in
    1)               WSPLIT_TAG=wsplit1 ;;
    0)               WSPLIT_TAG=wsplit0 ;;
    core2)           WSPLIT_TAG=wsplit0 ;;   # small mesh, no cold-start CFL class documented
    farc|dars|ng5)   WSPLIT_TAG=wsplit1 ;;   # large meshes -> ON by default
    *) echo "REFUSE: WSPLIT=\"${WSPLIT:-}\" is not 0 or 1 — refusing to guess"; exit 2 ;;
esac
echo "wsplit    : $WSPLIT_TAG${WSPLIT:+ (explicit WSPLIT=$WSPLIT)}"


leg () {                        # leg <arm> <index>
    local arm=$1 idx=$2
    local out="$OUT/${idx}_${arm}"
    local extra="" mesh="$MESH"
    mkdir -p "$out"
    [ "$arm" = best ] && extra="$BEST_KNOBS"
    [ "$arm" = best ] && [ -n "${BEST_MESH:-}" ] && mesh="$BEST_MESH"
    srun -c72 --distribution=block:block bash -c "
        export FESOM_SPEED=1 FESOM_HALO_STAGE=1 FESOM_IC_EXTRAP=det
        $([ "$WSPLIT_TAG" = wsplit1 ] && printf 'export FESOM_WSPLIT=1; ')
        $(for kv in $BASE_KNOBS $extra; do printf 'export %s; ' "$kv"; done)
        exec $BIN $mesh $out $DT $NSTEPS -1 $PHC 1958" > "$out/run.log" 2>&1
    local rc=$?
    local t; t=$(grep -oE '\->[[:space:]]*[0-9.]+ s/step' "$out/run.log" | tail -1 | grep -oE '[0-9.]+')
    local last; last=$(grep -E '^[[:space:]]*[0-9]+[[:space:]]+it=' "$out/run.log" | tail -1)
    local live=yes
    [ -n "$last" ] || live=no
    echo "$last" | grep -qiE 'nan|inf' && live=no
    # HOST_HALO trap detector: if CGPIPE ever reports INACTIVE the transport is wrong and the
    # timing is meaningless (that is the factor-~2 trap from fleet v1).
    grep -q 'cgpipe.*INACTIVE' "$out/run.log" && { echo "  !! CGPIPE INACTIVE — wrong transport"; live=no; }
    echo "leg $idx $arm: rc=$rc s/step=${t:-NA} live=$live"
    [ "$live" = yes ] && [ "$rc" -eq 0 ] && [ -n "$t" ] && echo "$arm $t" >> "$OUT/legs.txt" \
        || echo "  !! leg REJECTED"
}

echo; echo "--- warmup (discarded) ---"; leg warmup 0; : > "$OUT/legs.txt"
set -- $ARMS
if [ "$#" -eq 2 ]; then echo; echo "--- ABBA ---"; leg "$1" 1; leg "$2" 2; leg "$2" 3; leg "$1" 4
else                    echo; echo "--- $1 x2 ---"; leg "$1" 1; leg "$1" 2; fi

echo; echo "=== result ==="
# 🔴 awk, NOT python3: the dolpung nodes are aarch64 with NO modules, and the project's python
# lives in an x86 conda env. The first run produced legs fine and then printed nothing at all.
awk '{a[$1]=(a[$1]==""||$2<a[$1])?$2:a[$1]; n[$1]++}
     END{ for(k in a) printf "  %-5s min=%.4f (%d legs)\n", k, a[k], n[k];
          if (a["base"]!="" && a["best"]!="") printf "  GAIN = %+.2f%%\n", (a["best"]-a["base"])/a["base"]*100;
          printf "DCSV %s,%s,cfg=%s,", MESH, N, CFG; for(k in a) printf "%s=%.4f,", k, a[k]; printf "\n" }' \
     MESH="$POINT" N="$N" CFG="${BASE_KNOBS:-paper}+$WSPLIT_TAG" "$OUT/legs.txt"
