#!/bin/bash
#SBATCH --job-name=m14_ladder
#SBATCH -p compute
#SBATCH -A ab0995
#SBATCH --ntasks-per-node=128
#SBATCH -o /work/ab0995/a270088/port2/m14/ladder.%j.out
#SBATCH -e /work/ab0995/a270088/port2/m14/ladder.%j.err
#
# M14 — one rung of a CPU strong-scaling ladder (plan Task D3).
#
# One job = one mesh at one rank count, running every requested ARM inside ONE allocation on the
# SAME nodes, in ABBA order when there are two. Same-day is not enough: the smallest gains this
# campaign chases (-0.7 % at NG5 CPU) sit under the ~2 % baseline spread, and -C cannot pin node
# identity on `compute`. ABBA makes linear drift over the allocation cancel instead of loading
# onto whichever arm ran first.
#
# 🔴 The FIRST leg of an allocation is systematically slow (measured 2026-08-15 in the null-cost
# pairs: leg 1 was slowest in BOTH jobs, 0.0607 vs 0.0590 at CORE2 512 and 0.0844 vs 0.0831 at
# fArc 2048). A throwaway warmup leg runs first and is DISCARDED.
#
# ARMS:
#   base = the state before these campaigns: no new knob, FESOM_SPEED=1 (M7 is already on main,
#          so its gains belong to "before"), det on.
#   best = base + the per-point lever recipe passed in BEST_KNOBS.
# det is ON IN BOTH ARMS — a correctness fix, not a speed knob, so both arms start from bitwise
# identical initial conditions on every partition. Budget its fill: it is startup, not per-step,
# and the reported number is the model's own per-step timer, never walltime.
#
# Usage:
#   sbatch --nodes=4 --ntasks=512 --time=00:40:00 \
#          --export=ALL,POINT=core2,ARMS=base jobs/job_m14_ladder_cpu
#   sbatch --nodes=16 --ntasks=2048 --time=01:00:00 \
#          --export=ALL,POINT=dars,ARMS="base best",BEST_KNOBS="FESOM_SSH_SOLVER=oati" \
#          jobs/job_m14_ladder_cpu

set -u
ROOT=${M16_ROOT:-/home/a/a270088/port_kokkos_sp}   # M16 E1: scripts + env from the m16 worktree
source /sw/etc/profile.levante
source "$ROOT/env.sh"

N=$SLURM_NTASKS
# MESH= is per POINT *and per rank count* — the tree changes partway up several ladders.
case "${POINT:?POINT required}" in
  core2) DT=1800
         if [ "$N" -le 864 ]; then MESH=/work/ab0995/a270088/port2/mesh/core2          # private (L73)
         else                      MESH=/work/ab0995/a270088/port2/mesh/core2_bigpart; fi ;;
  farc)  DT=900
         if [ "$N" -le 2304 ]; then MESH=/pool/data/AWICM/FESOM2/MESHES_FESOM2.1/farc
         else                       MESH=/work/ab0995/a270088/port2/mesh/farc_bigpart; fi ;;
  dars)  DT=120
         if [ "$N" -le 4096 ]; then MESH=/pool/data/AWICM/FESOM2/MESHES_FESOM2.1/dars
         else                       MESH=/work/ab0995/a270088/port2/mesh/dars_bigpart; fi ;;
  ng5)   DT=180
         if [ "$N" -le 8192 ]; then MESH=/pool/data/AWICM/FESOM2/MESHES_FESOM2.1/ng5
         else                       MESH=/work/ab0995/a270088/port2/mesh/ng5_bigpart; fi ;;
  *) echo "unknown POINT=$POINT"; exit 2 ;;
esac
MESH=${MESH_OVERRIDE:-$MESH}
NSTEPS=${NSTEPS:-300}
ARMS=${ARMS:-base}
BEST_KNOBS=${BEST_KNOBS:-}
PHC=/home/a/a270088/FESOM_port/fesom2/tests/data/INITIAL/phc3.0/phc3.0_winter.nc
BIN=${M14_BIN:-/work/ab0995/a270088/port2/m14/bin/i1}/fesom_port_serial
# ---- M16 Task E1: the precision axis (plan D11) -------------------------------------------
# PREC=dp|sp selects the binary for the M14-style arms (base/best); ARMS="dp sp" makes the PAIR the
# precision itself: (BIN_DP, BIN_SP) at IDENTICAL knobs, ABBA in one allocation, warm-up discarded,
# equal leg counts, min over legs. cfg= stamps prec=. Every leg's banner must match the binary it
# claims (L80/SP10) — scripts/m14_zombie_check.sh enforces it. Pairs come from jobs/m16_bins.sh:
#   M16_BINS=/work/ab0995/a270088/port2/m16/bin/<tag>  ->  $M16_BINS/{dp,sp}/fesom_port_serial
PREC=${PREC:-dp}
case "$PREC" in dp|sp) ;; *) echo "REFUSE: PREC=$PREC is not dp|sp"; exit 2;; esac
if [ -n "${M16_BINS:-}" ]; then BIN_DP=$M16_BINS/dp/fesom_port_serial; BIN_SP=$M16_BINS/sp/fesom_port_serial
else BIN_DP=${M16_BIN_DP:-$BIN}; BIN_SP=${M16_BIN_SP:-}; fi
preflight_bin () {            # preflight_bin <bin> <dp|sp>: refuse a binary whose PROVENANCE says the other precision
    local b=$1 p=$2 prov; prov=$(dirname "$b")/PROVENANCE.txt
    [ -x "$b" ] || { echo "REFUSE: $p binary $b missing"; exit 2; }
    if [ -f "$prov" ] && grep -q 'USE_SINGLE_PRECISION=' "$prov"; then
        local want=OFF; [ "$p" = sp ] && want=ON
        grep -q "USE_SINGLE_PRECISION=$want" "$prov" || { echo "REFUSE: $b is not a $p binary per $prov"; exit 2; }
    elif [ "$p" = sp ]; then echo "REFUSE: $b has no precision PROVENANCE — an sp arm needs a jobs/m16_bins.sh pair"; exit 2; fi
    # (an M14-era binary with no precision key is DP by construction — every M14 build was FP64)
}
want_of () { [ "$1" = sp ] && echo SINGLE || echo DOUBLE; }
bin_of  () { [ "$1" = sp ] && echo "$BIN_SP" || echo "$BIN_DP"; }
case " ${ARMS:-base} " in *" sp "*) preflight_bin "$BIN_SP" sp; preflight_bin "$BIN_DP" dp; BIN=$BIN_DP;; *) preflight_bin "$(bin_of $PREC)" $PREC; BIN=$(bin_of $PREC);; esac
# (BIN is what the discarded warm-up leg runs: the dp binary of the pair — job 27289077 ran the M14 default there and segfaulted)
[ -n "${DRYRUN:-}" ] && { echo "DRYRUN OK: PREC=$PREC ARMS='${ARMS:-base}' BIN_DP=$BIN_DP BIN_SP=${BIN_SP:-}"; exit 0; }

[ -d "$MESH/dist_$N" ] || { echo "REFUSE: $MESH/dist_$N does not exist"; exit 2; }

# snap_every: -1 always for timing runs. Mandatory at >=4096 ranks anyway (ibv_reg_mr gather).
SNAP=-1

OUT=/work/ab0995/a270088/port2/m14/ladder_${POINT}_${N}_${SLURM_JOB_ID}
mkdir -p "$OUT"; : > "$OUT/legs.txt"
echo "=== M14 CPU ladder — $POINT ranks=$N nodes=$SLURM_NNODES dt=$DT steps=$NSTEPS arms='$ARMS' ==="
echo "mesh : $MESH/dist_$N"
echo "nodes: $SLURM_JOB_NODELIST"
md5sum "$BIN"
[ -n "$BEST_KNOBS" ] && echo "best knobs: $BEST_KNOBS"

# 🔴 WSPLIT MUST BE DECLARED — it is not allowed to be silently absent (rule 0.41).
# A cold PHC start at the protocol dt rides a CFL blow-up on the big meshes; the onset step is
# ROUNDOFF-SEEDED (CUDA atomics vs serial order, rank count), so it moves with the backend and the
# rank count and a leg can die anywhere from step 4 to step 291. M5.24 found it, M7 re-confirmed it
# as rule 0.41 ("'dt180 stable' was only ever a 35-step statement"), and the discriminator settled
# the cure: Fortran WITHOUT wsplit dies in the same window (rc=1, NaN after 261 CFLz warnings),
# Fortran WITH wsplit completes. Production practice on large meshes always runs it.
# Every leg of this campaign ran with it OFF and nothing in the log said so, which is why NG5 lost
# its whole GPU arm (7 of 37 legs survived) and it read as a new CG bug. So: declare it, either way.
#   WSPLIT=1  FESOM_WSPLIT=1 on BOTH arms — it is a configuration, not a lever
#   WSPLIT=0  the historical configuration, knowingly unstable on a cold start at protocol dt
# The value is stamped into cfg= so a wsplit-on row can never be compared against a wsplit-off one.
# USER RULE (2026-08-16): "wsplit should be ON on large meshes." So it is the DEFAULT here for
# every mesh but CORE2, and turning it OFF on a large mesh takes an explicit WSPLIT=0. Defaulting
# is the point: this trap has now cost the project three times, and remembering is not a mechanism.
case "${WSPLIT:-${POINT}}" in
    1)               WSPLIT_TAG=wsplit1 ;;
    0)               WSPLIT_TAG=wsplit0 ;;
    core2)           WSPLIT_TAG=wsplit0 ;;   # small mesh, no cold-start CFL class documented
    farc|dars|ng5)   WSPLIT_TAG=wsplit1 ;;   # large meshes -> ON by default
    *) echo "REFUSE: WSPLIT=\"${WSPLIT:-}\" is not 0 or 1 — refusing to guess"; exit 2 ;;
esac
echo "wsplit    : $WSPLIT_TAG${WSPLIT:+ (explicit WSPLIT=$WSPLIT)}"

if [ -n "${BEST_MESH:-}" ]; then
    echo "best mesh : $BEST_MESH/dist_$N   (partition lever)"
    [ -d "$BEST_MESH/dist_$N" ] || { echo "REFUSE: $BEST_MESH/dist_$N does not exist"; exit 2; }
fi

clean_env () {
    unset FESOM_ALE FESOM_MIX_SCHEME FESOM_WHICH_EVP
    for pre in FESOM_SPEED FESOM_SSH FESOM_SE_ FESOM_PCSI FESOM_IC_EXTRAP FESOM_EVPWIDE FESOM_WSPLIT; do
        while read -r v; do unset "$v"; done < <(env | sed -n "s/^\(${pre}[A-Za-z0-9_]*\)=.*/\1/p")
    done
    export FESOM_SPEED=1 FESOM_IC_EXTRAP=det      # both arms
    [ "$WSPLIT_TAG" = wsplit1 ] && export FESOM_WSPLIT=1   # a configuration, both arms
    # BASE_KNOBS applies to BOTH arms. It exists for two reasons, both experimental hygiene:
    #  (1) a lever that REQUIRES a configuration (SE needs FESOM_ALE=zstar, the M9 ice lever needs
    #      FESOM_WHICH_EVP=1) must have that configuration on BOTH sides, or the pair measures the
    #      configuration change and the lever together;
    #  (2) 🔴 on a Serial/CPU build EVERY FESOM_SPEED_* lever resolves to its DEFAULT unless
    #      FESOM_SPEED_FORCE_SERIAL=1 (`src/fesom_speed.hpp:168-170`, "Serial stays legacy").
    #      So FESOM_SPEED=1 above is a NO-OP on CPU, and any CPU pair testing a FESOM_SPEED_*
    #      lever must put FORCE_SERIAL in BASE_KNOBS -- otherwise "best" silently turns on every
    #      M7 lever as well as the one under test.
    for kv in ${BASE_KNOBS:-}; do export "$kv"; done
}

leg () {                       # leg <arm> <index>
    local arm=$1 idx=$2
    local out="$OUT/${idx}_${arm}"
    # BEST_MESH: the PARTITION lever is a different mesh directory, not an env knob, so the best
    # arm may read a different dist_N than the base arm. Both still run in ONE allocation on the
    # SAME nodes in ABBA order, which is what makes the comparison fair.
    local mesh="$MESH"
    [ "$arm" = best ] && [ -n "${BEST_MESH:-}" ] && mesh="$BEST_MESH"
    mkdir -p "$out"
    clean_env
    if [ "$arm" = best ] && [ -n "$BEST_KNOBS" ]; then
        for kv in $BEST_KNOBS; do export "$kv"; done
    fi
    # M16 E1: a dp/sp arm runs its own binary at the SAME knobs; base/best run $BIN (= PREC's binary)
    local bin="$BIN" want; want=$(want_of "$PREC")
    case "$arm" in dp|sp) bin=$(bin_of "$arm"); want=$(want_of "$arm");; esac
    srun "$bin" "$mesh" "$out" "$DT" "$NSTEPS" "$SNAP" "$PHC" 1958 > "$out/run.log" 2> "$out/run.err"
    local rc=$?
    # ZOMBIE CHECK (M10 L106) — ONE implementation for both ladders: scripts/m14_zombie_check.sh
    # (rc, final step line present+finite, it≠0, CGPIPE-INACTIVE, timer, banner == the arm's precision,
    # optional [ssh-verify] bar via SSH_VERIFY_BAR). Its one output line is `t=<s/step> live=yes|no [why]`.
    local zc; zc=$("$ROOT/scripts/m14_zombie_check.sh" "$out/run.log" "$rc" "$want" "${SSH_VERIFY_BAR:-}")
    local t; t=$(echo "$zc" | sed -n 's/^t=\([0-9.]*\).*/\1/p')
    echo "leg $idx $arm ($(basename "$(dirname "$bin")")/$(basename "$bin")): rc=$rc s/step=${t:-NA} ${zc#t=* }"
    if echo "$zc" | grep -q 'live=yes'; then echo "$arm $t" >> "$OUT/legs.txt"
    else echo "  !! leg REJECTED ($zc) — its timing is not admitted"; fi
}

# --- warmup leg, discarded (see header) ---
echo; echo "--- warmup (discarded) ---"
leg warmup 0
: > "$OUT/legs.txt"          # drop whatever the warmup recorded

set -- $ARMS
if [ "$#" -eq 2 ]; then
    echo; echo "--- ABBA: $1 $2 $2 $1 ---"
    leg "$1" 1; leg "$2" 2; leg "$2" 3; leg "$1" 4
else
    echo; echo "--- $1 x2 ---"
    leg "$1" 1; leg "$1" 2
fi

echo; echo "=== result ==="
python3 "$ROOT/scripts/m14_collect.py" "$OUT/legs.txt" "$POINT" "$N" "${BASE_KNOBS:-}" "$WSPLIT_TAG" CSV "$PREC"   # M16 E1: one collector for both ladders; prec= stamped
