#!/bin/bash
#SBATCH --job-name=m7abcpu
#SBATCH -p compute
#SBATCH -A ab0995
#SBATCH --ntasks-per-node=128
#SBATCH --time=00:45:00
#SBATCH -o /work/ab0995/a270088/port2/m7/abcpu.%j.out
#SBATCH -e /work/ab0995/a270088/port2/m7/abcpu.%j.err
#
# M7 same-allocation CPU A/B — the compute-partition twin of jobs/job_m7_ab_env.
#
# WHY THIS EXISTS (2026-07-14, D.0): FESOM_SPEED_ROTCACHE is the campaign's first HOST-side lever,
# so unlike every other M7 knob it can speed the CPU REFERENCE up too — and a lever that improves
# the denominator must never be quoted as if it only improved the numerator. This job measures the
# CPU side of any such lever, and doubles as the same-day CPU anchor for a ratio-ledger row
# (inter-allocation noise is ~5%: never compare a GPU number to a CPU number from another day).
#
# ⚠️ On a non-CUDA build every FESOM_SPEED_* knob resolves to OFF ("Serial stays legacy") unless
# FESOM_SPEED_FORCE_SERIAL=1 is also set. So a CPU leg that wants a lever ON must say BOTH, e.g.
#   LEG2="rot::FESOM_SPEED_FORCE_SERIAL=1;FESOM_SPEED_ROTCACHE=1"
# The lever still announces itself on rank 0 — check the line before believing a null result (L80).
#
# Submit example (NG5@4N CPU == 4 nodes x 128 ranks == dist_512):
#   sbatch -N4 --ntasks=512 --export=ALL,MESH=$NG5,DT=180,TAG=abcpu_rot_ng5_4n,\
#     LEG1="base::",LEG2="rot::FESOM_SPEED_FORCE_SERIAL=1;FESOM_SPEED_ROTCACHE=1" jobs/job_m7_ab_cpu

set -u
ROOT=/home/a/a270088/port_kokkos
source "$ROOT/jobs/m7_provenance.sh"
source /sw/etc/profile.levante
source "$ROOT/env.sh"
ulimit -s 204800
export FESOM_PRINT_EVERY=999

MESH=${MESH:?MESH required}
PHC=/home/a/a270088/FESOM_port/fesom2/tests/data/INITIAL/phc3.0/phc3.0_winter.nc
TAG=${TAG:?TAG required}
OUT=/work/ab0995/a270088/port2/m7/$TAG; rm -rf "$OUT"; mkdir -p "$OUT"
NPES=$SLURM_NTASKS
FESOM=${BIN:-$ROOT/build-m7serial/fesom_port}
m7_provenance "$OUT" "$FESOM"
[ -d "$MESH/dist_$NPES" ] || { echo "ERROR: $MESH/dist_$NPES missing"; exit 2; }

echo "=== M7 CPU A/B  $TAG  mesh=$(basename "$MESH") nodes=$SLURM_NNODES ntasks=$NPES dt=${DT:?DT required} ==="
echo "nodes: $SLURM_JOB_NODELIST"

run_leg() {  # run_leg <label> <envspec>  -> writes $OUT/result_<label>
    local label=$1 spec=$2
    (
        while read -r v; do unset "$v"; done \
            < <(env | sed -n 's/^\(FESOM_SPEED[A-Za-z0-9_]*\)=.*/\1/p')
        if [ -n "$spec" ]; then
            IFS=';' read -ra KV <<< "$spec"
            for kv in "${KV[@]}"; do export "$kv"; echo "    env: $kv"; done
        fi
        for rep in a b; do
            srun "$FESOM" "$MESH" "$OUT" "$DT" "${NSTEPS:-35}" -1 "$PHC" 1958 \
                > "$OUT/log_${label}_${rep}.txt" 2>&1
        done
    )
    local r1 r2
    r1=$(grep 'loop timing' "$OUT/log_${label}_a.txt" | tail -1 | sed -E 's/.*-> +([0-9.]+) s\/step/\1/')
    r2=$(grep 'loop timing' "$OUT/log_${label}_b.txt" | tail -1 | sed -E 's/.*-> +([0-9.]+) s\/step/\1/')
    echo "  $label: ${r1:-FAIL}  ${r2:-FAIL}"
    echo "${r1:-inf} ${r2:-inf}" > "$OUT/result_$label"
}

for i in 1 2 3 4; do
    eval "leg=\${LEG$i:-}"
    [ -z "$leg" ] && continue
    label=${leg%%::*}; envs=${leg#*::}
    echo "--- leg $label ---"
    run_leg "$label" "$envs"
done

echo
echo "########################## CPU A/B RESULT — $TAG ##########################"
ref=""
for i in 1 2 3 4; do
    eval "leg=\${LEG$i:-}"
    [ -z "$leg" ] && continue
    label=${leg%%::*}
    read -r r1 r2 < "$OUT/result_$label"
    m=$(python3 -c "print(min($r1,$r2))" 2>/dev/null || echo inf)
    if [ -z "$ref" ]; then
        ref=$m; printf "  %-10s %s s/step  (reference)\n" "$label" "$m"
    else
        printf "  %-10s %s s/step  (%s%% vs ref)\n" "$label" "$m" \
            "$(python3 -c "print(f'{100*($m-$ref)/$ref:+.2f}')" 2>/dev/null || echo '?')"
    fi
done
echo "  (same allocation, same nodes, same binary — only the env differs; min of 2 reps)"
echo "###########################################################################"
echo
echo "--- L80 announce armor: did the lever actually FIRE on each leg? ---"
grep -H -c 'FESOM_SPEED_ROTCACHE = ON' "$OUT"/log_*_a.txt 2>/dev/null | sed 's#.*/log_#  #'
rm -f "$OUT"/*.monthly.nc 2>/dev/null || true
echo "=== done: $OUT ==="
