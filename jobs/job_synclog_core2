#!/bin/bash
#SBATCH --job-name=kk_synclog
#SBATCH -p gpu
#SBATCH -A ab0995
#SBATCH --nodes=2
#SBATCH --ntasks=8
#SBATCH --ntasks-per-node=4
#SBATCH --gres=gpu:4
#SBATCH --gpu-bind=none
#SBATCH --time=00:20:00
#SBATCH -o /work/ab0995/a270088/port2/kokkos_gpu_runs/synclog_core2.%j.out
#SBATCH -e /work/ab0995/a270088/port2/kokkos_gpu_runs/synclog_core2.%j.err
# TEMP attribution job: run the FESOM_SYNC_LOG-instrumented build-cuda on CORE2 dist_8
# (ice-active, full production config) for a few steps with snapshots OFF (-1), so the
# SYNCLOG stderr lines = the per-step compute DtoH/HtoD only (no I/O sync contamination).
# Aggregate offline: which fields drive the residual per-step PCIe (the 4 GB/step DtoH).
ROOT=/home/a/a270088/port_kokkos
source "$ROOT/env_cuda.sh"
export OMPI_MCA_pml=ucx OMPI_MCA_btl=self UCX_NET_DEVICES=mlx5_0:1
export UCX_MEMTYPE_CACHE=n OMPI_MCA_coll_hcoll_enable=0 OMPI_MCA_io=romio321 HDF5_USE_FILE_LOCKING=FALSE
export FESOM_PRINT_EVERY=999    # suppress per-step diagnostic syncs
MESH=/pool/data/AWICM/FESOM2/MESHES_FESOM2.1/core2
PHC=/home/a/a270088/FESOM_port/fesom2/tests/data/INITIAL/phc3.0/phc3.0_winter.nc
OUT=/work/ab0995/a270088/port2/kokkos_gpu_runs/synclog_core2; rm -rf "$OUT"; mkdir -p "$OUT"
echo "=== SYNCLOG CORE2 dist_8, 8 steps, snap off — $(date) ==="
srun -l "$ROOT/build-cuda/fesom_port" "$MESH" "$OUT" 1800 8 -1 "$PHC" 1958 > "$OUT/run.log" 2> "$OUT/run.err"
echo "rc=$?  SYNCLOG lines: $(grep -c SYNCLOG "$OUT/run.err")"
