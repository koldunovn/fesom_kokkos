#!/bin/bash
# M4.3 ICE per-kernel verify on CORE2 (ice is FORCED-only — no freezing on pi, so the
# FESOM_KK_VERIFY=<icekey> gate is only meaningful here). Short run (120 steps, dist_16,
# 1 node) on the SERIAL build: FESOM_KK_VERIFY=icemap runs the C twin beside each device
# ice kernel every step and asserts max|Δ|==0 on Serial (aborts on the first nonzero).
# Ice exists from step 0 (fesom_ice_initial_state cold-start in polar regions) so cut_off/
# h_diag are exercised non-trivially. Output → /scratch (never $HOME).
#SBATCH --job-name=ice_vfy
#SBATCH -p compute
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=16
#SBATCH --ntasks=16
#SBATCH --time=00:20:00
#SBATCH -A ab0995
#SBATCH -o /scratch/a/a270088/m43a_verify/slurm.%j.out
#SBATCH -e /scratch/a/a270088/m43a_verify/slurm.%j.err

set -u
source /sw/etc/profile.levante
source /home/a/a270088/port_kokkos/env.sh
ulimit -s 204800

MESH=/pool/data/AWICM/FESOM2/MESHES_FESOM2.1/core2          # 16 ranks → reads dist_16
PHC=/home/a/a270088/FESOM_port/fesom2/tests/data/INITIAL/phc3.0/phc3.0_winter.nc
DT=1800
NSTEPS=60
SNAP_EVERY=60
JRA55_YEAR=1958
export FESOM_PRINT_EVERY=20
# All ice device kernels so far: M4.3a maps (icemap) + M4.3b EVP (evp) + M4.3c FCT (icefct).
# The evp/icefct verifies run the whole C EVP (120 subcycles) / C FCT (3 tracers, ~21 halos)
# beside the device kernel each step -> short NSTEPS.
export FESOM_KK_VERIFY=evp,icemap,icefct

BIN=/home/a/a270088/port_kokkos/build-serial/fesom_port
OUT_DIR=/scratch/a/a270088/m43a_verify
mkdir -p "$OUT_DIR"

echo "=== M4.3a ICE verify (icemap) CORE2 dist_16 — $(date) ==="
srun -l "$BIN" "$MESH" "$OUT_DIR" "$DT" "$NSTEPS" "$SNAP_EVERY" "$PHC" "$JRA55_YEAR" \
    > "$OUT_DIR/run.log" 2> "$OUT_DIR/run.err"
EC=$?
echo "=== done $(date) — exit $EC ==="
echo "--- any NONZERO Serial Δ across all keys (a FAIL aborts the run; empty = all bit-identical): ---"
grep "FESOM_KK_VERIFY=" "$OUT_DIR/run.log" 2>/dev/null | grep -v "0.000e+00" | head
echo "--- last icefct lines (confirm ice is non-trivial: a_ice/m_ice/m_snow magnitudes): ---"
grep "FESOM_KK_VERIFY=icefct" "$OUT_DIR/run.log" 2>/dev/null | tail -6
echo "--- last icemap lines (cut_off/h_diag): ---"
grep "FESOM_KK_VERIFY=icemap" "$OUT_DIR/run.log" 2>/dev/null | tail -3
echo "--- run.err tail (FAIL message if aborted): ---"; tail -5 "$OUT_DIR/run.err"
exit $EC
