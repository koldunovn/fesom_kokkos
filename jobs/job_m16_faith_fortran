#!/bin/bash
#SBATCH --job-name=m16_faith_f
#SBATCH -p compute
#SBATCH -A ab0995
#SBATCH -N 1
#SBATCH --ntasks-per-node=64
#SBATCH -t 00:40:00
#SBATCH -o /work/ab0995/a270088/port2/m16/faith/faith_f.%j.out
#SBATCH -e /work/ab0995/a270088/port2/m16/faith/faith_f.%j.err
#
# M16 Gate 4 — the FORTRAN arms of the faithfulness matrix (oracle @ a62f180, both precisions).
#
#   sbatch --export=ALL,ARMS="fdp fsp",RUNROOT=/work/.../faith/pilot_1m jobs/job_m16_faith_fortran
#
# One arm = one directory built by scripts/m16_faith_setup.sh (which documents the four deliberate
# deviations from upstream's setups/test_core2). Arm name prefix picks the binary: f*p reads its
# precision from the 2nd character — fdp -> oracle/dp, fsp -> oracle/sp; anything else defaults to
# dp (the noise twins fdp_s<seed> are FP64 by construction: the noise envelope is an FP64 property).
#
# 64 ranks on 1 node is upstream's own PR-940 benchmark posture (oracle/dp/PROVENANCE.txt).
# 🔴 Never on the login node (standing rule).
set -u
SRC=/home/a/a270088/port_kokkos_sp
ORACLE=/work/ab0995/a270088/port2/m16/oracle
RUNROOT=${RUNROOT:?set RUNROOT}
ARMS=${ARMS:?set ARMS}

source /sw/etc/profile.levante >/dev/null 2>&1 || true
# The oracle was built with `source env.sh levante.dkrz.de+intel` in ~/fesom2_sp; reuse exactly that
# environment. env.sh dies under `set -u` on an unbound LD_LIBRARY_PATH (day-4 rule), so relax first.
set +u
export LD_LIBRARY_PATH=${LD_LIBRARY_PATH:-}
cd /home/a/a270088/fesom2_sp && source env.sh levante.dkrz.de+intel >/dev/null 2>&1
set -u
export HDF5_USE_FILE_LOCKING=FALSE
ulimit -s 204800

echo "=== M16 faithfulness — Fortran arms ==="
echo "runroot : $RUNROOT"
echo "arms    : $ARMS"
echo "ranks   : ${SLURM_NTASKS:-?} on ${SLURM_NNODES:-?} node(s)  [$(hostname)]"
echo

for arm in $ARMS; do
    dir="$RUNROOT/$arm"
    [ -d "$dir" ] || { echo "!! $arm: no run dir $dir — skipped"; continue; }
    case "$arm" in
        ?sp*) prec=sp ;;
        *)    prec=dp ;;
    esac
    # ORACLE_VARIANT=_instr selects the §3o instrumented build (dumps the raw antidiffusive
    # vertical flux when FESOM_FCT_TRACE is set). The validated oracle is left untouched.
    BIN="$ORACLE/$prec${ORACLE_VARIANT:-}/bin/fesom.x"
    [ -x "$BIN" ] || { echo "!! $arm: no binary $BIN"; continue; }

    if [ "${FCTTRACE:-0}" = 1 ]; then
        mkdir -p "$dir/fct"; export FESOM_FCT_TRACE="$dir/fct"
    fi
    # DYNTRACE=1 (§4m): density/hpressure, d_eta/ssh_rhs, hbar, w at matched points of the dynamics
    if [ "${DYNTRACE:-0}" = 1 ]; then
        mkdir -p "$dir"/dyn; export FESOM_DYN_TRACE="$dir"/dyn
        [ -n "${DYNTRACE_STEP:-}"  ] && export FESOM_DYN_TRACE_STEP="$DYNTRACE_STEP"
        [ -n "${DYNTRACE_EVERY:-}" ] && export FESOM_DYN_TRACE_EVERY="$DYNTRACE_EVERY"
    fi
    # FLUXTRACE=1 (§4j): the surface forcing the ocean consumes, after oce_fluxes (needs ORACLE_VARIANT=_instr)
    if [ "${FLUXTRACE:-0}" = 1 ]; then
        mkdir -p "$dir"/flux; export FESOM_FLUX_TRACE="$dir"/flux
        [ -n "${FLUXTRACE_STEP:-}"  ] && export FESOM_FLUX_TRACE_STEP="$FLUXTRACE_STEP"
        [ -n "${FLUXTRACE_EVERY:-}" ] && export FESOM_FLUX_TRACE_EVERY="$FLUXTRACE_EVERY"
    fi
    # SALTTRACE=1 (§4i): ocean tracer stage trace, needs ORACLE_VARIANT=_instr
    if [ "${SALTTRACE:-0}" = 1 ]; then
        mkdir -p "$dir/strace"; export FESOM_SALT_TRACE="$dir/strace"
        [ -n "${SALTTRACE_STEP:-}"  ] && export FESOM_SALT_TRACE_STEP="$SALTTRACE_STEP"
        [ -n "${SALTTRACE_EVERY:-}" ] && export FESOM_SALT_TRACE_EVERY="$SALTTRACE_EVERY"
    fi
    # ICETRACE=1 (§4g): needs ORACLE_VARIANT=_instr; same knobs as the port job
    if [ "${ICETRACE:-0}" = 1 ]; then
        mkdir -p "$dir/ice"; export FESOM_ICE_TRACE="$dir/ice"
        [ -n "${ICETRACE_STEPS:-}" ] && export FESOM_ICE_TRACE_STEPS="$ICETRACE_STEPS"
        [ -n "${ICETRACE_SUBS:-}"  ] && export FESOM_ICE_TRACE_SUBS="$ICETRACE_SUBS"
        [ -n "${ICETRACE_EVERY:-}" ] && export FESOM_ICE_TRACE_EVERY="$ICETRACE_EVERY"
    fi
    echo "--- $arm (oracle/$prec${ORACLE_VARIANT:-}, md5 $(md5sum "$BIN" | cut -c1-32)) ---"
    t0=$SECONDS
    ( cd "$dir" && srun -l --ntasks="${SLURM_NTASKS}" "$BIN" ) \
        > "$dir/run.log" 2> "$dir/run.err"
    rc=$?
    dt=$((SECONDS - t0))
    echo "rc=$rc  wall=${dt}s"
    # The one hard precision fact the harness gives us: an SP build announces itself (upstream makes
    # this banner a mandatory ctest marker), so it proves the arm really ran the precision claimed.
    if grep -qi "SINGLE PRECISION MODE" "$dir/run.log" 2>/dev/null; then
        echo "banner  : SINGLE PRECISION MODE  (arm is genuinely SP)"
    else
        echo "banner  : none (double precision)"
    fi
    # L80: verify a knob FIRED before believing a null. A noise arm whose &oce_perturb block was
    # silently not read would be a bit-identical copy of the unperturbed arm, and the envelope it
    # produced would be exactly zero — which reads as "SP is above the envelope" for every variable.
    if grep -q "lperturb *= *\.true\." "$dir/namelist.oce" 2>/dev/null; then
        if grep -q "PERTURBATION TRIGGER" "$dir/run.log" 2>/dev/null; then
            echo "perturb : FIRED  ($(grep -m1 'Mode:' "$dir/run.log" | sed 's/^ *//'))"
        else
            echo "perturb : !! REQUESTED BUT DID NOT FIRE — this arm is not a noise twin"
        fi
    fi
    grep -ciE "nan|infinity" "$dir/run.log" 2>/dev/null | sed 's/^/nan-ish log lines: /'
    ls "$dir/output"/*.nc 2>/dev/null | sed 's|.*/|  out: |'
    tail -3 "$dir/run.err" 2>/dev/null | sed 's/^/  err: /'
    echo
done
echo "=== done ==="
