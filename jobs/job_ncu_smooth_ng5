#!/bin/bash
#SBATCH --job-name=kk_ncu_smooth
#SBATCH -p gpu
#SBATCH -A ab0995
#SBATCH --nodes=4
#SBATCH --ntasks=16
#SBATCH --ntasks-per-node=4
#SBATCH --gres=gpu:4
#SBATCH --gpu-bind=none
#SBATCH --time=01:00:00
#SBATCH -o /work/ab0995/a270088/port2/kokkos_gpu_runs/ncu_smooth.%j.out
#SBATCH -e /work/ab0995/a270088/port2/kokkos_gpu_runs/ncu_smooth.%j.err
# M5.18 baseline — ncu --set basic on the #1 kernel `fesom_smooth_nod3D_kk` (gather+scale), NG5
# dist_16 (462k nod2D/rank, production regime), rank 0 only. Confirms the hypothesis from the code
# read: uncoalesced node-major gather (idx*NL+nz stride) => Memory-SOL-bound, low coalescing,
# warp divergence from per-node depth. Skips spin-up; profiles ~3 steps of steady-state smoother.
ROOT=/home/a/a270088/port_kokkos
source "$ROOT/env_cuda.sh"
export OMPI_MCA_pml=ucx OMPI_MCA_btl=self UCX_NET_DEVICES=mlx5_0:1
export UCX_MEMTYPE_CACHE=n OMPI_MCA_coll_hcoll_enable=0 OMPI_MCA_io=romio321 HDF5_USE_FILE_LOCKING=FALSE
MESH=/pool/data/AWICM/FESOM2/MESHES_FESOM2.1/ng5
PHC=/home/a/a270088/FESOM_port/fesom2/tests/data/INITIAL/phc3.0/phc3.0_winter.nc
OUT=/work/ab0995/a270088/port2/kokkos_gpu_runs/ncu_smooth; rm -rf "$OUT"; mkdir -p "$OUT"
export FESOM="$ROOT/build-cuda/fesom_port"
export NCU_OUT="$OUT/ng5_smooth"
export NCU_REGEX='fesom_smooth_nod3D'   # matches BOTH gather + scale lambdas (enclosing fn name)
export NCU_SKIP=40    # 8 smoother kernels/step x ~5 steps spin-up
export NCU_COUNT=24   # ~3 steps of gather+scale steady-state
echo "=== ncu NG5 dist_16 (rank0) smoother baseline, 16 ranks/4 nodes, dt=180, 10 steps ==="
srun "$ROOT/jobs/ncu_rank0.sh" "$MESH" "$OUT" 180 10 -1 "$PHC" 1958 > "$OUT/run.log" 2>&1
echo "srun rc=$?"
ncu -i "$NCU_OUT.ncu-rep" --page details > "$OUT/details.txt" 2>&1 && echo "details.txt: $(wc -l < "$OUT/details.txt") lines"
ncu -i "$NCU_OUT.ncu-rep" --csv --page raw \
    --metrics gpu__time_duration.sum,sm__throughput.avg.pct_of_peak_sustained_elapsed,gpu__compute_memory_throughput.avg.pct_of_peak_sustained_elapsed,sm__warps_active.avg.pct_of_peak_sustained_active,dram__throughput.avg.pct_of_peak_sustained_elapsed,l1tex__average_t_sectors_per_request_pipe_lsu_mem_global_op_ld.ratio,l1tex__average_t_sectors_per_request_pipe_lsu_mem_global_op_st.ratio \
    > "$OUT/sol.csv" 2>&1 && echo "sol.csv: $(wc -l < "$OUT/sol.csv") rows"
echo "=== key rows (Compute% Memory% Occupancy% DRAM% sectors/req) ==="
grep -iE "Duration|Compute \(SM|Memory \[%|Achieved Occup|sector|DRAM|Throughput" "$OUT/details.txt" | head -40
echo "=== done ==="
