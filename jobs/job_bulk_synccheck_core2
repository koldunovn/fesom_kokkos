#!/bin/bash
# M5.16 SYNCCHECK on CORE2 (build-synccheck = Serial backend + -DFESOM_KK_SYNCCHECK). The auth-state
# tracking is backend-independent, so a h_checked() host read of a DEVICE-authoritative un-synced field
# aborts even on Serial — this is the logical guard for the M5.16 residency unlock (removed T/uvnode
# sync_host) + the bulk device writes. JRA55 active so fesom_bulk_compute_kk actually runs. ⚠️ raw .h()
# reads BYPASS the check (the host stress element-interp), so this complements (not replaces) the gate.
# Output → /scratch (never $HOME).
#SBATCH --job-name=bulk_sc
#SBATCH -p compute
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=16
#SBATCH --ntasks=16
#SBATCH --time=00:20:00
#SBATCH -A ab0995
#SBATCH -o /scratch/a/a270088/m516_bulk_synccheck/slurm.%j.out
#SBATCH -e /scratch/a/a270088/m516_bulk_synccheck/slurm.%j.err

set -u
source /sw/etc/profile.levante
source /home/a/a270088/port_kokkos/env.sh
ulimit -s 204800

MESH=/pool/data/AWICM/FESOM2/MESHES_FESOM2.1/core2          # 16 ranks → dist_16
PHC=/home/a/a270088/FESOM_port/fesom2/tests/data/INITIAL/phc3.0/phc3.0_winter.nc
DT=1800
NSTEPS=20
SNAP_EVERY=20
JRA55_YEAR=1958
export FESOM_PRINT_EVERY=10

BIN=/home/a/a270088/port_kokkos/build-synccheck/fesom_port
OUT_DIR=/scratch/a/a270088/m516_bulk_synccheck
mkdir -p "$OUT_DIR"

echo "=== M5.16 SYNCCHECK CORE2 dist_16 — $(date) ==="
srun -l "$BIN" "$MESH" "$OUT_DIR" "$DT" "$NSTEPS" "$SNAP_EVERY" "$PHC" "$JRA55_YEAR" \
    > "$OUT_DIR/run.log" 2> "$OUT_DIR/run.err"
EC=$?
echo "=== done $(date) — exit $EC ==="
echo "--- SYNCCHECK abort? (any line = a stale-host read; empty + exit 0 = clean): ---"
grep -i "SYNCCHECK\|host read while DEVICE" "$OUT_DIR/run.err" "$OUT_DIR/run.log" 2>/dev/null | head
echo "--- last heartbeat (did it reach NSTEPS?): ---"; grep "done —" "$OUT_DIR/run.err" 2>/dev/null | tail -3
exit $EC
