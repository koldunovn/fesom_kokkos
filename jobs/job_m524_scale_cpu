#!/bin/bash
#SBATCH --job-name=m524sc
#SBATCH -p compute
#SBATCH -A ab0995
#SBATCH --ntasks-per-node=128
#SBATCH --time=00:45:00
#SBATCH -o /work/ab0995/a270088/port2/kokkos_gpu_runs/m524s.%j.out
#SBATCH -e /work/ab0995/a270088/port2/kokkos_gpu_runs/m524s.%j.err
#
# M5.24 CPU strong-scaling (Kokkos Serial, 128 ranks/node = pure MPI), mesh-parametrized.
# env: MESH (full path), DT, NSTEPS (35), TAG. dist_$NTASKS. Internal loop timer; 2 reps; snap -1.
# build-serial = M5.24 (bit-identical to CUDA; the apples-to-apples CPU twin).
ROOT=/home/a/a270088/port_kokkos
source /sw/etc/profile.levante
source "$ROOT/env.sh"
ulimit -s 204800
export FESOM_PRINT_EVERY=999
MESH=${MESH:?MESH required}
PHC=/home/a/a270088/FESOM_port/fesom2/tests/data/INITIAL/phc3.0/phc3.0_winter.nc
OUT=/work/ab0995/a270088/port2/kokkos_gpu_runs/${TAG:?TAG required}; rm -rf "$OUT"; mkdir -p "$OUT"
NPES=$SLURM_NTASKS
[ -d "$MESH/dist_$NPES" ] || { echo "ERROR: $MESH/dist_$NPES missing"; exit 2; }
run(){ srun "$ROOT/build-serial/fesom_port" "$MESH" "$OUT" "${DT:?DT required}" "${NSTEPS:-35}" -1 "$PHC" 1958 \
        > "$OUT/log_$1.txt" 2>&1
  printf "%-8s rc=%s  %s\n" "$1" "$?" "$(grep 'loop timing' "$OUT/log_$1.txt" | tail -1)"; }
echo "=== CPU $TAG mesh=$(basename $MESH) nodes=$SLURM_NNODES ntasks=$NPES (dist_$NPES) dt=$DT nsteps=${NSTEPS:-35} ==="
run rep_a; run rep_b
echo "--- CG iters + T/S sanity (rep_a, last step) ---"; grep -E "it=" "$OUT/log_rep_a.txt" | tail -1
