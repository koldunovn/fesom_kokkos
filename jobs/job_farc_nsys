#!/bin/bash
#SBATCH --job-name=kk_farc_nsys
#SBATCH -p gpu
#SBATCH -A ab0995
#SBATCH --ntasks-per-node=4
#SBATCH --gres=gpu:4
#SBATCH --gpu-bind=none
#SBATCH --time=00:30:00
#SBATCH -o /work/ab0995/a270088/port2/kokkos_gpu_runs/farcnsys.%j.out
#SBATCH -e /work/ab0995/a270088/port2/kokkos_gpu_runs/farcnsys.%j.err
# M5.22-comm: nsys MPI+CUDA trace on FARC (comm-bound proxy) rank 0 → the MESSAGE PROFILE:
# MPI_Isend/Irecv/Waitall/Allreduce COUNTS + sizes (latency-vs-bandwidth question), the
# per-call breakdown, and the compute/PCIe/MPI budget at ~115k 2D-pts/rank. nodes/ntasks via CLI.
ROOT=/home/a/a270088/port_kokkos
source "$ROOT/env_cuda.sh"
export OMPI_MCA_pml=ucx OMPI_MCA_btl=self UCX_NET_DEVICES=mlx5_0:1
export UCX_MEMTYPE_CACHE=n OMPI_MCA_coll_hcoll_enable=0 OMPI_MCA_io=romio321 HDF5_USE_FILE_LOCKING=FALSE
export FESOM_PRINT_EVERY=999
MESH=/pool/data/AWICM/FESOM2/MESHES_FESOM2.1/farc
PHC=/home/a/a270088/FESOM_port/fesom2/tests/data/INITIAL/phc3.0/phc3.0_winter.nc
NPES=$SLURM_NTASKS
OUT=/work/ab0995/a270088/port2/kokkos_gpu_runs/farc_nsys_n${SLURM_NNODES}; rm -rf "$OUT"; mkdir -p "$OUT"
cat > "$OUT/wrap.sh" <<'WRAP'
#!/bin/bash
F=/home/a/a270088/port_kokkos/build-cuda/fesom_port
if [ "${SLURM_PROCID:-0}" = "0" ]; then
  exec nsys profile -t cuda,mpi,nvtx -o "$NSYS_OUT" --force-overwrite=true \
       --capture-range=none --sample=none "$F" "$@"
else exec "$F" "$@"; fi
WRAP
chmod +x "$OUT/wrap.sh"
export NSYS_OUT="$OUT/farc"
echo "=== nsys FARC dist_$NPES (${SLURM_NNODES}N, ~$((638387/NPES/1000))k 2D-pts/rank) rank0, ${NSTEPS:-35} steps ==="
srun "$OUT/wrap.sh" "$MESH" "$OUT" "${DT:-900}" "${NSTEPS:-35}" -1 "$PHC" 1958 > "$OUT/run.log" 2>&1
echo "rc=$?"
nsys stats --report cuda_gpu_kern_sum,cuda_gpu_mem_time_sum,cuda_api_sum,mpi_event_sum --format column "$NSYS_OUT.nsys-rep" > "$OUT/stats.txt" 2>&1
echo "wrote stats.txt"; rm -f "$OUT"/*.monthly.nc 2>/dev/null || true
