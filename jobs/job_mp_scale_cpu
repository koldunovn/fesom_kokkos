#!/bin/bash
#SBATCH --job-name=mp_scale_cpu
#SBATCH -p compute
#SBATCH -A ab0995
#SBATCH --ntasks-per-node=128
#SBATCH --time=00:45:00
#SBATCH -o /work/ab0995/a270088/port2/mp/slurm.%j.out
#SBATCH -e /work/ab0995/a270088/port2/mp/slurm.%j.err
# M8 SP-scaling CPU leg, MESH-parametrized (dars/NG5/farc...). BIN-pinned; house shape:
# 300 steps, min-of-2 reps, no snapshots, knobs-off. Per-mesh dt = SCALING-REMEASURE
# protocol (NG5 180, c32n dt60 per s15 adoption; dars 120). Required --export:
# BIN, TAG, MESH, DT. Optional NSTEPS (300). Epilogue: rc + banner + last diag (SP3).
ROOT=/home/a/a270088/port_kokkos_mp
source /sw/etc/profile.levante
source "$ROOT/env.sh"
ulimit -s 204800
PHC=/home/a/a270088/FESOM_port/fesom2/tests/data/INITIAL/phc3.0/phc3.0_winter.nc
: "${BIN:?pin BIN}"; : "${TAG:?TAG required}"; : "${MESH:?MESH required}"; : "${DT:?DT required}"
OUT=/work/ab0995/a270088/port2/mp/gate2/$TAG
rm -rf "$OUT"; mkdir -p "$OUT"
export FESOM_PRINT_EVERY=999
NPES=$SLURM_NTASKS
[ -d "$MESH/dist_$NPES" ] || { echo "ERROR: $MESH/dist_$NPES missing"; exit 2; }
run() {
  # SNAP=-1 kills snapshots INCLUDING the step-0 initial write (fesom_main:1051) — its
  # rank-0 gather_elem dies in UCX ibv_reg_mr at NG5 x 4096 ranks (s4). 999999 kept as
  # default for continuity with the banked fleet (timed loop excludes the init write).
  srun "$BIN" "$MESH" "$OUT" "$DT" "${NSTEPS:-300}" "${SNAP:-999999}" "$PHC" 1958 \
       > "$OUT/log_$1.txt" 2>&1
  printf "%-8s rc=%s  %s\n" "$1" "$?" "$(grep 'loop timing' "$OUT/log_$1.txt" | tail -1)"
}
echo "=== mp scale CPU $TAG mesh=$(basename $MESH) nodes=$SLURM_NNODES ntasks=$NPES dt=$DT nsteps=${NSTEPS:-300} bin=$BIN ==="
sha256sum "$BIN" | cut -c1-8
run rep_a
run rep_b
grep -m1 "PRECISION" "$OUT/log_rep_a.txt" || echo "WARNING: no precision banner"
grep -E "it=" "$OUT/log_rep_a.txt" | tail -1
grep -qiE "FATAL|BLOWUP" "$OUT/log_rep_a.txt" "$OUT/log_rep_b.txt" && echo "WARNING: FATAL/BLOWUP present"
exit 0
