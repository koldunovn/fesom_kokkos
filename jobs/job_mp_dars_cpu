#!/bin/bash
#SBATCH --job-name=mp_dars_cpu
#SBATCH -p compute
#SBATCH -A ab0995
#SBATCH --ntasks-per-node=128
#SBATCH --time=00:45:00
#SBATCH -o /work/ab0995/a270088/port2/mp/slurm.%j.out
#SBATCH -e /work/ab0995/a270088/port2/mp/slurm.%j.err
# M8 Gate-2 prize-sizing CPU leg on dars (3.16M nodes). BIN-pinned (house rule), house
# measurement shape: dt120 (the certified dars dt), 300 steps, min-of-2 reps, no snapshots.
# Required --export: BIN, TAG. Optional: DT (120), NSTEPS (300).
ROOT=/home/a/a270088/port_kokkos_mp
source /sw/etc/profile.levante
source "$ROOT/env.sh"
ulimit -s 204800
MESH=/pool/data/AWICM/FESOM2/MESHES_FESOM2.1/dars
PHC=/home/a/a270088/FESOM_port/fesom2/tests/data/INITIAL/phc3.0/phc3.0_winter.nc
: "${BIN:?pin BIN}"; : "${TAG:?TAG required}"
OUT=/work/ab0995/a270088/port2/mp/gate2/$TAG
rm -rf "$OUT"; mkdir -p "$OUT"
export FESOM_PRINT_EVERY=999
NPES=$SLURM_NTASKS
[ -d "$MESH/dist_$NPES" ] || { echo "ERROR: $MESH/dist_$NPES missing"; exit 2; }
run() {
  srun "$BIN" "$MESH" "$OUT" "${DT:-120}" "${NSTEPS:-300}" 999999 "$PHC" 1958 \
       > "$OUT/log_$1.txt" 2>&1
  printf "%-8s rc=%s  %s\n" "$1" "$?" "$(grep 'loop timing' "$OUT/log_$1.txt" | tail -1)"
}
echo "=== mp dars CPU $TAG nodes=$SLURM_NNODES ntasks=$NPES dt=${DT:-120} nsteps=${NSTEPS:-300} bin=$BIN ==="
grep -m1 . <<< "$(sha256sum "$BIN" | cut -c1-8)"
run rep_a
run rep_b
grep -m1 "PRECISION" "$OUT/log_rep_a.txt"
grep -E "it=" "$OUT/log_rep_a.txt" | tail -1
