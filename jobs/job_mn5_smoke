#!/bin/bash
# job_mn5_smoke — MN5 ACC smoke test (2 nodes, 8 ranks, 8 H100 GPUs).
#
# Mirrors job_core2_8_lumi (LUMI) in shape: short run with CORE2 mesh + JRA55
# forcing + PHC IC. MN5 has 4 H100/node, and the smallest CORE2 partition on
# MN5 is dist_8 → 8 ranks → 2 nodes (1 rank per GPU).
#
# MN5 specifics vs LUMI/Levante:
#   * `mpirun --bind-to none`, NOT `srun` — HPC-X (bundled with nvhpc) has no
#     srun integration. Module banner: "NVPCX uses its own implementation of
#     MPI that does not offer srun support."
#   * `export SLURM_CPU_BIND=none` — same banner.
#   * No GTL libs to layer in; HPC-X is built --with-cuda + UCX cuda_copy/ipc.
#
# Submit from: /gpfs/projects/ehpc01/sbeyer/fesom_kokkos
#   sbatch jobs/job_mn5_smoke

#SBATCH --job-name=fesom_mn5_8
#SBATCH --account=ehpc01
#SBATCH --qos=acc_debug
#SBATCH --partition=acc
#SBATCH --nodes=2
#SBATCH --ntasks=8
#SBATCH --ntasks-per-node=4
#SBATCH --cpus-per-task=20
#SBATCH --gres=gpu:4
#SBATCH --time=00:30:00
#SBATCH --output=jobs/mn5_logs/slurm-%x.%j.out
#SBATCH --error=jobs/mn5_logs/slurm-%x.%j.err

set -euo pipefail

mkdir -p jobs/mn5_logs

# Per-job output dir under group scratch (kept per-jobid to avoid clobber).
STAMP=$(date +%Y%m%d_%H%M%S)
OUT_DIR=/gpfs/scratch/ehpc01/sbeyer/fesom_runs/core2_8_mn5_${SLURM_JOB_ID:-$STAMP}
mkdir -p "$OUT_DIR"

# Toolchain + runtime LD path (same modules as the build).
source /gpfs/projects/ehpc01/sbeyer/fesom_kokkos/env_mn5.sh

# Required by HPC-X (NVHPC banner — see module load WARNING).
export SLURM_CPU_BIND=none

BIN=/gpfs/projects/ehpc01/sbeyer/fesom_kokkos/build-cuda-mn5/fesom_port
MESH=/gpfs/scratch/ehpc01/sbeyer/inproot/fesom/v21/CORE2
PHC=/gpfs/scratch/ehpc01/sbeyer/inproot/fesom/v21/hydrography/phc3.0/phc3.0_winter.nc

# Forcing/IC env-var overrides (introduced for the LUMI port; same semantics).
export FESOM_JRA55_DIR=/gpfs/scratch/ehpc01/sbeyer/fesom_forcing/JRA5
export FESOM_SSS_PATH=/gpfs/scratch/ehpc01/sbeyer/inproot/fesom/v21/forcing/CORE2/PHC2_salx.nc
# CORE2_runoff.nc + Sweeney_2005.nc are not on MN5 — skip both:
#   empty FESOM_RUNOFF_PATH → reader skips the dataset (project_lumi_data_format).
#   FESOM_CHL_SOURCE=None   → constant chlorophyll fallback.
export FESOM_RUNOFF_PATH=""
export FESOM_CHL_SOURCE=None

DT=500
NSTEPS=200
SNAP_EVERY=50
JRA55_YEAR=1958
export FESOM_PRINT_EVERY=50

date
# HPC-X mpirun: --bind-to none so SLURM_CPU_BIND=none + nvhpc's mpirun cooperate.
# Kokkos picks device = node-local rank (0..3) → each rank gets its own H100.
mpirun --bind-to none -np "$SLURM_NTASKS" \
    "$BIN" "$MESH" "$OUT_DIR" "$DT" "$NSTEPS" "$SNAP_EVERY" "$PHC" "$JRA55_YEAR" \
    > "$OUT_DIR/run.log" 2> "$OUT_DIR/run.err"
EXITCODE=$?
date

echo "Exit code: $EXITCODE"
echo "Run dir:   $OUT_DIR"
echo "Contents:"
ls -la "$OUT_DIR"
echo "Tail of run.log:"
tail -40 "$OUT_DIR/run.log"
exit $EXITCODE
