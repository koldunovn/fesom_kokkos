#!/bin/bash
#SBATCH --job-name=m6_zstar_bitid
#SBATCH -p compute
#SBATCH -A ab0995
#SBATCH --nodes=1
#SBATCH --ntasks=8
#SBATCH --ntasks-per-node=8
#SBATCH --time=00:30:00
#SBATCH -o /work/ab0995/a270088/port2/m6/zstarbitid.%j.out
#SBATCH -e /work/ab0995/a270088/port2/m6/zstarbitid.%j.err
#
# M6.3 Task 3.7 — KNOB-ON SERIAL BIT-ID vs the C oracle, at the ZSTAR config.
#
# Paired runs, same node, same private mesh, same CLI, FESOM_WHICH_EVP=1 on both:
#   A) C oracle       fesom2_port_zstar @ df8b9a8   (build-m6oracle, certified Task 0.1)
#   B) Kokkos-Serial  port_kokkos @ HEAD
# diff_snap.py must report ALL FIELDS BIT-IDENTICAL.
#
# On mismatch: the mEVP element->node atomic scatters are element-ORDER on Serial, so they are
# deterministic and the C loop order is reproduced exactly -- a diff therefore means a real
# transcription error, most likely in the 13-point trap list (see src/fesom_ice_maevp.h).
# Bisect against /work/ab0995/a270088/port/mevp/cdump_16r (the C's per-substep dumps).
#
# L18: CMA off on both legs (cross-build MPI_Gatherv determinism).

set -u
C_REPO=/home/a/a270088/port2/fesom2_port_zstar
K_REPO=/home/a/a270088/port_kokkos
C_BIN=$C_REPO/build-m6oracle/fesom_port
K_BIN=$K_REPO/build-serial/fesom_port

MESH=/work/ab0995/a270088/port2/mesh/core2      # the M6 private mesh -- NOT /pool
PHC=/home/a/a270088/FESOM_port/fesom2/tests/data/INITIAL/phc3.0/phc3.0_winter.nc
DT=1800; NSTEPS=20; SNAP=10; YEAR=1958

BASE=/work/ab0995/a270088/port2/m6/zstar_bitid
OUT_C=$BASE/c_zstar; OUT_K=$BASE/kk_zstar
rm -rf "$OUT_C" "$OUT_K"; mkdir -p "$OUT_C" "$OUT_K"

export FESOM_ALE=zstar                          # <-- THE KNOB
unset FESOM_MIX_SCHEME FESOM_WHICH_EVP FESOM_ALE_DUMP_DIR

echo "=============== LEG A: C oracle, FESOM_ALE=zstar ==============="
source /sw/etc/profile.levante
source "$C_REPO/env.sh"
export OMPI_MCA_btl_vader_single_copy_mechanism=none    # L18
ulimit -s 204800
( cd "$C_REPO" && git rev-parse HEAD ) > "$OUT_C/SHA.txt"
srun -l "$C_BIN" "$MESH" "$OUT_C" $DT $NSTEPS $SNAP "$PHC" $YEAR > "$OUT_C/run.log" 2> "$OUT_C/run.err"
echo "leg A exit: $?"; tail -2 "$OUT_C/run.log"

echo
echo "=============== LEG B: Kokkos-Serial, FESOM_ALE=zstar ==============="
source "$K_REPO/env.sh"
export OMPI_MCA_btl_vader_single_copy_mechanism=none    # L18
( cd "$K_REPO" && git rev-parse HEAD ) > "$OUT_K/SHA.txt"
srun -l "$K_BIN" "$MESH" "$OUT_K" $DT $NSTEPS $SNAP "$PHC" $YEAR > "$OUT_K/run.log" 2> "$OUT_K/run.err"
echo "leg B exit: $?"; tail -2 "$OUT_K/run.log"

echo
echo "=========== GATE: C oracle vs Kokkos-Serial, both at zstar ==========="
PY=/work/ab0995/a270088/mambaforge/envs/nereus/bin/python
"$PY" "$K_REPO/scripts/diff_snap.py" "$OUT_C" "$OUT_K"
RC=$?
echo "diff_snap rc=$RC"
if [ "$RC" -eq 0 ]; then
    echo "=== M6.3 KNOB-ON SERIAL BIT-ID PASS — the zstar port reproduces the C oracle ==="
else
    echo "=== M6.3 KNOB-ON SERIAL BIT-ID FAIL — bisect phase-by-phase down the Z-ladder (geometry -> forcing -> SSH -> vert_vel -> PGF) ==="
fi
exit $RC
