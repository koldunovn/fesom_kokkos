#!/bin/bash
# job_ng5_test_lumi — first NG5 (~3.16M ocean nodes) test on LUMI-G.
#
# The smallest available partition under inproot/fesom/v21/NG5/ is dist_16, so
# the minimum LUMI shape is 2 nodes × 8 GCDs = 16 ranks. Parameters mirror the
# Levante job_ng5_scaling_gpu single-rep run: dt=180 s (CFL-constrained at this
# resolution), 35 steps (5 warmup excluded → 30 measured), no snapshots.

#SBATCH --job-name=kk_ng5_test_lumi
#SBATCH --account=project_465002727
#SBATCH --partition=dev-g
#SBATCH --nodes=2
#SBATCH --ntasks=16
#SBATCH --ntasks-per-node=8
#SBATCH --gpus-per-node=8
#SBATCH --cpus-per-task=7
#SBATCH --mem=0
#SBATCH --time=00:30:00
#SBATCH --output=jobs/lumi_logs/%x-%j.out
#SBATCH --error=jobs/lumi_logs/%x-%j.err

set -euo pipefail
mkdir -p jobs/lumi_logs

ROOT=/pfs/lustrep4/projappl/project_465002727/sbeyer/fesom_kokkos
source "$ROOT/env_lumi.sh"

export MPICH_GPU_SUPPORT_ENABLED=1
export FESOM_PRINT_EVERY=999

MESH=/pfs/lustrep4/projappl/project_465002727/sbeyer/inproot/fesom/v21/NG5
PHC=/pfs/lustrep4/projappl/project_465002727/sbeyer/inproot/fesom/v21/hydrography/phc3.0/phc3.0_winter.nc

export FESOM_JRA55_DIR=/pfs/lustrep4/projappl/project_465002727/sbeyer/fesom_forcing/JRA5
export FESOM_SSS_PATH=$FESOM_JRA55_DIR/PHC2_salx.nc
export FESOM_RUNOFF_PATH=$FESOM_JRA55_DIR/CORE2_runoff.nc
export FESOM_CHL_FILE=$FESOM_JRA55_DIR/Sweeney_2005.nc

OUT=/scratch/project_465002727/sbeyer/fesom_runs/ng5_test_lumi_${SLURM_JOB_ID}
rm -rf "$OUT"; mkdir -p "$OUT"

NPES=$SLURM_NTASKS
if [ ! -d "$MESH/dist_$NPES" ]; then
    echo "ERROR: $MESH/dist_$NPES missing"; exit 2
fi

echo "=== NG5 test (LUMI, $SLURM_NNODES nodes × 8 GCDs = $NPES ranks, dist_$NPES) ==="
echo "    mesh=$MESH"
echo "    out=$OUT"
echo "    nodes: $SLURM_JOB_NODELIST"
srun "$ROOT/build-hip/fesom_port" "$MESH" "$OUT" "${DT:-180}" "${NSTEPS:-35}" -1 "$PHC" 1958 \
    > "$OUT/run.log" 2> "$OUT/run.err"
EC=$?
echo "=== exit=$EC ==="
echo
echo "--- loop timing ---"
grep -E "loop timing" "$OUT/run.log" | tail -3
echo "--- last step sanity ---"
grep " it=" "$OUT/run.log" | tail -1
echo "--- any FATAL ---"
grep -E "FATAL|abort|ERROR|NaN" "$OUT/run.err" | head -10 || true
exit $EC
