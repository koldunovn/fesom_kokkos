#!/bin/bash
#SBATCH --job-name=m12b_probe2
#SBATCH -p compute
#SBATCH -A ab0995
#SBATCH --nodes=1
#SBATCH --ntasks=8
#SBATCH --ntasks-per-node=8
#SBATCH --time=00:10:00
#SBATCH -o /work/ab0995/a270088/port2/m12b/probe2_%j.out
#SBATCH -e /work/ab0995/a270088/port2/m12b/probe2_%j.err
#
# M12b s3 — GEOCHK=2 ingredient probe: name the k3 input that differs.
#
# Established (s2 + probe job 26952585): the ring-1 selfcheck mismatch first
# appears exactly when V[Un] contributes its first NONZERO value with a nonzero
# anchor (step 2 substep 1 -> eta at substep 2, 1.43e-12); VISC=0 and M=1 arms
# are exact. The s2 probes compared x-components of myDim copies only. This
# probe compares BOTH components, the two viscosity terms SEPARATELY, and
# halo-copy-vs-owner ("all" scope) for the anchor, U0, Fbt, H0e, eta.
#
# Arms (np8 CORE2, 3 steps, SELFCHECK=1 keeps the certified data path):
#   visc    the measurement
#   novisc  probe null: every spread must read 0
set -u
ROOT=/home/a/a270088/port_kokkos_wh
source /sw/etc/profile.levante
source "$ROOT/env.sh"
export OMPI_MCA_btl_vader_single_copy_mechanism=none
ulimit -s 204800

BIN=${BIN:?pin the binary}
MESH=/work/ab0995/a270088/port2/mesh/core2
PHC=/home/a/a270088/FESOM_port/fesom2/tests/data/INITIAL/phc3.0/phc3.0_winter.nc
BASE=/work/ab0995/a270088/port2/m12b
sha256sum "$BIN"

export FESOM_ALE=zstar FESOM_SSH_MODE=se FESOM_SE_WIDE=1 FESOM_SE_WIDE_SELFCHECK=1
export FESOM_SE_WIDE_GEOCHK=2 FESOM_SE_M=50

run_arm () {   # $1 tag, rest = extra env assignments
  local tag=$1; shift
  local OUT=$BASE/probe2_${tag}_${SLURM_JOB_ID}
  rm -rf "$OUT"; mkdir -p "$OUT"
  echo "=================== ARM $tag  ($*) ==================="
  env "$@" srun -n 8 -l "$BIN" "$MESH" "$OUT" 1800 3 999999 "$PHC" 1958 \
      > "$OUT/run.log" 2> "$OUT/run.err"
  echo "exit=$?"
  grep -h "ssh_se-gk\]\|ssh_se-geochk\|ssh_se-wide-chk\]" "$OUT/run.err" | head -80
}

run_arm visc
run_arm novisc FESOM_SE_VISC=0
echo "=== probe2 done ==="
