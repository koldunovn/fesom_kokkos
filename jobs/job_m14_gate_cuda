#!/bin/bash
#SBATCH --job-name=m14_gate_gpu
#SBATCH -p gpu
#SBATCH -A ab0995
#SBATCH --nodes=2
#SBATCH --ntasks=8
#SBATCH --ntasks-per-node=4
#SBATCH --gres=gpu:4
#SBATCH --gpu-bind=none
#SBATCH -C a100_80
#SBATCH --time=00:12:00
#SBATCH -o /work/ab0995/a270088/port2/m14/gpugate.%j.out
#SBATCH -e /work/ab0995/a270088/port2/m14/gpugate.%j.err
#
# M14 CUDA HALF OF THE BYTE GATE (plan Task B1).
#
# CUDA is NOT bit-identical to Serial, so the Serial baseline cannot serve as the reference.
# This job runs BOTH binaries back to back in ONE allocation — h17's frozen CUDA binary (the
# main/pre-campaign reference) and the M14 CUDA binary with every new knob unset — and requires
# byte-identical snapshots between them.
#
# -C a100_80 is mandatory: the gpu partition is heterogeneous (L94), and an unpinned pair could
# land on different card models and differ for reasons that have nothing to do with the merge.
# Both legs run inside this one allocation, so they see the same nodes and the same cards.
#
# Cheap on purpose: 2 nodes / 12 min, so the scheduler treats it as fill (a cheap gate must LOOK
# cheap — a short walltime flips (Priority) to (None)).
#
# Usage: sbatch jobs/job_m14_gate_cuda

set -u
ROOT=/home/a/a270088/port_kokkos_int
source /sw/etc/profile.levante
# 🔴 env_cuda.sh, NOT env.sh. CUDA-aware MPI needs openmpi/4.1.5-nvhpc; the env.sh
# openmpi/4.1.2 is --without-cuda and SEGFAULTs on device pointers. NEVER source both (L77).
# Sourcing env.sh + `module load nvhpc` here cost jobs 26984167/347/348: rc=139 on EVERY leg.
source "$ROOT/env_cuda.sh"
export OMPI_MCA_btl_vader_single_copy_mechanism=none

MESH=/work/ab0995/a270088/port2/mesh/core2
PHC=/home/a/a270088/FESOM_port/fesom2/tests/data/INITIAL/phc3.0/phc3.0_winter.nc
# 🔴 BOTH binaries are FROZEN copies, never build-tree paths. A queued job resolves its binary at
# RUN time, so a rebuild while the job waits silently swaps what is being tested — the "always pin
# BIN=" rule, in miniature. Point at /work copies whose md5 is recorded in PROVENANCE.txt.
REF_BIN=/work/ab0995/a270088/port2/m7/bin/h17/fesom_port_cuda          # md5 f8384e86…
NEW_BIN=${M14_BIN:-/work/ab0995/a270088/port2/m14/bin/i1}/fesom_port_cuda   # md5 42078250…

# ALL knobs OFF — grep the environment rather than listing names, so a knob added later
# cannot leak in silently.
unset FESOM_ALE FESOM_MIX_SCHEME FESOM_WHICH_EVP
unset FESOM_TKE_DIAG FESOM_TKE_DUMP_DIR FESOM_EVP_DUMP_DIR FESOM_ALE_DUMP_DIR
for pre in FESOM_SPEED FESOM_SSH FESOM_SE_ FESOM_PCSI FESOM_IC_EXTRAP FESOM_EVPWIDE; do
  while read -r v; do unset "$v"; done < <(env | sed -n "s/^\(${pre}[A-Za-z0-9_]*\)=.*/\1/p")
done

TAG=${M14_TAG:-$SLURM_JOB_ID}
BASE=/work/ab0995/a270088/port2/m14
OUT_REF=$BASE/gpugate_${TAG}_h17
OUT_NEW=$BASE/gpugate_${TAG}_m14
rm -rf "$OUT_REF" "$OUT_NEW"; mkdir -p "$OUT_REF" "$OUT_NEW"

echo "=== M14 CUDA byte gate — tag=$TAG ==="
echo "nodes: $SLURM_JOB_NODELIST"
md5sum "$REF_BIN" "$NEW_BIN"
( cd "$ROOT" && git rev-parse HEAD )
echo "=== live FESOM_ env after the unsets (should be empty) ==="; env | grep -E '^FESOM_' | sort || true

echo; echo "--- leg 1: h17 (the pre-campaign reference) ---"
srun -l "$REF_BIN" "$MESH" "$OUT_REF" 1800 20 10 "$PHC" 1958 > "$OUT_REF/run.log" 2> "$OUT_REF/run.err"
RC_REF=$?; echo "h17 rc=$RC_REF"; tail -1 "$OUT_REF/run.log"

echo; echo "--- leg 2: m14-integrate, all new knobs unset ---"
srun -l "$NEW_BIN" "$MESH" "$OUT_NEW" 1800 20 10 "$PHC" 1958 > "$OUT_NEW/run.log" 2> "$OUT_NEW/run.err"
RC_NEW=$?; echo "m14 rc=$RC_NEW"; tail -1 "$OUT_NEW/run.log"

# 🔴 A DIFF IS ONLY EVIDENCE IF BOTH RUNS LIVED. Jobs 26984167 segfaulted BOTH legs (rc=139) and
# this gate printed "BYTE GATE PASS", because diff_snap compared two equally-empty outputs. That is
# the same false-pass class as the NaN-blind solver guard (L106) -- guarded against on the CPU side
# and missed here. Check the run first.
if [ "$RC_REF" -ne 0 ] || [ "$RC_NEW" -ne 0 ]; then
    echo "=== GATE VOID — a leg did not complete (h17 rc=$RC_REF, m14 rc=$RC_NEW). No diff is meaningful. ==="
    exit 1
fi
echo; echo "=== diff_snap.py: m14 (knobs off) vs h17, CUDA vs CUDA, zero tolerance ==="
PY=/work/ab0995/a270088/mambaforge/envs/nereus/bin/python
"$PY" "$ROOT/scripts/diff_snap.py" "$OUT_REF" "$OUT_NEW"
RC=$?
echo "diff_snap rc=$RC"
if [ "$RC" -eq 0 ]; then
    echo "=== M14 CUDA BYTE GATE PASS — knobs-off returns to the pre-campaign state on GPU too ==="
else
    echo "=== M14 CUDA BYTE GATE FAIL — the merge perturbed the default path on the device ==="
fi
exit $RC
