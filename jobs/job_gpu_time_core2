#!/bin/bash
#SBATCH --job-name=kk_gtime
#SBATCH -p gpu
#SBATCH -A ab0995
#SBATCH --nodes=2
#SBATCH --ntasks=8
#SBATCH --ntasks-per-node=4
#SBATCH --gres=gpu:4
#SBATCH --gpu-bind=none
#SBATCH --time=00:20:00
#SBATCH -o /work/ab0995/a270088/port2/kokkos_gpu_runs/gtime.%j.out
#SBATCH -e /work/ab0995/a270088/port2/kokkos_gpu_runs/gtime.%j.err
#
# M3.1 TIMING (CUDA, dist_8 = 8 A100 / 2 nodes). Runs the timestep loop at 5 and
# 105 steps; loop(100 steps) = wall(105) - wall(5) cancels the (identical) startup
# (mesh read + PHC IC + JRA55 read), giving a clean per-step time. snap_every huge
# => no I/O in the loop. NOTE: this is the UN-optimized M3.1 step — the mid-step CG
# still round-trips device<->host every step (SYNC_MAP §5), so it measures PCIe
# stalls as much as kernels. A fair benchmark needs M4.2. Output -> /work (home is 60GB).
ROOT=/home/a/a270088/port_kokkos
source /sw/etc/profile.levante
module --force purge
module unload netcdf-c cdo ncview git 2>/dev/null
module load gcc/11.2.0-gcc-11.2.0 nvhpc/24.7-gcc-11.2.0 \
            openmpi/4.1.2-gcc-11.2.0 netcdf-c/4.8.1-gcc-11.2.0
export NVCC_WRAPPER_DEFAULT_COMPILER=g++
export OMPI_MCA_pml=ucx OMPI_MCA_btl=self OMPI_MCA_osc=pt2pt UCX_IB_ADDR_TYPE=ib_global
export OMPI_MCA_coll="^ml,hcoll" OMPI_MCA_coll_hcoll_enable=0 HCOLL_ENABLE_MCAST_ALL=0
export HCOLL_MAIN_IB=mlx5_0:1 UCX_NET_DEVICES=mlx5_0:1
export UCX_TLS=mm,knem,cma,dc_mlx5,dc_x,self UCX_UNIFIED_MODE=y OMPI_MCA_io=romio321
export HDF5_USE_FILE_LOCKING=FALSE

MESH=/pool/data/AWICM/FESOM2/MESHES_FESOM2.1/core2
PHC=/home/a/a270088/FESOM_port/fesom2/tests/data/INITIAL/phc3.0/phc3.0_winter.nc
OUT=/work/ab0995/a270088/port2/kokkos_gpu_runs/time_gpu
rm -rf "$OUT"; mkdir -p "$OUT"
export FESOM_PRINT_EVERY=200            # minimal per-step print

run() {  # $1=nsteps $2=tag
  local t0 t1; t0=$(date +%s.%N)
  srun "$ROOT/build-cuda/fesom_port" "$MESH" "$OUT" 1800 "$1" 999999 "$PHC" 1958 > "$OUT/log_$2.txt" 2>&1
  local rc=$?; t1=$(date +%s.%N)
  awk -v a="$t0" -v b="$t1" -v n="$1" -v t="$2" -v r="$rc" \
      'BEGIN{printf "TIMING backend=GPU tag=%s nsteps=%d wall=%.2f s rc=%s\n", t, n, b-a, r}'
}
echo "=== GPU dist_8 timing (nodes=$SLURM_JOB_NODELIST) ==="
run 5   short
run 105 long
echo "--- last step of long run (sanity, no nan) ---"
grep -E "it=" "$OUT/log_long.txt" | tail -1
