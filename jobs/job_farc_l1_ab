#!/bin/bash
#SBATCH --job-name=kk_farc_l1ab
#SBATCH -p gpu
#SBATCH -A ab0995
#SBATCH --ntasks-per-node=4
#SBATCH --gres=gpu:4
#SBATCH --gpu-bind=none
#SBATCH --time=00:30:00
#SBATCH -o /work/ab0995/a270088/port2/kokkos_gpu_runs/farcl1ab.%j.out
#SBATCH -e /work/ab0995/a270088/port2/kokkos_gpu_runs/farcl1ab.%j.err
# M5.23 L1 A/B in the COMM regime (farc dist_$ntasks): BEFORE=m522b (2 EVP halo msgs/subcycle)
# vs AFTER=m522c (1 fused). Same allocation, back-to-back, FESOM_HALO_MPI_PROF=1 to read the
# EVP halo Waitall + the msg/step count drop. dt=900 farc-natural. NPES=ntasks -> dist_NPES.
ROOT=/home/a/a270088/port_kokkos
source "$ROOT/env_cuda.sh"
export OMPI_MCA_pml=ucx OMPI_MCA_btl=self UCX_NET_DEVICES=mlx5_0:1
export UCX_MEMTYPE_CACHE=n OMPI_MCA_coll_hcoll_enable=0 OMPI_MCA_io=romio321 HDF5_USE_FILE_LOCKING=FALSE
export FESOM_STEP_PROFILE=1 FESOM_CG_PROFILE=1 FESOM_HALO_MPI_PROF=1 FESOM_PRINT_EVERY=999
MESH=/pool/data/AWICM/FESOM2/MESHES_FESOM2.1/farc
PHC=/home/a/a270088/FESOM_port/fesom2/tests/data/INITIAL/phc3.0/phc3.0_winter.nc
NST=${NSTEPS:-35}; DT=${DT:-900}; NPES=$SLURM_NTASKS
[ -d "$MESH/dist_$NPES" ] || { echo "ERROR $MESH/dist_$NPES missing"; exit 2; }
echo "=== FARC L1 A/B dist_$NPES (${SLURM_NNODES}N, ~$((638387/NPES/1000))k 2D/rank) dt=$DT nst=$NST ==="
run () { # $1=binary $2=tag
  local OUT="/work/ab0995/a270088/port2/kokkos_gpu_runs/farcl1_$2"; rm -rf "$OUT"; mkdir -p "$OUT"
  echo "######## $2 :: $1 ########"
  srun "$1" "$MESH" "$OUT" "$DT" "$NST" -1 "$PHC" 1958 > "$OUT/run.log" 2>&1
  echo "rc=$?"
  grep -E "loop timing|halo-mpi-prof|MPI_Waitall|SPLIT|CG share" "$OUT/run.log"
  sed -n '/phase + kernel breakdown/,$p' "$OUT/run.log" | grep -iE "halo_pack|halo_unpack|ice_dyn|ice_evp" | head
  rm -f "$OUT"/*.monthly.nc
}
run "$ROOT/build-cuda/fesom_port_m522b" before_b
run "$ROOT/build-cuda/fesom_port_m522c" after_c
echo "=== done ==="
