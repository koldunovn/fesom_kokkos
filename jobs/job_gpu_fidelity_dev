#!/bin/bash
#SBATCH --job-name=kk_fidev
#SBATCH -p gpu
#SBATCH -A ab0995
#SBATCH --nodes=2
#SBATCH --ntasks=8
#SBATCH --ntasks-per-node=4
#SBATCH --gres=gpu:4
#SBATCH --gpu-bind=none
#SBATCH --time=00:15:00
#SBATCH -o /work/ab0995/a270088/port2/kokkos_gpu_runs/fidev.%j.out
#SBATCH -e /work/ab0995/a270088/port2/kokkos_gpu_runs/fidev.%j.err
# The CUDA (device-halo) leg of the M5.9 fidelity gate: CORE2 dist_8, ICE ACTIVE, same dt/steps as
# the Serial oracle (jobs/job_core2_serial_ref). diff vs the oracle with scripts/gpu_fidelity_check.py.
ROOT=/home/a/a270088/port_kokkos; source "$ROOT/env_cuda.sh"
export OMPI_MCA_pml=ucx OMPI_MCA_btl=self UCX_NET_DEVICES=mlx5_0:1
export UCX_MEMTYPE_CACHE=n OMPI_MCA_coll_hcoll_enable=0 OMPI_MCA_io=romio321 HDF5_USE_FILE_LOCKING=FALSE
MESH=/pool/data/AWICM/FESOM2/MESHES_FESOM2.1/core2
PHC=/home/a/a270088/FESOM_port/fesom2/tests/data/INITIAL/phc3.0/phc3.0_winter.nc
OUT=/work/ab0995/a270088/port2/kokkos_gpu_runs/gate_dev; rm -rf "$OUT"; mkdir -p "$OUT"
export FESOM_STEP_PROFILE=1   # M5.13: deep_copy transfer-count PCIe proxy (timing/print only; field values unaffected)
srun "$ROOT/build-cuda/fesom_port" "$MESH" "$OUT" 1800 20 10 "$PHC" 1958 > "$OUT/log" 2>&1
echo "[fidev] exit=$? -> $OUT"
