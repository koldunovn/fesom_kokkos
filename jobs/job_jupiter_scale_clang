#!/bin/bash
#SBATCH --job-name=jclsc
#SBATCH --account=e-sta-destine
#SBATCH --partition=booster
#SBATCH --ntasks-per-node=4
#SBATCH --cpus-per-task=72
#SBATCH --gres=gpu:4
#SBATCH --gpu-bind=none
#SBATCH -o /e/scratch/e-sta-destine/koldunov1/port2/clang_ab/slurm.%j.out
#SBATCH -e /e/scratch/e-sta-destine/koldunov1/port2/clang_ab/slurm.%j.err
#
# JUPITER (GH200) strong-scaling point = dolpung FLEET v2 twin: 4 legs x 2 reps.
#   dp     = FP64 FESOM_SPEED=1 (m7-speed build)     dp_cgp = dp + FESOM_SPEED_CGPOLY=3
#   sp     = FP32 (m8-precision build), same knobs   sp_cgp = sp + CGPOLY=3
# env in: MESH DT TAG, NSTEPS(300), TRANSPORT (set by submitter from the day-0
# ladder verdict: "" = device transport, "FESOM_HALO_STAGE=1" = staged; may be
# semicolon-separated if more knobs ever join it). EVPWIDE stays OUT (Addendum B:
# measured loss on GH200 + device-ptr wide halo). No OMPI/UCX pins: ParaStationMPI
# + MPI-settings/CUDA module = system defaults (plan §2), deviations only via A/B.
set -u
ROOT=/e/home/jusers/koldunov1/jupiter/port_kokkos_clang
MPROOT=/e/home/jusers/koldunov1/jupiter/port_kokkos_mp_clang
source "$ROOT/env_jupiter.sh"
export HDF5_USE_FILE_LOCKING=FALSE FESOM_PRINT_EVERY=999
export FESOM_FORCING_DIR=/e/scratch/e-sta-destine/koldunov1/forcing_1958
export FESOM_CHL_FILE=/e/scratch/hclimrep/koldunov1/meshes/Sweeney/Sweeney_2005.nc
MESH=${MESH:?}; DT=${DT:?}; TAG=${TAG:?}; NSTEPS=${NSTEPS:-300}; TRANSPORT=${TRANSPORT:-}
PHC=/e/scratch/hclimrep/koldunov1/meshes/phc3.0/phc3.0_winter.nc
BASE=/e/scratch/e-sta-destine/koldunov1/port2/clang_ab
BIN_DP=$ROOT/build-jupiter-cuda/fesom_port
BIN_SP=$MPROOT/build-jupiter-cuda-sp/fesom_port
NPES=$SLURM_NTASKS
[ -d "$MESH/dist_$NPES" ] || { echo "ERROR: $MESH/dist_$NPES missing"; exit 2; }
echo "=== jupiter scale $TAG mesh=$(basename $MESH) N=$SLURM_NNODES ntasks=$NPES dt=$DT nsteps=$NSTEPS transport='${TRANSPORT}' ==="
echo "dp:  $BIN_DP  md5=$(md5sum $BIN_DP | cut -d' ' -f1)"
echo "sp:  $BIN_SP  md5=$(md5sum $BIN_SP | cut -d' ' -f1)"
echo "nodes: $SLURM_JOB_NODELIST"

leg(){ # $1 leg-name  $2 binary  $3 extra knobs (semicolon-sep)
  for rep in a b; do
    OUT=$BASE/${TAG}/$1_$rep; rm -rf "$OUT"; mkdir -p "$OUT"
    srun -c72 --distribution=block:block bash -c "
      source $ROOT/env_jupiter.sh
      export FESOM_SPEED=1
      IFS=';' read -ra TV <<< '$TRANSPORT'; for kv in \"\${TV[@]}\"; do [ -n \"\$kv\" ] && export \"\$kv\"; done
      IFS=';' read -ra KV <<< '$3'; for kv in \"\${KV[@]}\"; do [ -n \"\$kv\" ] && export \"\$kv\"; done
      exec $2 $MESH $OUT $DT $NSTEPS -1 $PHC 1958" > "$OUT/log.txt" 2>&1
    rc=$?
    ss=$(grep 'loop timing' "$OUT/log.txt" | tail -1 | grep -o '[0-9.]* s/step' | cut -d' ' -f1)
    echo "RESULT $TAG $1 $rep rc=$rc s_step=${ss:-NA}"
    [ $rc -ne 0 ] && tail -5 "$OUT/log.txt" | sed 's/^/    | /'
  done
}
leg dp     "$BIN_DP" ""
leg dp_cgp "$BIN_DP" "FESOM_SPEED_CGPOLY=3"
leg sp     "$BIN_SP" ""
leg sp_cgp "$BIN_SP" "FESOM_SPEED_CGPOLY=3"
echo "=== $TAG done ==="
