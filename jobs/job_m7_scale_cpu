#!/bin/bash
#SBATCH --job-name=m7sc
#SBATCH -p compute
#SBATCH -A ab0995
#SBATCH --ntasks-per-node=128
#SBATCH --time=00:45:00
#SBATCH -o /work/ab0995/a270088/port2/m7/scale.%j.out
#SBATCH -e /work/ab0995/a270088/port2/m7/scale.%j.err
#
# M7 CPU baseline run (Kokkos Serial, 128 ranks/node = pure MPI), mesh-parametrized
# (copy of job_m524_scale_cpu on the m7 tree). env: MESH, DT, NSTEPS (35), TAG,
# optional BIN (binary path; defaults to the live build-m7serial — point it at the
# frozen m7/bin/row0/ snapshot to submit a certified-source run while the build tree
# is in flux; a queued job runs whatever is on disk when it STARTS).
# Knobs are ALWAYS off on the CPU side (the ratio denominator is certified code).
ROOT=/home/a/a270088/port_kokkos
source "$ROOT/jobs/m7_provenance.sh"
source /sw/etc/profile.levante
source "$ROOT/env.sh"
ulimit -s 204800
export FESOM_PRINT_EVERY=${FESOM_PRINT_EVERY:-999}   # overridable (M7-wsplit debug)
while read -r v; do unset "$v"; done < <(env | sed -n 's/^\(FESOM_SPEED[A-Za-z0-9_]*\)=.*/\1/p')
MESH=${MESH:?MESH required}
PHC=/home/a/a270088/FESOM_port/fesom2/tests/data/INITIAL/phc3.0/phc3.0_winter.nc
OUT=/work/ab0995/a270088/port2/m7/${TAG:?TAG required}; rm -rf "$OUT"; mkdir -p "$OUT"
NPES=$SLURM_NTASKS
FESOM=${BIN:-$ROOT/build-m7serial/fesom_port}
m7_provenance "$OUT" "$FESOM"
[ -d "$MESH/dist_$NPES" ] || { echo "ERROR: $MESH/dist_$NPES missing"; exit 2; }
run(){ srun "$FESOM" "$MESH" "$OUT" "${DT:?DT required}" "${NSTEPS:-35}" -1 "$PHC" 1958 \
        > "$OUT/log_$1.txt" 2>&1
  printf "%-8s rc=%s  %s\n" "$1" "$?" "$(grep 'loop timing' "$OUT/log_$1.txt" | tail -1)"; }
echo "=== M7 CPU $TAG mesh=$(basename $MESH) nodes=$SLURM_NNODES ntasks=$NPES (dist_$NPES) dt=$DT nsteps=${NSTEPS:-35} ==="
echo "binary: $FESOM  md5: $(md5sum "$FESOM" | cut -d' ' -f1)"
run rep_a; run rep_b
echo "--- CG iters + T/S sanity (rep_a, last step) ---"; grep -E "it=" "$OUT/log_rep_a.txt" | tail -1
