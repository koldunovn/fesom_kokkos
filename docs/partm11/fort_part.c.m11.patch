+/* Read a 0-based part vector of exactly n entries; validate hard, because a bad
+ * vector here surfaces as a model abort minutes later, or worse, as a silently
+ * wrong decomposition. */
+static void m11_read_part_file(const char *path, idx_t n, idx_t npes, idx_t *part)
+{
+    FILE *f = fopen(path, "r");
+    idx_t i, mn, mx;
+    idx_t *cnt;
+    long v;
+    int empty = 0;
+    if (!f) {
+        printf("[M11] FESOM_PART_FILE='%s' cannot be opened -- aborting\n", path);
+        exit(1);
+    }
+    for (i = 0; i < n; i++) {
+        if (fscanf(f, "%ld", &v) != 1) {
+            printf("[M11] FESOM_PART_FILE='%s': only %d of %d entries could be read"
+                   " -- aborting\n", path, (int)i, (int)n);
+            exit(1);
+        }
+        part[i] = (idx_t)v;
+    }
+    if (fscanf(f, "%ld", &v) == 1) {
+        printf("[M11] FESOM_PART_FILE='%s': MORE than nod2D=%d entries -- aborting\n",
+               path, (int)n);
+        exit(1);
+    }
+    fclose(f);
+
+    mn = mx = part[0];
+    for (i = 1; i < n; i++) {
+        if (part[i] < mn) mn = part[i];
+        if (part[i] > mx) mx = part[i];
+    }
+    if (mn != 0 || mx != npes - 1) {
+        printf("[M11] FESOM_PART_FILE='%s': ranks span [%d,%d], expected [0,%d]"
+               " -- aborting\n", path, (int)mn, (int)mx, (int)(npes - 1));
+        exit(1);
+    }
+    cnt = (idx_t *)calloc(npes, sizeof(idx_t));
+    if (!cnt) { printf("[M11] out of memory for the part histogram\n"); exit(1); }
+    for (i = 0; i < n; i++) cnt[part[i]]++;
+    for (i = 0; i < npes; i++) if (cnt[i] == 0) empty++;
+    if (empty) {
+        printf("[M11] FESOM_PART_FILE='%s': %d EMPTY part(s) -- aborting\n", path, empty);
+        exit(1);
+    }
+    {   /* announce the shape of what we injected: min/max/mean per part */
+        idx_t lo = cnt[0], hi = cnt[0];
+        double mean = 0.0;
+        for (i = 0; i < npes; i++) {
+            if (cnt[i] < lo) lo = cnt[i];
+            if (cnt[i] > hi) hi = cnt[i];
+            mean += (double)cnt[i];
+        }
+        mean /= (double)npes;
+        printf("[M11] FESOM_PART_FILE='%s' INJECTED: %d nodes into %d parts, "
+               "min %d max %d mean %.1f (imbalance %.4f)\n",
+               path, (int)n, (int)npes, (int)lo, (int)hi, mean, (double)hi / mean);
+    }
+    free(cnt);
+}
+
+/* Dump the CSR exactly as handed to METIS (1-based, as the Fortran side built it).
+ * This is the authoritative reference the Python exporter must reproduce. */
+static void m11_dump_graph(const char *path, idx_t n, idx_t *ptr, idx_t *adj, idx_t *wgt)
+{
+    FILE *f = fopen(path, "w");
+    idx_t i;
+    if (!f) {
+        printf("[M11] FESOM_PART_GRAPH_DUMP='%s' cannot be written -- aborting\n", path);
+        exit(1);
+    }
+    fprintf(f, "%d %d %d\n", (int)n, (int)(ptr[n] - ptr[0]), wgt ? 1 : 0);
+    for (i = 0; i <= n; i++) fprintf(f, "%d\n", (int)ptr[i]);
+    for (i = 0; i < ptr[n] - ptr[0]; i++) fprintf(f, "%d\n", (int)adj[i]);
+    /* The weight array is `nlevels_nod2D` as the Fortran side RECOMPUTED it in
+     * memory. The partitioner keeps a pre-existing nlvls.out on disk while
+     * partitioning with these values (fvom_init.F90:996-1017), so the two can
+     * silently disagree — review M5. Dumping it here settles that per mesh,
+     * without patching Fortran. */
+    if (wgt) for (i = 0; i < n; i++) fprintf(f, "%d\n", (int)wgt[i]);
+    fclose(f);
+    printf("[M11] FESOM_PART_GRAPH_DUMP='%s' WROTE the ssh_stiff CSR: n=%d nnz=%d "
+           "(1-based, rowptr, colind%s)\n", path, (int)n, (int)(ptr[n] - ptr[0]),
+           wgt ? ", in-memory nlevels_nod2D" : "");
+}
+
+/* Count connected components of the graph with a union-find, so CONTIG is never
+ * requested on a disconnected graph (METIS silently ignores it there). */
+static idx_t m11_find(idx_t *p, idx_t x)
+{
+    while (p[x] != x) { p[x] = p[p[x]]; x = p[x]; }
+    return x;
+}
+
+static idx_t m11_components(idx_t n, idx_t *ptr, idx_t *adj, idx_t *root_out)
+{
+    idx_t *p = (idx_t *)malloc(n * sizeof(idx_t));
+    idx_t i, j, a, b, ncomp = 0;
+    if (!p) { printf("[M11] out of memory in component scan\n"); exit(1); }
+    for (i = 0; i < n; i++) p[i] = i;
+    for (i = 0; i < n; i++)
+        for (j = ptr[i] - 1; j < ptr[i + 1] - 1; j++) {
+            a = m11_find(p, i);
+            b = m11_find(p, adj[j] - 1);
+            if (a != b) p[a] = b;
+        }
+    for (i = 0; i < n; i++) if (m11_find(p, i) == i) ncomp++;
+    if (root_out) for (i = 0; i < n; i++) root_out[i] = m11_find(p, i);
+    free(p);
+    return ncomp;
+}
