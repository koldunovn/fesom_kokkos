+/* ==========================================================================
+ * M11 partitioning campaign — runtime knobs (worktree ~/port_kokkos_part).
+ *
+ * Everything the partitioner does was compile-time: the weighting was an
+ * #ifdef, the seed a -D, the METIS entry point a source edit. That makes an
+ * A/B a comparison of two binaries, which is not an A/B. These knobs move all
+ * of it to run time so one binary produces every arm.
+ *
+ * L80 rule, absolute: every knob ANNOUNCES itself when set, and ABORTS on a
+ * value it does not recognise. A silently-ignored knob produces a null result
+ * that looks like a measurement.
+ *
+ * Knobs (all optional; unset == the historical behaviour of this binary):
+ *   FESOM_PART_FILE      path  inject a ready part vector, skip METIS entirely
+ *   FESOM_PART_GRAPH_DUMP path dump the exact CSR handed to METIS, then continue
+ *   FESOM_PART_WGT       0|1|2 vertex weighting (2D only / 3D only / dual+100)
+ *   FESOM_PART_WGT_A     int   single scalar weight w = a + nlev (supersedes WGT)
+ *   FESOM_PART_KWAY      0|1   METIS_PartGraphKway instead of Recursive
+ *   FESOM_PART_OBJ       cut|vol  objective (vol is Kway-only in METIS)
+ *   FESOM_PART_VSIZE     0|1   pass vsize = nlev (the comm-volume size array)
+ *   FESOM_PART_CONTIG    0|1   force contiguous parts (Kway-only; pre-connects)
+ *   FESOM_PART_MINCONN   0|1   minimise the maximum neighbour count (Kway-only)
+ *   FESOM_PART_UFACTOR   int   allowed imbalance in promille
+ *   FESOM_PART_NCUTS     int   number of trial partitionings
+ *   FESOM_PART_NITER     int   refinement iterations
+ *   FESOM_PART_SEED      int   METIS RNG seed (compile-time before this)
+ *   FESOM_PART_TPWGTS_FILE path  per-part target fractions (npes numbers)
+ * ========================================================================== */
+
+static int m11_env_present(const char *name)
+{
+    const char *e = getenv(name);
+    return e && e[0];
+}
+
+static int m11_env_int(const char *name, int dflt)
+{
+    const char *e = getenv(name);
+    char *end = NULL;
+    long v;
+    if (!e || !e[0]) return dflt;
+    v = strtol(e, &end, 10);
+    if (end == e || (end && *end != '\0')) {
+        printf("[M11] %s='%s' is not an integer -- aborting\n", name, e);
+        exit(1);
+    }
+    return (int)v;
+}
+
+static int m11_env_bool(const char *name, int dflt)
+{
+    int v;
+    if (!m11_env_present(name)) return dflt;
+    v = m11_env_int(name, dflt);
+    if (v != 0 && v != 1) {
+        printf("[M11] %s=%d out of range: expected 0 or 1 -- aborting\n", name, v);
+        exit(1);
+    }
+    return v;
+}
+
+static int m11_env_pos(const char *name, int dflt)
+{
+    int v;
+    if (!m11_env_present(name)) return dflt;
+    v = m11_env_int(name, dflt);
+    if (v < 1) {
+        printf("[M11] %s=%d must be >= 1 -- aborting\n", name, v);
+        exit(1);
+    }
+    return v;
+}
 
