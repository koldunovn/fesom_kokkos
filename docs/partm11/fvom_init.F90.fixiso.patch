   allocate(ne_part(max_adjacent_nodes), ne_part_num(max_adjacent_nodes), &
        ne_part_load(2,max_adjacent_nodes))
 
+  ! ---------------------------------------------------------------------------------------
+  ! [M11] FESOM_PART_FIXISO: repair the candidate-list seeding below.
+  !
+  ! The stock code seeds the list of candidate partitions with node_neighb_part(1)
+  ! UNCONDITIONALLY, while the loop that fills the rest of the list explicitly skips
+  ! neighbours that are in the node's own partition. Two consequences:
+  !
+  !   (a) when the adjacency list happens to BEGIN with the node's own partition, that
+  !       partition becomes a move candidate, usually wins, and the node is "moved" to where
+  !       it already is. The routine prints success and the isolated node survives every
+  !       later pass. Whether this happens depends on the ORDER of the adjacency list, i.e.
+  !       on the mesh numbering — same mesh, same partition, same node, repaired under one
+  !       numbering and silently not under another (M11 Finding 9, found by relabelling).
+  !   (b) the first neighbour is counted TWICE (once by the seed, once by the loop), which
+  !       biases the "partition with the most adjacent nodes" choice towards it.
+  !
+  ! Both go away by letting the loop build the whole list. Default OFF, so with no knob set
+  ! this tool still reproduces upstream byte-for-byte (null-1).
+  ! ---------------------------------------------------------------------------------------
+  m11_fixiso = .false.
+  call get_environment_variable('FESOM_PART_FIXISO', m11_env, m11_len, m11_stat)
+  if (m11_stat == 0 .and. m11_len > 0) then
+     select case (trim(m11_env))
+     case ('0')
+        m11_fixiso = .false.
+     case ('1')
+        m11_fixiso = .true.
+     case default
+        print *,'[M11] FESOM_PART_FIXISO='//trim(m11_env)//' not recognised (want 0 or 1)'
+        stop 1
+     end select
+     print *,'[M11] FESOM_PART_FIXISO=',trim(m11_env), &
+          ' (candidate list seeded from neighbours OUTSIDE part(n))'
+  end if
+
   print *,' '
   print *,'Check for isolated nodes ========'
   n_iso = 0
